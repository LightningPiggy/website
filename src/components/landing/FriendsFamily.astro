---
import SectionHeading from '../ui/SectionHeading.astro';
import PartnerCard from './PartnerCard.astro';
import partnersData from '../../data/partners.json';
import creditsData from '../../data/credits.json';

// Each landing-page section is fed by both the Partners (Friends & Family) data
// and any Credits assigned to that section in the admin tool, merged here.
const mergeSection = (key: string) => [
  ...((partnersData as Record<string, any[]>)[key] || []),
  ...((creditsData as Record<string, any[]>)[key] || []),
];

const sections = [
  { items: mergeSection('communitySponsors'), title: 'Community Sponsors', subtitle: 'Generous supporters helping keep Lightning Piggy free and open source.' },
  { items: mergeSection('educationPartners'), title: 'Education Partners', subtitle: 'Organizations helping bring Bitcoin education to the next generation.' },
  { items: mergeSection('technologyPartners'), title: 'Enabling Technologies', subtitle: 'The technologies and platforms that power Lightning Piggy.' },
  { items: mergeSection('appearances'), title: 'Appearances', subtitle: 'Podcasts, conferences, and events where Lightning Piggy has been featured.' },
  { items: mergeSection('inTheNews'), title: 'In the News', subtitle: 'Publications and articles featuring Lightning Piggy.' },
].filter((s) => s.items.length > 0);

const hasPartners = sections.length > 0;
---

{hasPartners && (
<section class="py-14 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Community & Partners"
      subtitle="The amazing projects, platforms, and creators powering the Lightning Piggy project."
    />

    {sections.map((section) => (
      <div class="mt-12">
        <h3 class="text-xl font-bold text-gray-900 mb-2 text-center">{section.title}</h3>
        <p class="text-gray-600 mb-6 text-center">{section.subtitle}</p>
        <div class="flex flex-wrap justify-center gap-4">
          {section.items.map((partner) => <PartnerCard partner={partner} />)}
        </div>
      </div>
    ))}
  </div>
</section>
)}

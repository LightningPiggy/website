---
const navItems = [
  { label: 'About', href: '/about' },
  {
    label: 'Build',
    href: '/build',
    children: [
      { label: 'Classic (Arduino)', href: '/build/classic' },
      { label: 'p1 (MicroPythonOS)', href: '/build/p1' },
      { label: 'Cases', href: '/build/cases' },
      { label: 'Guides', href: '/build/#guides' },
      { label: 'Tools', href: '/build/#tools' },
      { label: 'Help', href: '/build/#help' },
    ]
  },
  {
    label: 'Market',
    href: '/market',
    children: [
      { label: 'Shop', href: '/market/#products' },
      { label: 'Nostr Handles', href: '/market/#nostr-handles' },
      { label: 'Vendors', href: '/market/#vendors' },
    ]
  },
  {
    label: 'Community',
    href: '/community',
    children: [
      { label: 'In the Wild', href: '/community/wild' },
      { label: 'Educators', href: '/community/educators' },
      { label: 'Bitcoin Kids', href: '/community/bitcoinkids' },
      { label: 'ZapMyPiggy', href: '/community/zapmypiggy' },
      { label: 'Credits', href: '/community/credits' },
      { label: 'Message Board', href: '/community/#message-board' },
    ]
  },
  { label: 'Family App', href: '/app' },
  { label: 'Treasure Hunt', href: '/treasure-hunt' },
  {
    label: 'News',
    href: '/news',
    children: [
      { label: 'In the News', href: '/news/#in-the-news' },
      { label: 'Software Updates', href: '/news/#software-updates' },
    ]
  },
  { label: 'Donate', href: '/donate' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img src="/images/branding/lightningpiggy-logo.svg" alt="LightningPiggy" class="h-10 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class={`px-3 py-2 text-sm font-medium rounded-lg transition-colors ${
                currentPath.startsWith(item.href) && item.href !== '/'
                  ? 'text-pink bg-pink-light/30'
                  : item.label === 'Donate'
                    ? 'text-pink hover:text-pink hover:bg-pink-light/30'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
              }`}
            >
              {item.label === 'Donate' && (
                <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              )}
              {item.label}
              {item.children && (
                <svg class="inline-block w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute left-0 mt-1 w-48 bg-white rounded-xl shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="py-2">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2 text-sm text-gray-600 hover:text-gray-900 hover:bg-gray-50"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- CTA Button -->
      <a
        href="/build"
        class="hidden lg:inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-pink rounded-full hover:bg-gray-900 transition-colors"
      >
        Build Your Own
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white max-h-[calc(100vh-4rem)] overflow-y-auto overscroll-contain">
    <div class="px-4 py-4 space-y-2">
      {navItems.map((item) => (
        <div>
          <a
            href={item.href}
            class={`block px-3 py-2 text-base font-medium rounded-lg ${
              currentPath.startsWith(item.href) && item.href !== '/'
                ? 'text-pink bg-pink-light/30'
                : item.label === 'Donate'
                  ? 'text-pink hover:text-pink hover:bg-pink-light/30'
                  : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
            }`}
          >
            {item.label === 'Donate' && (
              <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            )}
            {item.label}
          </a>
          {item.children && (
            <div class="ml-4 mt-1 space-y-1">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-2 text-sm text-gray-500 hover:text-gray-900 hover:bg-gray-50 rounded-lg"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a
        href="/build"
        class="block w-full text-center px-4 py-3 text-base font-semibold text-white bg-pink rounded-full hover:bg-gray-900 transition-colors mt-4"
      >
        Build Your Own
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close the menu when a link inside it is followed. Navigating to another
  // page reloads and resets it anyway, but an in-page anchor (#guides,
  // #products, ...) is a same-document jump with no reload - without this the
  // menu stays open, covering the very section it just scrolled to.
  mobileMenu?.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) {
      mobileMenu.classList.add('hidden');
    }
  });
</script>

---
import { getLangFromUrl, useTranslations, localizePath, stripLocale } from '../../i18n/utils';
import { LOCALES, LOCALE_CODES } from '../../i18n/config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (path: string) => localizePath(path, lang);

// Labels come from the dictionary; hrefs are localised so /build becomes
// /de/build for a German visitor.
const navItems = [
  { label: t('nav.about'), href: L('/about') },
  {
    label: t('nav.build'),
    href: L('/build'),
    children: [
      { label: t('nav.build.classic'), href: L('/build/classic') },
      { label: t('nav.build.p1'), href: L('/build/p1') },
      { label: t('nav.build.cases'), href: L('/build/cases') },
      { label: t('nav.build.guides'), href: L('/build') + '#guides' },
      { label: t('nav.build.tools'), href: L('/build') + '#tools' },
      { label: t('nav.build.help'), href: L('/build') + '#help' },
    ]
  },
  {
    label: t('nav.market'),
    href: L('/market'),
    children: [
      { label: t('nav.market.shop'), href: L('/market') + '#products' },
      { label: t('nav.market.handles'), href: L('/market') + '#nostr-handles' },
      { label: t('nav.market.vendors'), href: L('/market') + '#vendors' },
    ]
  },
  {
    label: t('nav.community'),
    href: L('/community'),
    children: [
      { label: t('nav.community.wild'), href: L('/community/wild') },
      { label: t('nav.community.educators'), href: L('/community/educators') },
      { label: t('nav.community.kids'), href: L('/community/bitcoinkids') },
      { label: t('nav.community.zap'), href: L('/community/zapmypiggy') },
      { label: t('nav.community.credits'), href: L('/community/credits') },
      { label: t('nav.community.board'), href: L('/community') + '#message-board' },
    ]
  },
  { label: t('nav.app'), href: L('/app') },
  { label: t('nav.treasure'), href: L('/treasure-hunt') },
  {
    label: t('nav.news'),
    href: L('/news'),
    children: [
      { label: t('nav.news.inthenews'), href: L('/news') + '#in-the-news' },
      { label: t('nav.news.updates'), href: L('/news') + '#software-updates' },
    ]
  },
  { key: 'donate', label: t('nav.donate'), href: L('/donate') },
];

// Language picker: same page, other locale.
const canonicalPath = stripLocale(Astro.url.pathname);
const languageLinks = LOCALE_CODES.map((code) => ({
  code,
  label: LOCALES[code].label,
  href: localizePath(canonicalPath, code),
  current: code === lang,
}));

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={L('/')} class="flex items-center">
        <img src="/images/branding/lightningpiggy-logo.svg" alt="LightningPiggy" class="h-10 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class={`px-3 py-2 text-sm font-medium rounded-lg transition-colors whitespace-nowrap ${
                currentPath.startsWith(item.href) && item.href !== '/'
                  ? 'text-pink bg-pink-light/30'
                  : item.key === 'donate'
                    ? 'text-pink hover:text-pink hover:bg-pink-light/30'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
              }`}
            >
              {item.key === 'donate' && (
                <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              )}
              {item.label}
              {item.children && (
                <svg class="inline-block w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute left-0 mt-1 w-48 bg-white rounded-xl shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="py-2">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2 text-sm text-gray-600 hover:text-gray-900 hover:bg-gray-50"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Language picker. Plain links (no JS) so it works everywhere and each
           locale is independently crawlable; opens on hover and on keyboard
           focus so it isn't mouse-only. -->
      <div class="relative group hidden lg:block">
        <button
          type="button"
          aria-label={t('common.language')}
          aria-haspopup="true"
          class="flex items-center gap-1.5 px-2 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18M12 3a15 15 0 000 18" />
          </svg>
          <span class="uppercase">{lang}</span>
        </button>
        <div
          class="absolute right-0 top-full w-40 rounded-xl bg-white shadow-lg border border-gray-100 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all"
        >
          {languageLinks.map((l) => (
            <a
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              aria-current={l.current ? 'true' : undefined}
              class={`block px-4 py-2 text-sm hover:bg-gray-50 ${l.current ? 'text-pink font-semibold' : 'text-gray-600 hover:text-gray-900'}`}
            >
              {l.label}
            </a>
          ))}
        </div>
      </div>

      <!-- CTA Button -->
      <a
        href={L('/build')}
        class="hidden lg:inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-pink rounded-full hover:bg-gray-900 transition-colors"
      >
        {t('common.buildYourOwn')}
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white max-h-[calc(100vh-4rem)] overflow-y-auto overscroll-contain">
    <div class="px-4 py-4 space-y-2">
      {navItems.map((item) => (
        <div>
          <a
            href={item.href}
            class={`block px-3 py-2 text-base font-medium rounded-lg ${
              currentPath.startsWith(item.href) && item.href !== '/'
                ? 'text-pink bg-pink-light/30'
                : item.key === 'donate'
                  ? 'text-pink hover:text-pink hover:bg-pink-light/30'
                  : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
            }`}
          >
            {item.key === 'donate' && (
              <svg class="inline-block w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            )}
            {item.label}
          </a>
          {item.children && (
            <div class="ml-4 mt-1 space-y-1">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-2 text-sm text-gray-500 hover:text-gray-900 hover:bg-gray-50 rounded-lg"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a
        href={L('/build')}
        class="block w-full text-center px-4 py-3 text-base font-semibold text-white bg-pink rounded-full hover:bg-gray-900 transition-colors mt-4"
      >
        {t('common.buildYourOwn')}
      </a>

      <!-- Language picker (mobile): a plain row of links, no dropdown to trap
           focus inside the already-scrolling menu. -->
      <div class="mt-4 pt-4 border-t border-gray-100">
        <p class="px-3 mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
          {t('common.language')}
        </p>
        <div class="flex flex-wrap gap-2 px-3">
          {languageLinks.map((l) => (
            <a
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              aria-current={l.current ? 'true' : undefined}
              class={`px-3 py-1.5 text-sm rounded-full border transition-colors ${
                l.current
                  ? 'border-pink text-pink font-semibold bg-pink-light/30'
                  : 'border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50'
              }`}
            >
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>

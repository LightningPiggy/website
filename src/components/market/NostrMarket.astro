---
// NostrMarket.astro
// A Nostr-native market: each vendor is driven live from their npub. We pull
// the vendor's kind-0 profile (name, picture, about, nip-05, lightning address)
// and their NIP-99 (kind 30402) / NIP-15 (kind 30018) products in one relay
// pass, then render a vendor card with a ⚡ Zap button and their curated
// products. Vendors opt in / curate via src/data/vendors.json:
//
//   "products": { "mode": "curated", "include": ["<d-tag>", ...] }
//   "products": { "mode": "keywords", "keywords": ["piggy", "zap"] }
//   "products": { "mode": "all" }
//
// JSON name/logo/url act only as a fallback when the live profile is missing a
// field. Test/staging listings are always excluded; products are de-duped.

interface Vendor {
  name: string;
  url?: string;
  logo?: string;
  description?: string;
  shopType?: string;
  country?: string;
  shippingRegions?: string[];
  nostrUrl?: string;
  featured?: boolean;
  products?: { mode?: string; include?: string[]; keywords?: string[] };
}
interface Props {
  vendors: Vendor[];
  // When false, render pure vendor cards (no nested product grid) — used for the
  // dedicated "Vendors" section, since products get their own grid up top.
  showProducts?: boolean;
}
const { vendors, showProducts = true } = Astro.props;

// Every vendor is rendered. Those with an npub are enriched live from their
// kind-0 profile + NIP-99 products; those without fall back to this JSON.
const seeds = vendors.map((v) => ({
  npub: (v.nostrUrl?.match(/npub1[0-9a-z]+/) || [])[0] || '',
  fallbackName: v.name,
  fallbackLogo: v.logo || '',
  fallbackAbout: v.description || '',
  storeUrl: v.url || '',
  shopType: v.shopType || 'online',
  location: [v.country, (v.shippingRegions || []).length ? 'Ships to ' + (v.shippingRegions || []).join(', ') : '']
    .filter(Boolean)
    .join(' · '),
  featured: !!v.featured,
  mode: v.products?.mode || 'all',
  include: v.products?.include || [],
  keywords: v.products?.keywords || [],
}));
---

<div id="nostr-market" class="not-prose" data-seeds={JSON.stringify(seeds)} data-show-products={String(showProducts)}>
  <div id="market-loading" class="text-center py-12">
    <div class="inline-block animate-spin rounded-full h-9 w-9 border-4 border-pink border-t-transparent"></div>
    <p class="text-gray-500 mt-3">Loading vendors live from Nostr…</p>
  </div>
  <div id="market-vendors" class={`hidden ${showProducts ? 'space-y-8' : 'grid gap-6 sm:grid-cols-2'}`}></div>
  <div id="market-empty" class="text-center py-10 hidden">
    <p class="text-gray-500">No vendors available right now.</p>
  </div>
</div>

<script>
  // ---------- helpers ----------
  const BECH32 = 'qpzry9x8gf2tvdw0s3jn54khce6mua7l';
  function npubToHex(npub: string): string {
    if (!npub || !npub.startsWith('npub1')) return '';
    const pos = npub.lastIndexOf('1');
    const data: number[] = [];
    for (const c of npub.slice(pos + 1)) {
      const i = BECH32.indexOf(c);
      if (i === -1) return '';
      data.push(i);
    }
    const values = data.slice(0, -6);
    let acc = 0,
      bits = 0;
    const bytes: number[] = [];
    for (const v of values) {
      acc = (acc << 5) | v;
      bits += 5;
      while (bits >= 8) {
        bits -= 8;
        bytes.push((acc >> bits) & 0xff);
      }
    }
    return bytes.map((b) => b.toString(16).padStart(2, '0')).join('');
  }
  function escapeHtml(s: string): string {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }
  function sanitizeUrl(url: string): string {
    try {
      const p = new URL(url);
      if (p.protocol === 'http:' || p.protocol === 'https:') return url;
    } catch {}
    return '';
  }

  const RELAYS = [
    'wss://relay.damus.io',
    'wss://nos.lol',
    'wss://relay.primal.net',
    'wss://relay.nostr.band',
  ];

  interface NostrEvent {
    id: string;
    pubkey: string;
    kind: number;
    content: string;
    tags: string[][];
    created_at: number;
  }
  interface Seed {
    npub: string;
    fallbackName: string;
    fallbackLogo: string;
    fallbackAbout: string;
    storeUrl: string;
    shopType: string;
    location: string;
    featured: boolean;
    mode: string;
    include: string[];
    keywords: string[];
  }

  const tagVal = (t: string[][], k: string) => t.find((x) => x[0] === k)?.[1];
  const tagsAll = (t: string[][], k: string) => t.filter((x) => x[0] === k).map((x) => x[1]);

  const CUR: Record<string, string> = { GBP: '£', USD: '$', EUR: '€', SAT: '⚡', SATS: '⚡' };
  function fmtPrice(t: string[][]): string {
    const p = t.find((x) => x[0] === 'price');
    if (!p || !p[1]) return '';
    const cur = (p[2] || '').toUpperCase();
    const a = p[1].replace(/\.00$/, '');
    return CUR[cur] ? `${CUR[cur]}${a}` : cur ? `${a} ${cur}` : a;
  }
  function isTest(title: string, d: string): boolean {
    return /\b(localhost|staging|test|demo|sample)\b/i.test(title + ' ' + d);
  }

  // Vendors section hides per-vendor products (they get their own grid up top),
  // so we can fetch profiles only — read once at module scope.
  const SHOW_PRODUCTS =
    document.getElementById('nostr-market')?.dataset.showProducts !== 'false';
  const REQ_KINDS = SHOW_PRODUCTS ? [0, 30402, 30018] : [0];

  // Up-front timeout so a stalled socket can't hang Promise.all.
  function fetchFromRelay(url: string, authors: string[]): Promise<NostrEvent[]> {
    return new Promise((resolve) => {
      const events: NostrEvent[] = [];
      let ws: WebSocket | undefined;
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        clearTimeout(timer);
        try {
          ws && ws.close();
        } catch {}
        resolve(events);
      };
      const timer = window.setTimeout(finish, 6000);
      try {
        ws = new WebSocket(url);
      } catch {
        finish();
        return;
      }
      const sub = Math.random().toString(36).slice(2, 10);
      ws.onopen = () => ws!.send(JSON.stringify(['REQ', sub, { kinds: REQ_KINDS, authors }]));
      ws.onmessage = (e) => {
        try {
          const m = JSON.parse(e.data);
          if (m[0] === 'EVENT' && m[1] === sub) events.push(m[2]);
          if (m[0] === 'EOSE' && m[1] === sub) finish();
        } catch {}
      };
      ws.onerror = () => finish();
    });
  }

  interface Product {
    title: string;
    price: string;
    image: string;
    summary: string;
  }
  interface VendorView {
    name: string;
    picture: string;
    about: string;
    nip05: string;
    lud16: string;
    website: string;
    storeUrl: string;
    npub: string;
    shopType: string;
    location: string;
    featured: boolean;
    products: Product[];
  }

  function productMatches(ev: NostrEvent, seed: Seed): boolean {
    const d = tagVal(ev.tags, 'd') || '';
    const title = tagVal(ev.tags, 'title') || '';
    if (!d || !title || isTest(title, d)) return false;
    const inInclude = seed.include.includes(d);
    const kwHay = (
      title +
      ' ' +
      (tagVal(ev.tags, 'summary') || ev.content || '') +
      ' ' +
      tagsAll(ev.tags, 't').join(' ')
    ).toLowerCase();
    const kwMatch = seed.keywords.some((k) => kwHay.includes(k.toLowerCase()));
    if (seed.mode === 'curated') return inInclude || kwMatch; // curated pins + dynamic keywords
    if (seed.mode === 'keywords') return kwMatch;
    return true; // 'all'
  }

  async function init() {
    const root = document.getElementById('nostr-market');
    if (!root) return;
    const loadingEl = document.getElementById('market-loading');
    const listEl = document.getElementById('market-vendors');
    const emptyEl = document.getElementById('market-empty');

    let seeds: Seed[] = [];
    try {
      seeds = JSON.parse(root.dataset.seeds || '[]');
    } catch {}
    const byHex = new Map<string, Seed>();
    for (const s of seeds) {
      const hex = npubToHex(s.npub);
      if (hex) byHex.set(hex, s);
    }
    const authors = [...byHex.keys()];

    // Only hit relays if at least one vendor has an npub.
    const all = authors.length
      ? (await Promise.all(RELAYS.map((r) => fetchFromRelay(r, authors)))).flat()
      : [];

    // newest profile (kind 0) per pubkey, newest product per kind:pubkey:d
    const profiles = new Map<string, NostrEvent>();
    const products = new Map<string, NostrEvent>();
    for (const ev of all) {
      if (ev.kind === 0) {
        const ex = profiles.get(ev.pubkey);
        if (!ex || ev.created_at > ex.created_at) profiles.set(ev.pubkey, ev);
      } else {
        const key = `${ev.kind}:${ev.pubkey}:${tagVal(ev.tags, 'd') || ''}`;
        const ex = products.get(key);
        if (!ex || ev.created_at > ex.created_at) products.set(key, ev);
      }
    }

    // Build a view for EVERY vendor — npub vendors enriched from Nostr,
    // non-npub vendors straight from the JSON fallback.
    const views: VendorView[] = [];
    for (const seed of seeds) {
      const hex = npubToHex(seed.npub);
      let p: any = {};
      const prof = hex ? profiles.get(hex) : undefined;
      if (prof) {
        try {
          p = JSON.parse(prof.content);
        } catch {}
      }
      // collect + filter this vendor's products
      const mine = hex
        ? [...products.values()].filter((ev) => ev.pubkey === hex && productMatches(ev, seed))
        : [];
      const order = (ev: NostrEvent) =>
        seed.mode === 'curated' ? seed.include.indexOf(tagVal(ev.tags, 'd') || '') : 0;
      mine.sort((a, b) => {
        const oa = order(a),
          ob = order(b);
        const ra = oa === -1 ? 999 : oa,
          rb = ob === -1 ? 999 : ob;
        return ra - rb || b.created_at - a.created_at;
      });
      const seen = new Set<string>();
      const prodList: Product[] = [];
      for (const ev of mine) {
        const title = tagVal(ev.tags, 'title') || '';
        if (seen.has(title.toLowerCase())) continue;
        seen.add(title.toLowerCase());
        prodList.push({
          title,
          price: fmtPrice(ev.tags),
          image: sanitizeUrl(tagVal(ev.tags, 'image') || ''),
          summary: tagVal(ev.tags, 'summary') || ev.content || '',
        });
      }

      views.push({
        name: p.display_name || p.name || seed.fallbackName,
        picture: sanitizeUrl(p.picture || '') || seed.fallbackLogo,
        about: p.about || seed.fallbackAbout || '',
        nip05: p.nip05 || '',
        lud16: p.lud16 || p.lud06 || '',
        website: sanitizeUrl(p.website || '') || seed.storeUrl,
        storeUrl: seed.storeUrl || sanitizeUrl(p.website || ''),
        npub: seed.npub,
        shopType: seed.shopType,
        location: seed.location,
        featured: seed.featured,
        products: prodList,
      });
    }

    // Featured first.
    views.sort((a, b) => Number(b.featured) - Number(a.featured));

    loadingEl?.classList.add('hidden');
    if (!views.length) {
      emptyEl?.classList.remove('hidden');
      return;
    }
    if (listEl) {
      listEl.innerHTML = views.map(vendorHtml).join('');
      listEl.classList.remove('hidden');
    }
  }

  function productCard(p: Product, storeUrl: string): string {
    const img = p.image
      ? `<img src="${p.image}" alt="${escapeHtml(p.title)}" loading="lazy" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover group-hover/p:scale-105 transition-transform duration-500">`
      : `<div class="absolute inset-0 flex items-center justify-center text-gray-300 text-sm">No image</div>`;
    const price = p.price ? `<span class="text-pink font-bold text-sm whitespace-nowrap">${escapeHtml(p.price)}</span>` : '';
    return `
      <a href="${escapeHtml(storeUrl)}" target="_blank" rel="noopener noreferrer"
         class="group/p block bg-white rounded-xl border border-gray-200 overflow-hidden hover:border-pink hover:shadow-md transition-all">
        <div class="relative aspect-square bg-gray-50 overflow-hidden">${img}</div>
        <div class="p-3">
          <div class="flex items-start justify-between gap-2">
            <h4 class="text-sm font-semibold text-gray-900 leading-snug line-clamp-2">${escapeHtml(p.title)}</h4>
            ${price}
          </div>
        </div>
      </a>`;
  }

  function vendorHtml(v: VendorView): string {
    const avatar = v.picture
      ? `<img src="${v.picture}" alt="${escapeHtml(v.name)}" referrerpolicy="no-referrer" class="block w-full h-full object-cover" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
      : '';
    const initial = `<div class="w-full h-full bg-pink/10 items-center justify-center text-pink text-2xl font-bold ${v.picture ? 'hidden' : 'flex'}">${escapeHtml((v.name || '?').charAt(0).toUpperCase())}</div>`;
    const nip05 = v.nip05
      ? `<span class="inline-flex items-center gap-1 text-xs text-gray-500"><svg class="w-3.5 h-3.5 text-pink" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>${escapeHtml(v.nip05.replace(/^_@/, ''))}</span>`
      : '';
    const website = v.website
      ? `<a href="${escapeHtml(v.website)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-semibold text-gray-700 hover:text-pink"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z M3.6 9h16.8 M3.6 15h16.8 M12 3a15 15 0 010 18 M12 3a15 15 0 000 18"/></svg>Visit store</a>`
      : '';
    const zap = v.lud16
      ? `<button type="button" class="zap-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-yellow text-gray-900 text-sm font-semibold hover:brightness-95 transition" data-lud16="${escapeHtml(v.lud16)}" data-name="${escapeHtml(v.name)}">
           <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M11 21h-1l1-7H6.74a.6.6 0 01-.5-.92L13 3h1l-1 7h4.26a.6.6 0 01.5.92L11 21z"/></svg>Zap</button>`
      : '';
    const products =
      SHOW_PRODUCTS && v.products.length > 0
        ? `<div class="mt-5 grid grid-cols-2 sm:grid-cols-3 gap-3">${v.products.map((p) => productCard(p, v.storeUrl)).join('')}</div>`
        : '';
    const shopLabel =
      v.shopType === 'physical' ? 'Physical' : v.shopType === 'both' ? 'Online & Physical' : 'Online';
    const meta = [v.location, shopLabel].filter(Boolean).join(' · ');
    const featuredRibbon = v.featured
      ? `<span class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wide text-gray-800 bg-yellow/40 px-2.5 py-1 rounded-full">★ Pride of the Market</span>`
      : '';
    // Featured vendors get a stronger yellow halo + ring to stand out.
    const cardClass = v.featured
      ? 'border-yellow ring-1 ring-yellow/50 shadow-[0_0_28px_2px_rgba(255,219,0,0.45)]'
      : 'border-gray-200 hover:border-pink/50 hover:shadow-md';
    return `
      <div class="rounded-2xl border ${cardClass} bg-white p-6 transition-all">
        <div class="flex items-start gap-4">
          <div class="w-16 h-16 rounded-2xl overflow-hidden flex-shrink-0 bg-gray-100">${avatar}${initial}</div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <h3 class="text-xl font-bold text-gray-900">${escapeHtml(v.name)}</h3>
              ${featuredRibbon}
            </div>
            ${meta ? `<p class="text-xs text-gray-500 mt-0.5">${escapeHtml(meta)}</p>` : ''}
            ${v.nip05 ? `<div class="mt-1">${nip05}</div>` : ''}
            ${v.about ? `<p class="text-sm text-gray-600 mt-2 line-clamp-2">${escapeHtml(v.about)}</p>` : ''}
            <div class="flex flex-wrap items-center gap-3 mt-3">${website}${zap}</div>
          </div>
        </div>
        ${products}
      </div>`;
  }

  // ---------- Zap: lightweight LNURL-pay link-out (v1) ----------
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('.zap-btn') as HTMLElement | null;
    if (!btn) return;
    e.preventDefault();
    const lud16 = btn.dataset.lud16 || '';
    const at = lud16.indexOf('@');
    if (at < 1) return;
    const name = lud16.slice(0, at);
    const domain = lud16.slice(at + 1);
    // Open the vendor's LNURL-pay in the user's default Lightning handler.
    // Wallets registered for the `lightning:` scheme will prompt for an amount.
    try {
      const res = await fetch(`https://${domain}/.well-known/lnurlp/${name}`);
      const data = await res.json();
      if (data && data.callback) {
        window.location.href = `lightning:${lud16}`;
        return;
      }
    } catch {}
    window.location.href = `lightning:${lud16}`;
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

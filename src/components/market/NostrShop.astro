---
// NostrShop.astro
// Live "shop" of curated NIP-99 (kind 30402) / NIP-15 (kind 30018) products
// pulled from selected vendors' Nostr profiles. Each vendor opts in via a
// `products` block in src/data/vendors.json:
//
//   "products": { "mode": "curated", "include": ["<d-tag>", ...] }
//   "products": { "mode": "keywords", "keywords": ["piggy", "zap"] }
//   "products": { "mode": "all" }
//
// Only the curated/keyword subset is shown, test/staging listings are always
// excluded, and duplicate listings are de-duped. Clicking a product opens the
// vendor's own store (NIP-99 events carry no buy URL).

interface ShopInput {
  name: string;
  storeUrl: string;
  logo?: string;
  nostrUrl?: string;
  products?: { mode?: string; include?: string[]; keywords?: string[] };
}
interface Props {
  vendors: ShopInput[];
}
const { vendors } = Astro.props;

// Shape just what the client script needs, and pull the npub out of nostrUrl.
const shops = vendors
  .filter((v) => v.products && v.nostrUrl)
  .map((v) => ({
    name: v.name,
    storeUrl: v.storeUrl,
    logo: v.logo || '',
    npub: (v.nostrUrl!.match(/npub1[0-9a-z]+/) || [])[0] || '',
    mode: v.products!.mode || 'curated',
    include: v.products!.include || [],
    keywords: v.products!.keywords || [],
  }))
  .filter((s) => s.npub);
---

{shops.length > 0 && (
  <div id="nostr-shop" class="not-prose" data-shops={JSON.stringify(shops)}>
    <!-- Loading -->
    <div id="shop-loading" class="text-center py-10">
      <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-pink border-t-transparent"></div>
      <p class="text-gray-500 mt-3">Loading products from Nostr…</p>
    </div>

    <!-- Grid -->
    <div id="shop-grid" class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 hidden"></div>

    <!-- Empty / error -->
    <div id="shop-empty" class="text-center py-8 hidden">
      <p class="text-gray-500">No products available right now.</p>
    </div>
  </div>
)}

<script>
  // ---- bech32 npub → hex (same approach as NostrProducts.astro) ----
  const BECH32 = 'qpzry9x8gf2tvdw0s3jn54khce6mua7l';
  function npubToHex(npub: string): string {
    if (!npub || !npub.startsWith('npub1')) return '';
    const pos = npub.lastIndexOf('1');
    const data: number[] = [];
    for (const c of npub.slice(pos + 1)) {
      const i = BECH32.indexOf(c);
      if (i === -1) return '';
      data.push(i);
    }
    const values = data.slice(0, -6);
    let acc = 0,
      bits = 0;
    const bytes: number[] = [];
    for (const v of values) {
      acc = (acc << 5) | v;
      bits += 5;
      while (bits >= 8) {
        bits -= 8;
        bytes.push((acc >> bits) & 0xff);
      }
    }
    return bytes.map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
  function sanitizeUrl(url: string): string {
    try {
      const p = new URL(url);
      if (p.protocol === 'http:' || p.protocol === 'https:') return url;
    } catch {}
    return '';
  }

  const RELAYS = [
    'wss://relay.damus.io',
    'wss://nos.lol',
    'wss://relay.primal.net',
    'wss://relay.nostr.band',
  ];

  interface NostrEvent {
    id: string;
    pubkey: string;
    kind: number;
    content: string;
    tags: string[][];
    created_at: number;
  }
  interface Shop {
    name: string;
    storeUrl: string;
    logo: string;
    npub: string;
    mode: string;
    include: string[];
    keywords: string[];
  }

  const tag = (t: string[][], k: string) => t.find((x) => x[0] === k);
  const tagVal = (t: string[][], k: string) => tag(t, k)?.[1];
  const tagsAll = (t: string[][], k: string) => t.filter((x) => x[0] === k).map((x) => x[1]);

  const CURRENCY_SYMBOL: Record<string, string> = { GBP: '£', USD: '$', EUR: '€', SAT: '⚡', SATS: '⚡' };
  function formatPrice(t: string[][]): string {
    const p = tag(t, 'price');
    if (!p) return '';
    const amount = p[1] || '';
    const cur = (p[2] || '').toUpperCase();
    if (!amount) return '';
    const sym = CURRENCY_SYMBOL[cur];
    // Trim a trailing ".00" for whole amounts.
    const a = amount.replace(/\.00$/, '');
    return sym ? `${sym}${a}` : cur ? `${a} ${cur}` : a;
  }

  // Test/staging listings are never shown, regardless of mode.
  function isTestProduct(title: string, d: string): boolean {
    const s = (title + ' ' + d).toLowerCase();
    return /\b(localhost|staging)\b/.test(s) || /staging|localhost/.test(d.toLowerCase());
  }

  interface Product {
    title: string;
    price: string;
    image: string;
    summary: string;
    storeUrl: string;
    vendor: string;
    vendorLogo: string;
    createdAt: number;
  }

  function fetchFromRelay(url: string, authors: string[]): Promise<NostrEvent[]> {
    return new Promise((resolve) => {
      const events: NostrEvent[] = [];
      let ws: WebSocket | undefined;
      let done = false;
      // Overall timeout set up-front (NOT inside onopen) so a relay whose socket
      // never opens — and never errors — can't hang the whole Promise.all.
      const finish = () => {
        if (done) return;
        done = true;
        clearTimeout(timer);
        try {
          ws && ws.close();
        } catch {}
        resolve(events);
      };
      const timer = window.setTimeout(finish, 6000);
      try {
        ws = new WebSocket(url);
      } catch {
        finish();
        return;
      }
      const sub = Math.random().toString(36).slice(2, 10);
      ws.onopen = () => ws!.send(JSON.stringify(['REQ', sub, { kinds: [30402, 30018], authors }]));
      ws.onmessage = (e) => {
        try {
          const msg = JSON.parse(e.data);
          if (msg[0] === 'EVENT' && msg[1] === sub) events.push(msg[2]);
          if (msg[0] === 'EOSE' && msg[1] === sub) finish();
        } catch {}
      };
      ws.onerror = () => finish();
    });
  }

  function matchesShop(ev: NostrEvent, shop: Shop): boolean {
    const d = tagVal(ev.tags, 'd') || '';
    const title = tagVal(ev.tags, 'title') || '';
    if (!d || !title) return false;
    if (isTestProduct(title, d)) return false;
    if (shop.mode === 'curated') return shop.include.includes(d);
    if (shop.mode === 'keywords') {
      const hay = (
        title +
        ' ' +
        (tagVal(ev.tags, 'summary') || ev.content || '') +
        ' ' +
        tagsAll(ev.tags, 't').join(' ')
      ).toLowerCase();
      return shop.keywords.some((k) => hay.includes(k.toLowerCase()));
    }
    return true; // 'all'
  }

  async function init() {
    const root = document.getElementById('nostr-shop');
    if (!root) return;
    const loadingEl = document.getElementById('shop-loading');
    const gridEl = document.getElementById('shop-grid');
    const emptyEl = document.getElementById('shop-empty');

    let shops: Shop[] = [];
    try {
      shops = JSON.parse(root.dataset.shops || '[]');
    } catch {}
    const byPubkey = new Map<string, Shop>();
    for (const s of shops) {
      const hex = npubToHex(s.npub);
      if (hex) byPubkey.set(hex, s);
    }
    const authors = [...byPubkey.keys()];
    if (authors.length === 0) {
      loadingEl?.classList.add('hidden');
      emptyEl?.classList.remove('hidden');
      return;
    }

    const results = await Promise.all(RELAYS.map((r) => fetchFromRelay(r, authors)));
    // Dedupe replaceable events by kind:pubkey:d, keeping newest.
    const newest = new Map<string, NostrEvent>();
    for (const ev of results.flat()) {
      const d = tagVal(ev.tags, 'd') || '';
      const key = `${ev.kind}:${ev.pubkey}:${d}`;
      const ex = newest.get(key);
      if (!ex || ev.created_at > ex.created_at) newest.set(key, ev);
    }

    // Curated order: preserve each shop's `include` order; then de-dup by title.
    const products: Product[] = [];
    const seenTitles = new Set<string>();
    const evList = [...newest.values()];
    for (const shop of shops) {
      const hex = npubToHex(shop.npub);
      const mine = evList.filter((ev) => ev.pubkey === hex && matchesShop(ev, shop));
      const order = (ev: NostrEvent) =>
        shop.mode === 'curated' ? shop.include.indexOf(tagVal(ev.tags, 'd') || '') : 0;
      mine.sort((a, b) => order(a) - order(b) || b.created_at - a.created_at);
      for (const ev of mine) {
        const title = tagVal(ev.tags, 'title') || '';
        const titleKey = `${hex}:${title.toLowerCase()}`;
        if (seenTitles.has(titleKey)) continue;
        seenTitles.add(titleKey);
        const image = sanitizeUrl(tagVal(ev.tags, 'image') || '');
        products.push({
          title,
          price: formatPrice(ev.tags),
          image,
          summary: tagVal(ev.tags, 'summary') || ev.content || '',
          storeUrl: shop.storeUrl,
          vendor: shop.name,
          vendorLogo: sanitizeUrl(shop.logo) || (shop.logo.startsWith('/') ? shop.logo : ''),
          createdAt: ev.created_at,
        });
      }
    }

    loadingEl?.classList.add('hidden');
    if (products.length === 0) {
      emptyEl?.classList.remove('hidden');
      return;
    }
    if (gridEl) {
      gridEl.innerHTML = products.map(cardHtml).join('');
      gridEl.classList.remove('hidden');
    }
  }

  function cardHtml(p: Product): string {
    const img = p.image
      ? `<img src="${p.image}" alt="${escapeHtml(p.title)}" loading="lazy" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'">`
      : `<div class="absolute inset-0 flex items-center justify-center text-gray-300 text-sm">No image</div>`;
    const price = p.price
      ? `<span class="text-pink font-bold whitespace-nowrap">${escapeHtml(p.price)}</span>`
      : '';
    // Store badge: logo (or initial) + vendor name, sourced from vendors.json.
    const logo = p.vendorLogo
      ? `<img src="${escapeHtml(p.vendorLogo)}" alt="${escapeHtml(p.vendor)}" referrerpolicy="no-referrer" class="w-5 h-5 rounded-full object-cover flex-shrink-0" onerror="this.style.display='none'">`
      : `<span class="w-5 h-5 rounded-full bg-pink/10 text-pink text-[10px] font-bold flex items-center justify-center flex-shrink-0">${escapeHtml((p.vendor || '?').charAt(0).toUpperCase())}</span>`;
    return `
      <a href="${escapeHtml(p.storeUrl)}" target="_blank" rel="noopener noreferrer"
         class="group flex flex-col bg-white rounded-2xl border border-gray-200 overflow-hidden transition-all hover:border-pink hover:shadow-lg">
        <div class="relative aspect-square bg-gray-50 overflow-hidden">${img}</div>
        <div class="flex flex-col flex-1 p-4">
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-semibold text-gray-900 leading-snug line-clamp-2">${escapeHtml(p.title)}</h3>
            ${price}
          </div>
          <p class="text-sm text-gray-500 mt-1 line-clamp-2 flex-1">${escapeHtml(p.summary.slice(0, 120))}</p>
          <div class="mt-3 pt-3 border-t border-gray-100 flex items-center gap-2">
            ${logo}
            <span class="text-xs text-gray-500 truncate flex-1">${escapeHtml(p.vendor)}</span>
            <span class="inline-flex items-center gap-1 text-sm font-semibold text-pink group-hover:gap-2 transition-all whitespace-nowrap">
              Buy
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </div>
      </a>`;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

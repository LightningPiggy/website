---
// ProductPurchase.astro
// Client-side, Nostr-native checkout island (no backend). Modelled on the
// robotechy checkout, adapted for a multi-vendor market:
//
//   1. Buy now → pop-up. Step 1 collects the shipping address (requires a Nostr
//      sign-in, since the order is sent AS the buyer).
//   2. "Continue to payment": the order + shipping address is sent to the vendor
//      as a NIP-17 gift-wrapped (encrypted) DM (kind 14) — see nostrOrder.ts —
//      and an invoice is fetched from the vendor's own Lightning address (lud16,
//      LNURL-pay). No single-merchant order-service: each vendor is paid + DM'd
//      directly.
//   3. Pay the invoice (WebLN / wallet / copy). On WebLN success a receipt DM
//      (with the payment preimage) is sent to the vendor.
//
// The vendor reads the order as an encrypted Nostr DM in their client (Damus,
// Primal, Alby, …) and ships it. The LNURL comment carries the order id so
// manually-paid invoices can be correlated.

interface Props {
  lud16: string; // vendor Lightning address, e.g. name@domain (may be '')
  vendorPubkey: string; // vendor hex pubkey (the product author) — DM recipient
  priceAmount: string;
  priceCurrency: string;
  title: string;
  vendorName: string;
  vendorPicture: string; // vendor's Nostr profile image (may be '')
  storeUrl: string; // external fallback
  medium: string; // digital products skip shipping (Gamma spec)
  shippingRefs: string; // JSON: product's `shipping_option` refs (coord + extraCost)
}
const { lud16, vendorPubkey, priceAmount, priceCurrency, title, vendorName, vendorPicture, storeUrl, medium, shippingRefs } =
  Astro.props;
const canPayOnSite = !!lud16 && !!priceAmount;
---

<div
  id="product-purchase"
  data-lud16={lud16}
  data-vendor-pubkey={vendorPubkey}
  data-amount={priceAmount}
  data-currency={priceCurrency}
  data-title={title}
  data-vendor={vendorName}
  data-store={storeUrl}
  data-medium={medium}
  data-shipping-refs={shippingRefs}
>
  {canPayOnSite ? (
    <>
      <button
        id="buy-btn"
        type="button"
        class="group w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-pink text-white text-base font-bold shadow-lg shadow-pink/25 hover:bg-pink/90 hover:shadow-xl active:scale-[0.99] transition-all disabled:opacity-60 disabled:pointer-events-none"
      >
        <svg class="w-5 h-5 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor"><path d="M11 21h-1l1-7H6.74a.6.6 0 01-.5-.92L13 3h1l-1 7h4.26a.6.6 0 01.5.92L11 21z"/></svg>
        Buy now with Lightning
      </button>
      <p class="text-xs text-gray-500 mt-2.5 max-w-sm flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Paid directly to {vendorName} over Lightning — no middleman, no sign-up.
      </p>

      <!-- Checkout pop-up -->
      <div id="pay-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="pay-title">
        <div id="pay-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
        <div class="relative w-full max-w-md max-h-[90vh] overflow-y-auto bg-white rounded-2xl shadow-2xl p-6 md:p-7">
          <button id="pay-close" type="button" aria-label="Close" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>

          <div class="flex items-center gap-2 mb-1">
            <svg class="w-5 h-5 text-pink" viewBox="0 0 24 24" fill="currentColor"><path d="M11 21h-1l1-7H6.74a.6.6 0 01-.5-.92L13 3h1l-1 7h4.26a.6.6 0 01.5.92L11 21z"/></svg>
            <h3 id="pay-title" class="text-xl font-bold text-gray-900">Checkout</h3>
          </div>
          <p class="text-sm font-medium text-gray-800 truncate">{title}</p>

          <!-- Seller attribution: order is with the vendor, not Lightning Piggy. -->
          <div class="flex items-center gap-2.5 mt-2 rounded-lg bg-gray-50 border border-gray-200 px-3 py-2">
            <span class="w-8 h-8 rounded-full overflow-hidden bg-pink/10 flex items-center justify-center flex-shrink-0">
              {vendorPicture ? (
                <img src={vendorPicture} alt={vendorName} referrerpolicy="no-referrer" class="w-full h-full object-cover" />
              ) : (
                <span class="text-pink text-sm font-bold">{(vendorName || '?').charAt(0).toUpperCase()}</span>
              )}
            </span>
            <div class="min-w-0 leading-tight">
              <p class="text-[11px] text-gray-500">Sold &amp; shipped by</p>
              <p class="text-sm font-semibold text-gray-900 truncate">{vendorName}</p>
            </div>
          </div>
          <p class="text-[11px] text-gray-400 mt-2 mb-4">
            Lightning Piggy is the marketplace — your order &amp; payment go directly to {vendorName}, not Lightning Piggy.
          </p>

          <!-- Step 1: shipping (guest by default; sign-in optional) -->
          <div id="view-shipping">
            <form id="ship-form" class="space-y-3">
              <div id="ship-auth-banner" class="flex items-center justify-between gap-3 rounded-lg border px-3 py-2.5">
                <span id="ship-who" class="text-sm"></span>
                <button type="button" id="ship-auth-action" class="text-sm font-semibold text-pink hover:underline whitespace-nowrap"></button>
              </div>
              <p class="text-sm text-gray-500">Where should {vendorName} ship this? <span class="text-gray-400">(<span class="text-pink">*</span> required)</span></p>
              <div class="grid grid-cols-2 gap-3">
                <input id="ship-name" required placeholder="Full name *" class="col-span-2 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink focus:ring-1 focus:ring-pink outline-none" />
                <input id="ship-email" type="email" placeholder="Email *" class="col-span-2 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink focus:ring-1 focus:ring-pink outline-none" />
                <input id="ship-addr1" required placeholder="Address *" class="col-span-2 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink focus:ring-1 focus:ring-pink outline-none" />
                <input id="ship-addr2" placeholder="Address line 2 (optional)" class="col-span-2 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink focus:ring-1 focus:ring-pink outline-none" />
                <input id="ship-city" required placeholder="City *" class="rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink focus:ring-1 focus:ring-pink outline-none" />
                <input id="ship-postcode" required placeholder="Post code *" class="rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink focus:ring-1 focus:ring-pink outline-none" />
                <select id="ship-country" required class="col-span-2 rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white focus:border-pink focus:ring-1 focus:ring-pink outline-none">
                  <option value="">Country *</option>
                </select>
                <!-- Shipping method: populated live from the vendor's Nostr
                     shipping options (kind 30406). Hidden when the vendor has
                     none; REQUIRED when they do, and its price is added to the
                     Lightning invoice. -->
                <div id="ship-method-wrap" class="col-span-2 hidden">
                  <select id="ship-method" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white focus:border-pink focus:ring-1 focus:ring-pink outline-none">
                    <option value="">Select shipping method *</option>
                  </select>
                </div>
                <textarea id="ship-note" rows="2" placeholder="Note to vendor (optional)" class="col-span-2 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink focus:ring-1 focus:ring-pink outline-none"></textarea>
              </div>
              <button type="submit" id="ship-submit" class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-pink text-white font-semibold rounded-xl hover:bg-pink/90 transition disabled:opacity-60">
                Continue to payment
              </button>
              <p id="ship-status" class="text-sm text-center text-gray-500"></p>
            </form>
          </div>

          <!-- Step 2: payment -->
          <div id="view-payment" class="hidden">
            <div id="invoice-status" class="py-6 text-center text-sm text-gray-600">
              <div class="inline-block animate-spin rounded-full h-7 w-7 border-4 border-pink border-t-transparent mb-3"></div>
              <p id="invoice-status-text">Requesting invoice…</p>
            </div>
            <div id="invoice-body" class="hidden">
              <p class="text-green-600 text-sm font-semibold mb-3">✓ Order sent to {vendorName}. Now pay to confirm:</p>
              <div class="flex justify-center mb-3">
                <img id="invoice-qr" alt="Scan to pay with a Lightning wallet" width="200" height="200" class="hidden w-52 h-52 rounded-xl border border-gray-200 bg-white p-2" />
              </div>
              <p id="invoice-amount" class="text-center text-2xl font-bold text-gray-900"></p>
              <p id="invoice-fiat" class="text-center text-sm text-gray-500 mb-4"></p>
              <label class="block text-sm text-gray-500 mb-1">Lightning invoice</label>
              <div class="flex gap-2 mb-4">
                <input id="invoice-bolt11" readonly class="flex-1 min-w-0 text-xs font-mono rounded-lg border border-gray-300 bg-gray-50 px-3 py-2" />
                <button id="invoice-copy" type="button" title="Copy invoice" aria-label="Copy invoice" class="shrink-0 px-3 rounded-lg border border-gray-300 text-gray-500 hover:border-pink hover:text-pink transition">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>
              <!-- Payment options: WebLN (one-click, if a wallet is present) is primary -->
              <div class="space-y-2">
                <button id="invoice-webln" type="button" class="hidden w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-pink text-white font-semibold hover:bg-pink/90 transition disabled:opacity-60">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M11 21h-1l1-7H6.74a.6.6 0 01-.5-.92L13 3h1l-1 7h4.26a.6.6 0 01.5.92L11 21z"/></svg>
                  Pay with WebLN
                </button>
                <a id="invoice-open" href="#" class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-gray-300 font-semibold text-gray-700 hover:border-pink hover:text-pink transition">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  Open in wallet
                </a>
              </div>
              <p class="text-xs text-gray-400 text-center mt-3">Scan the QR or copy the invoice to pay with any Lightning wallet.</p>
              <p id="invoice-paid" class="hidden mt-3 text-center text-sm font-semibold text-green-600">✓ Paid — thank you! {vendorName} has your order.</p>
            </div>
            <div id="invoice-error" class="hidden py-4 text-center text-sm text-red-500">
              <span id="invoice-error-text">Couldn't create an invoice.</span><br />
              <a href={storeUrl} target="_blank" rel="noopener noreferrer" class="underline">Buy on the {vendorName} store instead →</a>
            </div>
          </div>
        </div>
      </div>
    </>
  ) : (
    <a
      href={storeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-pink text-white text-base font-bold shadow-lg shadow-pink/25 hover:bg-pink/90 hover:shadow-xl transition-all"
    >
      Buy on the {vendorName} store
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  )}
</div>

<script>
  import { getSession, openLogin, logout, shortId, type NostrSession } from '../../lib/nostrAuth';
  import { sendGiftWrappedDM } from '../../lib/nostrOrder';
  import { RELAYS, applyDeletions, tagVal, type NostrEvent } from '../../lib/market';

  const root = document.getElementById('product-purchase');
  if (root && root.dataset.lud16 && root.dataset.amount) {
    const lud16 = root.dataset.lud16!;
    const vendorPubkey = root.dataset.vendorPubkey || '';
    const amount = parseFloat(root.dataset.amount || '0');
    const currency = (root.dataset.currency || '').toUpperCase();
    const title = root.dataset.title || 'Product';
    const vendor = root.dataset.vendor || 'the vendor';

    const modal = document.getElementById('pay-modal');
    const backdrop = document.getElementById('pay-backdrop');
    const closeBtn = document.getElementById('pay-close');
    const buyBtn = document.getElementById('buy-btn') as HTMLButtonElement | null;
    const viewShipping = document.getElementById('view-shipping');
    const viewPayment = document.getElementById('view-payment');
    const shipForm = document.getElementById('ship-form') as HTMLFormElement | null;
    const shipWho = document.getElementById('ship-who');
    const statusEl = document.getElementById('invoice-status');
    const statusText = document.getElementById('invoice-status-text');
    const bodyEl = document.getElementById('invoice-body');
    const errEl = document.getElementById('invoice-error');
    const errText = document.getElementById('invoice-error-text');

    function openModal() {
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
    });

    const shipBanner = document.getElementById('ship-auth-banner');
    const shipAction = document.getElementById('ship-auth-action');
    const shipSubmit = document.getElementById('ship-submit');
    const shipEmail = document.getElementById('ship-email') as HTMLInputElement | null;

    // Make the guest-vs-signed-in state unmistakable: a banner, a submit label
    // that changes, and email required for guests (their only contact) but
    // optional for signed-in buyers (the vendor can reply over Nostr).
    function renderShipAuth(session: NostrSession | null) {
      if (session) {
        if (shipWho) {
          // session.name comes from a relay-published profile — set via textContent
          // so it can never be interpreted as HTML.
          shipWho.textContent = 'Signed in as ';
          const who = document.createElement('strong');
          who.textContent = session.name || shortId(session.pubkey);
          shipWho.appendChild(who);
        }
        if (shipAction) shipAction.textContent = 'Sign out';
        if (shipBanner) shipBanner.className = 'flex items-center justify-between gap-3 rounded-lg border border-green-200 bg-green-50 px-3 py-2.5 text-green-800';
        if (shipSubmit) shipSubmit.textContent = 'Continue to payment';
        if (shipEmail) {
          shipEmail.required = false;
          shipEmail.placeholder = 'Email (optional)';
        }
      } else {
        if (shipWho) shipWho.innerHTML = '👤 Checking out as <strong>guest</strong>';
        if (shipAction) shipAction.textContent = 'Sign in';
        if (shipBanner) shipBanner.className = 'flex items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2.5 text-amber-800';
        if (shipSubmit) shipSubmit.textContent = 'Continue as guest';
        if (shipEmail) {
          shipEmail.required = true;
          shipEmail.placeholder = 'Email *';
        }
      }
    }
    window.addEventListener('nostr:auth', (e) => renderShipAuth((e as CustomEvent).detail));
    shipAction?.addEventListener('click', () => {
      if (getSession()) logout();
      else openLogin();
    });

    // ---- Shipping methods (Gamma Markets spec) ----
    // A product declares its shipping via `shipping_option` refs — direct 30406
    // options or 30405 collections whose options it inherits (spec: both MUST be
    // merged) — each with an optional extra cost in the PRODUCT's currency.
    // Digital products skip shipping. Products with no refs fall back to all of
    // the vendor's options (pragmatic superset for not-yet-linked listings).
    // Options are filtered by the buyer's country (spec: "validate constraints
    // before offering"), selection is REQUIRED, and base + extra are added to
    // the invoice.
    interface ShipOption { coord: string; title: string; amount: number; currency: string; countries: string[]; extraCost: number }
    const isDigital = (root.dataset.medium || '') === 'digital';
    let productRefs: { coord: string; extraCost: number }[] = [];
    try { productRefs = JSON.parse(root.dataset.shippingRefs || '[]'); } catch {}
    let shipOptions: ShipOption[] | null = null; // null = not loaded yet

    function fetchGammaFromRelay(url: string, filter: any): Promise<NostrEvent[]> {
      return new Promise((resolve) => {
        const evs: NostrEvent[] = [];
        let ws: WebSocket | undefined;
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          clearTimeout(t);
          try {
            if (ws) {
              ws.onopen = () => { try { ws!.close(); } catch {} };
              ws.close();
            }
          } catch {}
          resolve(evs);
        };
        const t = window.setTimeout(finish, 6000);
        try { ws = new WebSocket(url); } catch { finish(); return; }
        const sub = Math.random().toString(36).slice(2, 10);
        ws.onopen = () => ws!.send(JSON.stringify(['REQ', sub, filter]));
        ws.onmessage = (e) => {
          try {
            const m = JSON.parse(e.data);
            if (m[0] === 'EVENT' && m[1] === sub) evs.push(m[2]);
            if (m[0] === 'EOSE' && m[1] === sub) finish();
          } catch {}
        };
        ws.onerror = () => finish();
      });
    }
    async function fetchGamma(filter: any): Promise<NostrEvent[]> {
      const raw = (await Promise.all(RELAYS.map((r) => fetchGammaFromRelay(r, filter)))).flat();
      const newest = new Map<string, NostrEvent>();
      for (const ev of applyDeletions(raw)) {
        const key = `${ev.kind}:${ev.pubkey}:${tagVal(ev.tags, 'd') || ''}`;
        const ex = newest.get(key);
        if (!ex || ev.created_at > ex.created_at) newest.set(key, ev);
      }
      return [...newest.values()];
    }
    function parseOption(ev: NostrEvent, extraCost: number): ShipOption | null {
      const price = ev.tags.find((x) => x[0] === 'price');
      const countryTag = ev.tags.find((x) => x[0] === 'country');
      const o = {
        coord: `30406:${ev.pubkey}:${tagVal(ev.tags, 'd') || ''}`,
        title: tagVal(ev.tags, 'title') || '',
        amount: parseFloat(price?.[1] || ''),
        currency: (price?.[2] || 'SATS').toUpperCase(),
        countries: countryTag ? countryTag.slice(1).filter(Boolean).map((c) => c.toUpperCase()) : [],
        extraCost,
      };
      return o.title && isFinite(o.amount) && o.amount >= 0 ? o : null;
    }
    async function loadShippingOptions() {
      if (shipOptions !== null || !vendorPubkey) return;
      if (isDigital) { shipOptions = []; return; } // spec: digital skips shipping

      if (productRefs.length) {
        // Resolve the product's declared refs (direct + collection-inherited).
        const authors = [...new Set(productRefs.map((r) => r.coord.split(':')[1]))];
        const ds = [...new Set(productRefs.map((r) => r.coord.split(':')[2]))];
        const evs = await fetchGamma({ kinds: [30406, 30405, 5], authors, '#d': ds });
        const byCoord = new Map(evs.map((ev) => [`${ev.kind}:${ev.pubkey}:${tagVal(ev.tags, 'd') || ''}`, ev]));
        const wanted = new Map<string, number>(); // 30406 coord -> extra cost
        const collectionRefs: { coord: string; extraCost: number }[] = [];
        for (const r of productRefs) {
          if (r.coord.startsWith('30406:')) wanted.set(r.coord, r.extraCost);
          else collectionRefs.push(r);
        }
        // Collections: inherit their shipping_option refs (extra applies to all).
        const missing: { coord: string; extraCost: number }[] = [];
        for (const cr of collectionRefs) {
          const cev = byCoord.get(cr.coord);
          if (!cev) continue;
          for (const t of cev.tags) {
            if (t[0] !== 'shipping_option' || !/^30406:[0-9a-f]{64}:/.test(t[1] || '')) continue;
            if (!wanted.has(t[1])) {
              wanted.set(t[1], cr.extraCost);
              if (!byCoord.has(t[1])) missing.push({ coord: t[1], extraCost: cr.extraCost });
            }
          }
        }
        if (missing.length) {
          const evs2 = await fetchGamma({
            kinds: [30406, 5],
            authors: [...new Set(missing.map((m) => m.coord.split(':')[1]))],
            '#d': [...new Set(missing.map((m) => m.coord.split(':')[2]))],
          });
          for (const ev of evs2) byCoord.set(`${ev.kind}:${ev.pubkey}:${tagVal(ev.tags, 'd') || ''}`, ev);
        }
        shipOptions = [...wanted.entries()]
          .map(([coord, extra]) => {
            const ev = byCoord.get(coord);
            return ev && ev.kind === 30406 ? parseOption(ev, extra) : null;
          })
          .filter(Boolean) as ShipOption[];
      } else {
        // Fallback: no refs declared — offer all of the vendor's options.
        const evs = await fetchGamma({ kinds: [30406, 5], authors: [vendorPubkey] });
        shipOptions = evs.filter((e) => e.kind === 30406).map((e) => parseOption(e, 0)).filter(Boolean) as ShipOption[];
      }
      renderShipOptions();
    }

    // Country select: ISO 3166-1 alpha-2, names via Intl.DisplayNames.
    const COUNTRY_CODES = 'AD AE AF AG AI AL AM AO AR AT AU AW AZ BA BB BD BE BF BG BH BI BJ BM BN BO BR BS BT BW BY BZ CA CD CF CG CH CI CL CM CN CO CR CU CV CY CZ DE DJ DK DM DO DZ EC EE EG ER ES ET FI FJ FM FO FR GA GB GD GE GG GH GI GL GM GN GQ GR GT GW GY HK HN HR HT HU ID IE IL IM IN IQ IR IS IT JE JM JO JP KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MG MH MK ML MM MN MO MR MS MT MU MV MW MX MY MZ NA NE NG NI NL NO NP NR NZ OM PA PE PG PH PK PL PT PW PY QA RO RS RU RW SA SB SC SD SE SG SI SK SL SM SN SO SR ST SV SY SZ TD TG TH TJ TL TM TN TO TR TT TV TW TZ UA UG US UY UZ VA VC VE VN VU WS YE ZA ZM ZW'.split(' ');
    (function populateCountries() {
      const sel = document.getElementById('ship-country') as HTMLSelectElement | null;
      if (!sel) return;
      let names: any = null;
      try { names = new (Intl as any).DisplayNames(['en'], { type: 'region' }); } catch {}
      const opts = COUNTRY_CODES.map((c) => ({ c, n: (names && names.of(c)) || c })).sort((a, b) => a.n.localeCompare(b.n));
      for (const { c, n } of opts) {
        const o = document.createElement('option');
        o.value = c;
        o.textContent = n;
        sel.appendChild(o);
      }
      sel.addEventListener('change', () => renderShipOptions());
    })();

    function renderShipOptions() {
      const wrap = document.getElementById('ship-method-wrap');
      const sel = document.getElementById('ship-method') as HTMLSelectElement | null;
      if (!wrap || !sel) return;
      if (!shipOptions?.length) { wrap.classList.add('hidden'); sel.required = false; return; }
      const country = (document.getElementById('ship-country') as HTMLSelectElement)?.value || '';
      // Spec: `country` lists where an option is available — filter by the
      // buyer's country (options without a country tag count as everywhere).
      const avail = shipOptions.filter((o) => !o.countries.length || !country || o.countries.includes(country));
      const prev = sel.value;
      sel.innerHTML = '';
      const ph = document.createElement('option');
      ph.value = '';
      ph.textContent = avail.length ? 'Select shipping method *' : `${vendor} doesn’t ship to this country`;
      sel.appendChild(ph);
      avail.forEach((o) => {
        const opt = document.createElement('option');
        opt.value = o.coord;
        const extra = o.extraCost ? ` + ${o.extraCost} ${currency}` : '';
        opt.textContent = `${o.title} — ${o.amount} ${o.currency}${extra}`;
        sel.appendChild(opt);
      });
      if ([...sel.options].some((o) => o.value === prev)) sel.value = prev; // keep valid selection
      sel.required = true; // options exist for this product → a choice is mandatory
      sel.disabled = !avail.length && !!country;
      wrap.classList.remove('hidden');
    }
    const currentShipChoice = (): ShipOption | null => {
      const sel = document.getElementById('ship-method') as HTMLSelectElement | null;
      return shipOptions?.find((o) => o.coord === sel?.value) || null;
    };

    buyBtn?.addEventListener('click', () => {
      // Reset to step 1.
      viewShipping?.classList.remove('hidden');
      viewPayment?.classList.add('hidden');
      renderShipAuth(getSession());
      loadShippingOptions(); // async; the selector appears when options arrive
      openModal();
    });

    // Convert any (amount, currency) to sats; the BTC spot rate is fetched once
    // and cached so product + shipping conversions share it.
    let btcRates: any = null;
    async function toSats(amt: number, cur: string): Promise<number | null> {
      if (!isFinite(amt) || amt < 0) return null;
      cur = (cur || '').toUpperCase();
      if (cur === 'SAT' || cur === 'SATS' || cur === '') return Math.round(amt);
      if (cur === 'BTC') return Math.round(amt * 1e8);
      try {
        if (!btcRates) {
          const res = await fetch('https://api.coinbase.com/v2/exchange-rates?currency=BTC');
          btcRates = (await res.json())?.data?.rates || {};
        }
        const perBtc = parseFloat(btcRates[cur]);
        if (!isFinite(perBtc) || perBtc <= 0) return null;
        return Math.round((amt / perBtc) * 1e8);
      } catch {
        return null;
      }
    }

    async function requestInvoice(sats: number, comment: string): Promise<string> {
      const at = lud16.indexOf('@');
      if (at < 1) throw new Error('bad lud16');
      const name = lud16.slice(0, at);
      const domain = lud16.slice(at + 1);
      const meta = await (await fetch(`https://${domain}/.well-known/lnurlp/${name}`)).json();
      if (!meta || !meta.callback) throw new Error('no callback');
      let msats = sats * 1000;
      if (meta.minSendable) msats = Math.max(msats, meta.minSendable);
      if (meta.maxSendable) msats = Math.min(msats, meta.maxSendable);
      const sep = meta.callback.includes('?') ? '&' : '?';
      let url = `${meta.callback}${sep}amount=${msats}`;
      if (meta.commentAllowed && meta.commentAllowed > 0) {
        url += `&comment=${encodeURIComponent(comment.slice(0, meta.commentAllowed))}`;
      }
      const inv = await (await fetch(url)).json();
      if (!inv || !inv.pr) throw new Error('no invoice');
      return inv.pr as string;
    }

    const fmtSats = (n: number) => `${n.toLocaleString()} sats`;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() || '';

    function orderMessage(
      orderId: string,
      totals: { productSats: number; shippingSats: number; totalSats: number; ship: ShipOption | null },
      bolt11: string,
    ): string {
      const addr2 = val('ship-addr2');
      const note = val('ship-note');
      const session = getSession();
      // Tell the store owner how the order was placed, so they know how to reply.
      const placedBy = session
        ? `Buyer: ${session.name ? session.name + ' · ' : ''}Nostr ${session.pubkey.slice(0, 12)}… (you can reply to this DM on Nostr)`
        : `Buyer: GUEST checkout — this Nostr key is one-time, so please reply via the email above, not on Nostr.`;
      return [
        `🐷⚡ New Lightning Piggy order`,
        ``,
        `Product: ${title}`,
        `Price: ${amount} ${currency} (${fmtSats(totals.productSats)})`,
        ...(totals.ship
          ? [
              `Shipping: ${totals.ship.title} — ${totals.ship.amount} ${totals.ship.currency}${totals.ship.extraCost ? ` + ${totals.ship.extraCost} ${currency} product surcharge` : ''} (${fmtSats(totals.shippingSats)})`,
              `Shipping ref: ${totals.ship.coord}`,
              `Total: ${fmtSats(totals.totalSats)}`,
            ]
          : []),
        `Order ID: ${orderId}`,
        ``,
        `Ship to:`,
        val('ship-name'),
        val('ship-addr1'),
        ...(addr2 ? [addr2] : []),
        `${val('ship-city')}, ${val('ship-postcode')}`,
        (document.getElementById('ship-country') as HTMLSelectElement)?.selectedOptions[0]?.textContent || val('ship-country'),
        ``,
        `Contact: ${val('ship-email')}`,
        placedBy,
        ...(note ? [`Note: ${note}`] : []),
        ``,
        `Invoice: ${bolt11}`,
      ].join('\n');
    }

    // Step 1 → 2: build order, DM the vendor, fetch the invoice.
    shipForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const shipStatus = document.getElementById('ship-status')!;
      const submitBtn = document.getElementById('ship-submit') as HTMLButtonElement;
      // Shipping method is mandatory whenever the product has options.
      const shipSel = document.getElementById('ship-method') as HTMLSelectElement | null;
      let chosenShip: ShipOption | null = null;
      if (shipOptions?.length) {
        chosenShip = currentShipChoice();
        if (!chosenShip) {
          shipStatus.textContent = shipSel?.disabled
            ? `${vendor} doesn’t ship to the selected country.`
            : 'Please select a shipping method.';
          shipSel?.focus();
          return;
        }
      }

      submitBtn.disabled = true;
      shipStatus.textContent = 'Preparing your order…';

      const productSats = await toSats(amount, currency);
      let shippingSats: number | null = 0;
      if (chosenShip) {
        const base = await toSats(chosenShip.amount, chosenShip.currency);
        const extra = chosenShip.extraCost ? await toSats(chosenShip.extraCost, currency) : 0;
        shippingSats = base === null || extra === null ? null : base + extra;
      }
      if (!productSats || shippingSats === null) {
        shipStatus.textContent = 'Could not work out the price. Try the vendor store.';
        submitBtn.disabled = false;
        return;
      }
      const totalSats = productSats + (shippingSats || 0);

      const orderId = (crypto as any).randomUUID ? crypto.randomUUID() : String(Date.now());
      let bolt11: string;
      try {
        bolt11 = await requestInvoice(totalSats, `LP order ${orderId}`);
      } catch {
        shipStatus.textContent = 'Could not create an invoice. Try the vendor store.';
        submitBtn.disabled = false;
        return;
      }

      // Send the order + shipping address to the vendor as an encrypted DM.
      try {
        shipStatus.textContent = 'Sending your order to the vendor…';
        await sendGiftWrappedDM(
          vendorPubkey,
          orderMessage(orderId, { productSats, shippingSats: shippingSats || 0, totalSats, ship: chosenShip }, bolt11),
        );
      } catch (err: any) {
        submitBtn.disabled = false;
        console.error('[order] gift-wrap send failed:', err);
        if (err?.message === 'no-nip44') {
          shipStatus.textContent =
            'Your Nostr signer can’t send encrypted DMs (NIP-44). Try Alby, or use the vendor store.';
        } else if (err?.message === 'not-signed-in') {
          shipStatus.textContent = 'Please sign in and try again.';
          openLogin();
        } else {
          shipStatus.textContent = `Could not send your order privately (${err?.message || 'unknown error'}). Please try again.`;
        }
        return;
      }

      // Move to payment.
      viewShipping?.classList.add('hidden');
      viewPayment?.classList.remove('hidden');
      showInvoice(bolt11, { productSats, shippingSats: shippingSats || 0, totalSats, ship: chosenShip }, orderId);
      submitBtn.disabled = false;
    });

    function showError(msg?: string) {
      statusEl?.classList.add('hidden');
      bodyEl?.classList.add('hidden');
      if (errText && msg) errText.textContent = msg;
      errEl?.classList.remove('hidden');
    }

    function showInvoice(
      bolt11: string,
      totals: { productSats: number; shippingSats: number; totalSats: number; ship: ShipOption | null },
      orderId: string,
    ) {
      statusEl?.classList.add('hidden');
      errEl?.classList.add('hidden');
      bodyEl?.classList.remove('hidden');
      (document.getElementById('invoice-amount') as HTMLElement).textContent = fmtSats(totals.totalSats);
      const sym: Record<string, string> = { GBP: '£', USD: '$', EUR: '€' };
      const fiatEl = document.getElementById('invoice-fiat') as HTMLElement;
      // Itemise when shipping applies; otherwise show the fiat approximation.
      fiatEl.textContent = totals.ship
        ? `Product ${fmtSats(totals.productSats)} · Shipping (${totals.ship.title}) ${fmtSats(totals.shippingSats)}`
        : sym[currency] && amount
          ? `≈ ${sym[currency]}${amount}`
          : '';
      (document.getElementById('invoice-bolt11') as HTMLInputElement).value = bolt11;
      (document.getElementById('invoice-open') as HTMLAnchorElement).href = `lightning:${bolt11}`;

      // Render the invoice QR (qrcode is dynamically imported — only loads here).
      const qrImg = document.getElementById('invoice-qr') as HTMLImageElement | null;
      if (qrImg) {
        import('qrcode')
          .then(({ default: QRCode }) =>
            QRCode.toDataURL(bolt11.toUpperCase(), { margin: 1, width: 220, errorCorrectionLevel: 'M' }),
          )
          .then((url) => {
            qrImg.src = url;
            qrImg.classList.remove('hidden');
          })
          .catch(() => {});
      }

      // Use onclick ASSIGNMENT (not addEventListener): showInvoice can run more
      // than once per page (repeat checkout), and stacked listeners would fire
      // stale closures — paying an outdated invoice.
      const copyBtn = document.getElementById('invoice-copy') as HTMLButtonElement | null;
      if (copyBtn) {
        copyBtn.onclick = () => {
          navigator.clipboard?.writeText(bolt11);
          copyBtn.textContent = 'Copied!';
        };
      }

      const webln = (window as any).webln;
      const weblnBtn = document.getElementById('invoice-webln') as HTMLButtonElement | null;
      if (webln && weblnBtn) {
        weblnBtn.classList.remove('hidden');
        weblnBtn.disabled = false;
        weblnBtn.textContent = 'Pay with WebLN';
        weblnBtn.onclick = async () => {
          weblnBtn.disabled = true;
          weblnBtn.textContent = 'Paying…';
          try {
            await webln.enable();
            const res = await webln.sendPayment(bolt11);
            document.getElementById('invoice-paid')?.classList.remove('hidden');
            weblnBtn.textContent = 'Paid';
            // Send a payment receipt (with preimage) to the vendor — best effort.
            const preimage = (res && (res.preimage as string)) || '';
            sendGiftWrappedDM(
              vendorPubkey,
              `✅ Paid — Lightning Piggy order ${orderId}${preimage ? `\nPreimage: ${preimage}` : ''}`,
            ).catch(() => {});
          } catch {
            weblnBtn.disabled = false;
            weblnBtn.textContent = 'Pay with WebLN';
          }
        };
      }
    }
  }
</script>

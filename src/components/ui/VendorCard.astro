---
interface Vendor {
  name: string;
  url?: string;
  logo?: string;
  shopType?: string;
  country?: string;
  shippingRegions?: string[];
  description?: string;
  nostrUrl?: string;
  xUrl?: string;
  featured?: boolean;
}

interface Props {
  vendor: Vendor;
}

const { vendor } = Astro.props;

const shopMeta: Record<string, { label: string; icons: string[] }> = {
  online: { label: 'Online', icons: ['globe'] },
  physical: { label: 'Physical', icons: ['store'] },
  both: { label: 'Online & Physical', icons: ['globe', 'store'] },
};
const shop = shopMeta[vendor.shopType || 'online'] || shopMeta.online;

const isInternal = vendor.url?.startsWith('/');

// Featured vendors get a soft yellow "halo" (brand yellow #FFDB00) to stand out.
const stateClass = vendor.featured
  ? 'border-yellow shadow-[0_0_18px_2px_rgba(255,219,0,0.45)] hover:shadow-[0_0_24px_4px_rgba(255,219,0,0.6)]'
  : 'border-gray-200 hover:border-pink hover:shadow-lg';
---

<a
  href={vendor.url}
  {...(!isInternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class={`block p-6 bg-white rounded-xl border transition-all ${stateClass}`}
>
  <div class="flex items-start gap-4">
    <div class="w-14 h-14 bg-gray-100 rounded-lg flex-shrink-0 overflow-hidden flex items-center justify-center">
      {vendor.logo ? (
        <img
          src={vendor.logo}
          alt={vendor.name}
          class="w-full h-full object-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
      ) : null}
      <div
        class="w-full h-full bg-pink/10 flex items-center justify-center text-pink text-xl font-bold"
        style={vendor.logo ? 'display: none;' : ''}
      >
        {vendor.name.charAt(0).toUpperCase()}
      </div>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex justify-end mb-2">
        <span class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 whitespace-nowrap">
        <span class="inline-flex items-center gap-0.5">
          {shop.icons.includes('globe') && (
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3M3.6 9h16.8M3.6 15h16.8" />
            </svg>
          )}
          {shop.icons.includes('store') && (
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 9.75V20.25h15V9.75M2.25 9.75 4.5 4.5h15l2.25 5.25M2.25 9.75h19.5M2.25 9.75a2.625 2.625 0 0 0 5.25 0 2.625 2.625 0 0 0 5.25 0 2.625 2.625 0 0 0 5.25 0M9.75 20.25v-4.5a1.5 1.5 0 0 1 1.5-1.5h1.5a1.5 1.5 0 0 1 1.5 1.5v4.5" />
            </svg>
          )}
        </span>
        {shop.label}
        </span>
      </div>
      <h3 class="font-bold text-gray-900 break-words">{vendor.name}</h3>
      <p class="text-sm text-gray-500">
        {vendor.country}
        {vendor.shippingRegions && vendor.shippingRegions.length > 0 && (
          <span> · Ships to {vendor.shippingRegions.join(', ')}</span>
        )}
      </p>
      {vendor.description && (
        <p class="text-sm text-gray-600 mt-2">{vendor.description}</p>
      )}
      {(vendor.nostrUrl || vendor.xUrl) && (
        <div class="flex gap-3 mt-2">
          {vendor.nostrUrl && (
            <span
              class="text-gray-400 hover:text-purple-600 transition-colors cursor-pointer"
              onclick={`event.preventDefault(); event.stopPropagation(); window.open('${vendor.nostrUrl}', '_blank');`}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="40 38 185 180">
                <path d="M210.8 199.4c0 3.1-2.5 5.7-5.7 5.7h-68c-3.1 0-5.7-2.5-5.7-5.7v-15.5c.3-19 2.3-37.2 6.5-45.5 2.5-5 6.7-7.7 11.5-9.1 9.1-2.7 24.9-.9 31.7-1.2 0 0 20.4.8 20.4-10.7s-9.1-8.6-9.1-8.6c-10 .3-17.7-.4-22.6-2.4-8.3-3.3-8.6-9.2-8.6-11.2-.4-23.1-34.5-25.9-64.5-20.1-32.8 6.2.4 53.3.4 116.1v8.4c0 3.1-2.6 5.6-5.7 5.6H57.7c-3.1 0-5.7-2.5-5.7-5.7v-144c0-3.1 2.5-5.7 5.7-5.7h31.7c3.1 0 5.7 2.5 5.7 5.7 0 4.7 5.2 7.2 9 4.5 11.4-8.2 26-12.5 42.4-12.5 36.6 0 64.4 21.4 64.4 68.7v83.2ZM150 99.3c0-6.7-5.4-12.1-12.1-12.1s-12.1 5.4-12.1 12.1 5.4 12.1 12.1 12.1S150 106 150 99.3Z"/>
              </svg>
            </span>
          )}
          {vendor.xUrl && (
            <span
              class="text-gray-400 hover:text-gray-900 transition-colors cursor-pointer"
              onclick={`event.preventDefault(); event.stopPropagation(); window.open('${vendor.xUrl}', '_blank');`}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</a>

---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  pageType?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
}

const DEFAULT_OG_IMAGE = '/images/og-image.png';
const DEFAULT_OG_ALT = 'Lightning Piggy - Bitcoin savings for the next generation';

const {
  title,
  description = 'Lightning Piggy - An open source Bitcoin piggy bank for kids. Save in satoshis over the Lightning Network.',
  image = DEFAULT_OG_IMAGE,
  imageAlt,
  pageType = 'website',
  pubDate,
  updatedDate,
  tags,
  author = 'Lightning Piggy',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const absoluteImage = image.startsWith('http') ? image : new URL(image, Astro.site).href;
const isDefaultImage = image === DEFAULT_OG_IMAGE;
const ogImageAlt = imageAlt || (isDefaultImage ? DEFAULT_OG_ALT : title);

const siteTitle = title === 'Home' ? 'LightningPiggy' : `${title} | LightningPiggy`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#EC008C" />
    <meta name="apple-mobile-web-app-title" content="Lightning Piggy" />
    <!-- Standards-track name first; Chromium warns that the `apple-` prefixed one
         is deprecated. iOS Safari only honours the `apple-` variant, so keep both:
         one satisfies Chromium, the other keeps "Add to Home Screen" standalone
         mode working on iPhone. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:secure_url" content={absoluteImage} />
    {isDefaultImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
      </>
    )}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="LightningPiggy" />
    <meta property="og:locale" content="en_GB" />

    {pageType === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {pageType === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    {pageType === 'article' && (
      <meta property="article:author" content={author} />
    )}
    {pageType === 'article' && tags && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lightningpiggy" />
    <meta name="twitter:creator" content="@lightningpiggy" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Lightning Piggy",
      "url": "https://lightningpiggy.com",
      "logo": "https://lightningpiggy.com/images/mascot.png",
      "description": "An open source Bitcoin piggy bank for kids. Save in satoshis over the Lightning Network.",
      "sameAs": [
        "https://github.com/LightningPiggy"
      ]
    })} />

    <!-- Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="078dd909-9f20-4738-a479-d1d0c0226f94"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded focus:shadow-lg focus:text-pink">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!--
      Give every section heading a stable anchor id so deep links like
      /page/#some-heading work site-wide (covers both .astro pages and
      Markdown-rendered content). Skips headings that already have an id and
      dedupes against ids already on the page. Because the ids are assigned at
      runtime, we re-run the hash scroll once they exist.
    -->
    <script>
      function slugifyHeading(text) {
        return text.toLowerCase().trim()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/[\s_]+/g, '-')
          // Collapse runs of hyphens. A heading like "p1 - ZapBox!" has a
          // literal hyphen between two spaces, and without this each of those
          // becomes its own hyphen - giving #p1---zapbox instead of the
          // #p1-zapbox anyone would actually type or link to.
          .replace(/-{2,}/g, '-')
          .replace(/^-+|-+$/g, '');
      }

      function addHeadingAnchors() {
        const main = document.getElementById('main-content');
        if (!main) return;
        const used = new Set();
        document.querySelectorAll('[id]').forEach((el) => used.add(el.id));
        main.querySelectorAll('h2, h3, h4').forEach((h) => {
          if (h.id) { used.add(h.id); return; }
          const base = slugifyHeading(h.textContent || '');
          if (!base) return;
          let id = base;
          let n = 2;
          while (used.has(id)) id = base + '-' + n++;
          used.add(id);
          h.id = id;
        });
      }

      // Ids are assigned at runtime, after the browser's own initial hash-scroll
      // attempt. Re-run the scroll now and again on full load, once images have
      // settled the layout (a scroll fired mid-load can otherwise land short).
      function scrollToHash() {
        if (location.hash.length <= 1) return;
        const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        // Jump straight there rather than animating: the page sets
        // scroll-behavior:smooth for in-page links, but an animated scroll
        // fired during load competes with images settling the layout and can
        // land short or be cancelled outright. On arrival you want to be at
        // the heading, not watch it scroll past.
        if (target) target.scrollIntoView({ behavior: 'instant', block: 'start' });
      }

      addHeadingAnchors();
      scrollToHash();
      window.addEventListener('load', scrollToHash);
    </script>
  </body>
</html>

---
// Localised homepage: /nl/, /de/, /es/, /pt/, /ko/.
//
// English lives at `/` (src/pages/index.astro) because the site is configured
// with prefixDefaultLocale:false. This route renders exactly the same
// components — they read the locale from the URL via getLangFromUrl, so there
// is no duplicated copy here, only the extra routes.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/landing/Hero.astro';
import Problem from '../../components/landing/Problem.astro';
import Features from '../../components/landing/Features.astro';
import HowItWorks from '../../components/landing/HowItWorks.astro';
import Community from '../../components/landing/Community.astro';
import Testimonials from '../../components/landing/Testimonials.astro';
import SavingsCalculator from '../../components/landing/SavingsCalculator.astro';
import FriendsFamily from '../../components/landing/FriendsFamily.astro';
import CTA from '../../components/landing/CTA.astro';
import { PREFIXED_LOCALES } from '../../i18n/config';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((lang) => ({ params: { lang } }));
}
---

<BaseLayout title="Home">
  <Hero />
  <Problem />
  <Features />
  <HowItWorks />
  <SavingsCalculator />
  <Testimonials />
  <FriendsFamily />
  <Community />
  <CTA />
</BaseLayout>

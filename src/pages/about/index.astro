---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import BtcPurchasingPower from '../../components/ui/BtcPurchasingPower.astro';
---

<BaseLayout title="About" description="The story behind Lightning Piggy - an open source Bitcoin piggy bank teaching the next generation about sound money.">
  <article>

    <!-- Hero -->
    <div class="relative overflow-hidden bg-gradient-to-b from-gray-900 to-gray-800 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 flex flex-col md:flex-row items-center gap-10">
        <div class="flex-1 text-center md:text-left">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">{t('about.title')}</h1>
          <p class="text-xl text-gray-300 leading-relaxed">
            {t('about.lede')}
          </p>
        </div>
        <div class="flex-shrink-0">
          <img
            src="/images/characters/lightningpiggy-sunglasses.png"
            alt="LightningPiggy mascot"
            class="w-48 md:w-64 drop-shadow-2xl rounded-2xl"
          />
        </div>
      </div>
    </div>

    <!-- Why we exist -->
    <section class="py-10 md:py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">{t('about.why.h')}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
          <p>{t('about.why.p1')}</p>
          <BtcPurchasingPower />
          <p>{t('about.why.p2')}</p>
          <p>{t('about.why.p3')}</p>
        </div>
      </div>
    </section>

    <!-- What it does -->
    <section class="py-10 md:py-16 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">{t('about.does.h')}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
          <p>{t('about.does.p1')}</p>
          <p>{t('about.does.p2')}</p>
          <p>{t('about.does.p3')}</p>
        </div>
      </div>
    </section>

    <!-- How kids earn and save -->
    <section class="py-10 md:py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">{t('about.earn.h')}</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">{t('about.earn.lede')}</p>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="p-6 bg-gray-50 rounded-2xl">
            <h3 class="font-bold text-gray-900 mb-2">{t('about.earn.qr.h')}</h3>
            <p class="text-gray-600">{t('about.earn.qr.p')}</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-2xl">
            <h3 class="font-bold text-gray-900 mb-2">{t('about.earn.print.h')}</h3>
            <p class="text-gray-600">{t('about.earn.print.p')}</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-2xl">
            <h3 class="font-bold text-gray-900 mb-2">{t('about.earn.pocket.h')}</h3>
            <p class="text-gray-600">{t('about.earn.pocket.p')}</p>
          </div>
          <div class="p-6 bg-gray-50 rounded-2xl">
            <h3 class="font-bold text-gray-900 mb-2">{t('about.earn.swap.h')}</h3>
            <p class="text-gray-600">{t('about.earn.swap.p')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Learning by building -->
    <section class="py-10 md:py-16 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">{t('about.learn.h')}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
          <p>{t('about.learn.p1')}</p>
          <p>{t('about.learn.p2')}</p>
        </div>
      </div>
    </section>

    <!-- Mission & Values -->
    <section class="py-10 md:py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">{t('about.mission.h')}</h2>
          <p class="text-2xl text-pink font-bold">{t('about.mission.lede')}</p>
          <p class="text-lg text-gray-600 leading-relaxed mt-6 max-w-2xl mx-auto">{t('about.mission.p')}</p>
        </div>

        <div class="grid sm:grid-cols-2 gap-8">
          <div class="p-8 border border-gray-200 rounded-2xl">
            <h3 class="text-xl font-bold text-gray-900 mb-3">{t('about.mission.btc.h')}</h3>
            <p class="text-gray-600">{t('about.mission.btc.p')}</p>
          </div>
          <div class="p-8 border border-gray-200 rounded-2xl">
            <h3 class="text-xl font-bold text-gray-900 mb-3">{t('about.mission.os.h')}</h3>
            <p class="text-gray-600">{t('about.mission.os.p')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Road ahead -->
    <section class="py-10 md:py-16 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">{t('about.road.h')}</h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">{t('about.road.lede')}</p>
        <ul class="space-y-4 text-lg text-gray-600">
          <li class="flex items-start gap-3">
            <span class="text-pink font-bold mt-1">&rarr;</span>
            <span>Integrated cold storage wallet link enabling both spending and saving account balances.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-pink font-bold mt-1">&rarr;</span>
            <span>Custom open source PCB hat for additional maker capabilities.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-pink font-bold mt-1">&rarr;</span>
            <span>Workshop kit collaboration with the Plan B Network team.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-pink font-bold mt-1">&rarr;</span>
            <span>Simplified onboarding: enabling manufacturers to pre-flash devices for plug-and-play field configuration.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-pink font-bold mt-1">&rarr;</span>
            <span>Global distribution strategy to reach families everywhere.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-pink font-bold mt-1">&rarr;</span>
            <span>Partnerships with community hubs to onboard more households to Bitcoin.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Community -->
    <section class="py-10 md:py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">{t('about.comm.h')}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
          <p>{t('about.comm.p')}</p>
          <p>Want to get involved? Join us on <a href="https://t.me/LightningPiggy" class="text-pink hover:underline font-semibold">Telegram</a>, contribute on <a href="https://github.com/LightningPiggy" class="text-pink hover:underline font-semibold">GitHub</a>, or check out the <a href="/community" class="text-pink hover:underline font-semibold">community page</a>.</p>
        </div>
      </div>
    </section>

    <!-- The Lightning Piggy project -->
    <section class="py-10 md:py-16 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">{t('about.project.h')}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
          <p>{t('about.project.p1')}</p>
          <p>{t('about.project.p2')}</p>
          <p>Meet the team on the <a href="/community/credits" class="text-pink hover:underline font-semibold">credits page</a>, or get involved by joining the <a href="/community" class="text-pink hover:underline font-semibold">community</a>.</p>
        </div>
      </div>
    </section>

    <!-- Origin Story teaser -->
    <section class="py-10 md:py-16 bg-gradient-to-b from-gray-900 to-gray-800 text-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-pink text-sm font-semibold uppercase tracking-widest mb-4">{t('about.origin.once')}</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{t('about.origin.h')}</h2>
        <p class="text-gray-400 text-lg italic mb-8">{t('about.origin.p')}</p>
        <a
          href="/about/origin-story"
          class="inline-flex items-center px-6 py-3 text-white bg-pink rounded-full font-semibold hover:bg-white hover:text-gray-900 transition-colors"
        >
          Read the story
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-10 md:py-16 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">{t('about.cta.h')}</h2>
        <p class="text-gray-600 mb-8 text-lg">{t('about.cta.p')}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/build" variant="primary">
            Build Your Own
          </Button>
          <Button href="/market" variant="outline">
            Buy Ready-Made
          </Button>
        </div>
      </div>
    </section>

  </article>
</BaseLayout>

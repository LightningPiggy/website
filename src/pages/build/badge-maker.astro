---
// The ZapStand Badge Maker: a name or logo badge for the ZapStand's swappable badge slot, seen on
// the stand in 3D and downloaded ready to print. The tool is a self-contained app made in its own
// project (public/build/badge-maker/app/COPY.md says how); this page shows it in a frame under
// the site's header, so it keeps its own layout and nothing it styles can clash with the site's.
// ?stand=kitty is passed on to the app, which opens that stand (the Cases page links here so).
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ZapStand Badge Maker"
  description="Design a name or logo badge for the Lightning Piggy ZapStand, see it on all eight stands in 3D, and download it ready to print."
>
  <section class="border-b border-gray-100 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">ZapStand Badge Maker</h1>
        <p class="text-gray-600 mt-1">
          A name, a logo or both on a badge for the
          <a href="/build/cases/#p1-zapstand" class="text-pink hover:underline">ZapStand</a>'s swappable badge slot,
          seen on the stand and ready to print.
        </p>
      </div>
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-green-50 border border-green-200 rounded-xl text-green-700 font-medium text-sm">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        Everything runs in your browser - your logo is never uploaded.
      </div>
    </div>
  </section>

  <!-- the app fills the window under the site's sticky 4rem header -->
  <iframe
    id="badge-maker"
    src="/build/badge-maker/app/"
    title="ZapStand Badge Maker"
    class="block w-full border-0 bg-white"
    style="height: calc(100dvh - 4rem); min-height: 640px;"
  ></iframe>
</BaseLayout>

<script>
  const stand = new URLSearchParams(location.search).get('stand');
  const frame = document.getElementById('badge-maker') as HTMLIFrameElement | null;
  if (stand && /^[a-z0-9-]{1,32}$/.test(stand) && frame) frame.src = `/build/badge-maker/app/?stand=${stand}`;
</script>

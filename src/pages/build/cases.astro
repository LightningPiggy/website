    creator: { name: 'Silexperience', url: 'https://njump.me/npub1zn99rseq50npesxs0zh0m396h9anz9h8u7ju5vc44c3n5m7ptuws8k7lrh' },
    licence: { name: 'CC0', url: 'https://creativecommons.org/publicdomain/zero/1.0/' },

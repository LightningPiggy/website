// Filter facets. Software is derived from the OS spec; Board and Form come
// straight off the cards. Option order is fixed here so the UI is stable.
const orderBy = (order) => (a, b) => order.indexOf(a) - order.indexOf(b);
// A model only gets its own filter when more than one case carries the name;
// one-offs are grouped under "Other" so the row does not sprawl. Computed from
// the cards, so a second ZapStand would promote it to its own button.
const nameCounts = cases.reduce((m, c) => m.set(c.name, (m.get(c.name) || 0) + 1), new Map());
const modelGroup = (c) => (nameCounts.get(c.name) > 1 ? c.name : 'Other');
// Generation is derived from the board: Classic = T5 e-paper, P1 = S3 2 inch,
// P2 = S3 3.5 inch. It prefixes each title and is the top filter row.
const GENERATION = { 'ESP32-T5 2.13 inch': 'Classic', 'ESP32-S3 2 inch': 'P1', 'ESP32-S3 3.5 inch': 'P2' };
const generationOf = (c) => GENERATION[c.tag] || 'Other';
const titleOf = (c) => `${generationOf(c)} ${c.name}`;
// Headings used to get their anchor from the title text at runtime. Adding the
// generation prefix would change those slugs, so cards without a pinned anchor
// keep the slug of their plain name (e.g. #robotechy keeps working).
const slugOf = (t) => t.toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/[\s_]+/g, '-').replace(/-{2,}/g, '-').replace(/^-+|-+$/g, '');
const facets = [
  { key: 'generation', label: 'Generation', options: [...new Set(cases.map(generationOf))].sort(orderBy(['P2', 'P1', 'Classic'])), accent: ['P1', 'P2'] },
  { key: 'board', label: 'Board', options: [...new Set(cases.map((c) => c.tag))].sort(orderBy(['ESP32-S3 3.5 inch', 'ESP32-S3 2 inch', 'ESP32-T5 2.13 inch'])), accent: ['ESP32-S3 2 inch', 'ESP32-S3 3.5 inch'] },
  { key: 'model', label: 'Model', options: [...new Set(cases.map(modelGroup))].sort((a, b) => (a === 'Other') - (b === 'Other')), accent: [] },
];

// Global image counter for unique lightbox IDs
let imgCounter = 0;
---

<BaseLayout
  title="Cases & Enclosures"
  description="Community-designed cases and enclosures for your Lightning Piggy. 3D-printable, laser-cut, and cardboard designs from the community."
  image="/images/cases/genesispiggy-01.png"
  imageAlt="Genesis Piggy 3D-printed case for Lightning Piggy"
>
  <section class="py-8 md:py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Cases & Enclosures</h1>
        <p class="text-lg text-gray-600">
          Browse community-designed cases or create your own. 3D printable STL files,
          laser-cut templates, and DIY inspiration included.
        </p>
      </header>

      <div class="mb-8 space-y-3" id="case-facets">
        {facets.map((f) => (
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label={`Filter by ${f.label.toLowerCase()}`} data-group={f.key}>
            <span class="w-20 shrink-0 text-xs font-semibold uppercase tracking-wide text-gray-400">{f.label}</span>
            <button type="button" data-value="all" aria-pressed="true"
              class="case-filter px-3 py-1.5 text-sm font-medium rounded-full bg-gray-900 text-white transition-colors">
              All <span class="count text-xs opacity-70"></span>
            </button>
            {f.options.map((opt) => (
              <button type="button" data-value={opt} aria-pressed="false" data-active={f.accent.includes(opt) ? 'bg-yellow text-gray-900' : undefined}
                class="case-filter px-3 py-1.5 text-sm font-medium rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors">
                {opt} <span class="count text-xs opacity-70"></span>
              </button>
            ))}
          </div>
        ))}
        <p class="text-sm text-gray-500 pl-[5.5rem]">
          <span id="case-facet-summary">Showing all {cases.length} cases</span>
          <button type="button" id="case-facet-clear" class="ml-2 text-pink hover:underline hidden">Clear filters</button>
        </p>
      </div>

      <div class="space-y-10">
        {cases.map((c) => {
          const startIdx = imgCounter;
          imgCounter += c.images.length;
          return (
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow" data-generation={generationOf(c)} data-board={c.tag} data-model={modelGroup(c)}>
              {/* Image gallery (omitted until the card has images) */}
              {c.images.length > 0 && <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-1 bg-gray-100 p-1">
                {c.images.map((src, i) => {
                  const id = startIdx + i;
                  return (
                    <div class="relative aspect-square overflow-hidden rounded-lg">
                      <input type="checkbox" id={`case-lb-${id}`} class="lightbox-toggle hidden" />
                      <label for={`case-lb-${id}`} class="cursor-pointer block w-full h-full">
                        <img
                          src={src}
                          alt={`${titleOf(c)} - image ${i + 1}`}
                          class="w-full h-full object-cover hover:opacity-90 transition-opacity"
                          loading="lazy"
                        />
                      </label>
                      <label for={`case-lb-${id}`} class="lightbox-overlay">
                        <img
                          src={src}
                          alt={`${titleOf(c)} - image ${i + 1}`}
                          class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl"
                        />
                      </label>
                    </div>
                  );
                })}
              </div>}

              {/* Content */}
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <h2 id={c.anchor || slugOf(c.name)} class="text-xl font-bold text-gray-900">{titleOf(c)}</h2>
                  <span class={`px-2 py-0.5 text-xs font-medium rounded-full ${c.specs.os === 'MicroPythonOS' ? 'bg-yellow text-gray-900' : 'bg-gray-100 text-gray-600'}`}>
                    {c.tag}
                  </span>
                </div>

                <p class="text-gray-600 mb-4">{c.description}</p>

                {/* Specs */}
                <div class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm mb-4">
                  <div><span class="font-medium text-gray-900">Board:</span> <span class="text-gray-600">{c.specs.board}</span></div>
                  <div><span class="font-medium text-gray-900">Display size:</span> <span class="text-gray-600">{c.specs.displaySize}</span></div>
                  <div><span class="font-medium text-gray-900">Operating System:</span> <span class={c.specs.os === 'Embedded' ? 'text-gray-400 italic' : 'text-gray-600'}>{c.specs.os}</span></div>
                  <div><span class="font-medium text-gray-900">Material:</span> <span class="text-gray-600">{c.specs.material}</span></div>
                  {c.specs.printing && (
                    <div class="col-span-2"><span class="font-medium text-gray-900">Printing advice:</span> <span class="text-gray-600">{c.specs.printing}</span></div>
                  )}
                  {c.specs.paint && (
                    <div class="col-span-2"><span class="font-medium text-gray-900">Paint:</span> <span class="text-gray-600">{c.specs.paint}</span></div>
                  )}
                  {c.specs.software && (
                    <div><span class="font-medium text-gray-900">Software:</span> <span class="text-gray-600">{c.specs.software}</span></div>
                  )}
                  {c.specs.notes && (
                    <div class="col-span-2"><span class="font-medium text-gray-900">Notes:</span> <span class="text-gray-600">{c.specs.notes}</span></div>
                  )}
                  {c.specs.extraHardware && Array.isArray(c.specs.extraHardware) && (
                    <div class="col-span-2">
                      <span class="font-medium text-gray-900">Extra Hardware:</span>
                      <ul class="mt-1 space-y-1">
                        {c.specs.extraHardware.map((hw) => (
                          <li class="text-gray-600">
                            {hw.label}
                            {hw.links ? hw.links.map((link, i) => (
                              <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-pink hover:underline ml-1">({link.source}{hw.links.length > 1 ? ` ${i + 1}` : ''})</a>
                            )) : hw.url && (
                              <a href={hw.url} target="_blank" rel="noopener noreferrer" class="text-pink hover:underline ml-1">({hw.source})</a>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>

                {/* Creator & licence */}
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 mb-4">
                  <span>
                    Creator: {c.creator.url
                      ? <a href={c.creator.url} target="_blank" rel="noopener noreferrer" class="text-pink hover:underline">{c.creator.name}</a>
                      : c.creator.name
                    }
                  </span>
                  {c.licence && (
                    <span>
                      Licence: <a href={c.licence.url} target="_blank" rel="noopener noreferrer" class="text-pink hover:underline">{c.licence.name}</a>
                    </span>
                  )}
                </div>

                {/* Download links */}
                <div class="flex flex-wrap gap-2">
                  {downloadGroups(c.downloads).map((g, _i, groups) => g.kind === 'paid' ? (
                    <button
                      type="button"
                      data-dl-file={g.file}
                      data-dl-formats={[...new Set(g.formats.map(fmtOf))].join(',')}
                      data-dl-min={minSupportFor(g.formats)}
                      data-dl-name={titleOf(c)}
                      data-dl-creator={c.creator.name}
                      class="dl-support inline-flex items-center gap-1.5 px-3 py-1.5 bg-pink text-white hover:bg-gray-900 text-sm font-medium rounded-lg transition-colors"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                      </svg>
                      Support &amp; download
                      <span class="ml-0.5 px-1.5 py-0.5 rounded bg-white/20 text-xs font-semibold uppercase">{groups.filter((x) => x.kind === 'paid').length > 1 && !/\b(model)\b/i.test(g.label) ? `${g.label.replace(/^Download /, '').replace(/ File$/, '')} · ` : ''}{[...new Set(g.formats.map(fmtOf))].join(' + ')}</span>
                    </button>
                  ) : (
                    <a
                      href={g.d.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-colors"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      {g.d.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {/* CTA */}
      <div class="mt-16 max-w-3xl text-center mx-auto">
        <hr class="mb-12 border-gray-200" />
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Share Your Design</h2>
        <p class="text-gray-600">
          Created a unique case? We'd love to feature it! Email your creation to
          <a href="mailto:oink@lightningpiggy.com" class="text-pink underline">oink@lightningpiggy.com</a>
          including the creator's name, piggy name, model files, printing advice, and your Creative Commons licence.
          Bonus zaps if you include a scannable payment QR in the image.
        </p>
      </div>
    </div>
  </section>
<!-- Buy-to-support download modal -->
<div id="dl-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6" role="dialog" aria-modal="true" aria-labelledby="dl-title">
    <h3 id="dl-title" class="text-xl font-bold text-gray-900 mb-1">Support the project</h3>
    <p id="dl-sub" class="text-sm text-gray-500 mb-4"></p>
    <p class="text-gray-600 text-sm mb-4">
      The model files are <strong>CC BY-SA 4.0</strong> - free to share and remix. Paying isn't a licence, it's a
      thank-you that supports the Lightning Piggy project and unlocks the download here.
    </p>
    <div class="flex flex-wrap gap-2 mb-3" id="dl-amounts">
      <button type="button" data-amount="3" class="dl-amt px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">$3</button>
      <button type="button" data-amount="5" class="dl-amt px-4 py-2 rounded-full text-sm font-medium bg-gray-900 text-white">$5</button>
      <button type="button" data-amount="10" class="dl-amt px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">$10</button>
      <button type="button" data-amount="21" class="dl-amt px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200">$21</button>
      <label class="inline-flex items-center gap-1 text-sm text-gray-600">$<input id="dl-custom" type="number" min="3" max="500" step="1" placeholder="other" class="w-20 px-2 py-1.5 border border-gray-200 rounded-lg" /></label>
    </div>
    <label class="block mb-3">
      <span class="text-sm text-gray-600">Email for a receipt with your download link <span class="text-gray-400">(optional)</span></span>
      <input id="dl-email" type="email" autocomplete="email" placeholder="you@example.com" class="mt-1 w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
    </label>
    <p id="dl-formats-note" class="text-xs text-gray-500 mb-1 hidden"></p>
    <p id="dl-min-note" class="text-xs text-gray-500 mb-3"></p>
    <p id="dl-error" class="text-sm text-red-600 mb-3 hidden"></p>
    <div class="flex gap-3 justify-end">
      <button type="button" id="dl-cancel" class="px-4 py-2 rounded-full text-sm font-medium text-gray-600 hover:bg-gray-100">Cancel</button>
      <button type="button" id="dl-pay" class="px-5 py-2 rounded-full text-sm font-semibold bg-pink text-white hover:bg-gray-900">Pay with Bitcoin</button>
    </div>
  </div>
</div>

<!-- After checkout: BTCPay redirects back here with ?dl=<file>&invoice=<id> -->
<div id="dl-status" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-40 w-max max-w-[calc(100vw-2rem)] bg-gray-900 text-white text-sm text-center rounded-2xl px-5 py-3 shadow-xl flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
  <span id="dl-status-text"></span>
  <span id="dl-status-links" class="hidden flex flex-wrap items-center justify-center gap-x-3 gap-y-1"></span>
</div>

<script>
  // --- Buy-to-support downloads ---
  {
    const modal = document.getElementById('dl-modal');
    const sub = document.getElementById('dl-sub');
    const errEl = document.getElementById('dl-error');
    const custom = document.getElementById('dl-custom') as HTMLInputElement;
    const payBtn = document.getElementById('dl-pay') as HTMLButtonElement;
    const minNote = document.getElementById('dl-min-note');
    let file = '';
    let amount = 5;
    let minimum = 3;

    const setAmount = (a: number) => {
      amount = a;
      document.querySelectorAll('#dl-amounts .dl-amt').forEach((b) => {
        const on = Number((b as HTMLElement).dataset.amount) === a;
        b.classList.toggle('bg-gray-900', on); b.classList.toggle('text-white', on);
        b.classList.toggle('bg-gray-100', !on); b.classList.toggle('text-gray-700', !on);
      });
    };
    // Preset amounts under this case's minimum are hidden, not just disabled.
    const applyMinimum = (m: number) => {
      minimum = m;
      custom.min = String(m);
      custom.placeholder = `${m} or more`;
      document.querySelectorAll('#dl-amounts .dl-amt').forEach((b) => {
        (b as HTMLElement).classList.toggle('hidden', Number((b as HTMLElement).dataset.amount) < m);
      });
      if (minNote) minNote.textContent = `Minimum $${m}. Choose more if you would like to.`;
    };
    document.querySelectorAll('#dl-amounts .dl-amt').forEach((b) =>
      b.addEventListener('click', () => { custom.value = ''; setAmount(Number((b as HTMLElement).dataset.amount)); }));
    custom.addEventListener('input', () => { const v = Number(custom.value); if (v > 0) setAmount(v); });

    document.querySelectorAll('.dl-support').forEach((btn) => btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      file = el.dataset.dlFile || '';
      sub.textContent = `${el.dataset.dlName} - designed by ${el.dataset.dlCreator} - ${file}`;
      const formats = (el.dataset.dlFormats || '').split(',').filter(Boolean).map((f) => f.toUpperCase());
      const fNote = document.getElementById('dl-formats-note');
      if (fNote) {
        fNote.textContent = `One payment unlocks every format: ${formats.join(', ')}.`;
        fNote.classList.toggle('hidden', formats.length < 2);
      }
      errEl.classList.add('hidden');
      custom.value = '';
      applyMinimum(Number(el.dataset.dlMin) || 3);
      setAmount(Math.max(5, minimum));
      modal.classList.remove('hidden'); modal.classList.add('flex');
    }));
    const close = () => { modal.classList.add('hidden'); modal.classList.remove('flex'); };
    document.getElementById('dl-cancel')?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });

    const emailEl = document.getElementById('dl-email') as HTMLInputElement;
    payBtn.addEventListener('click', async () => {
      if (amount < minimum) {
        errEl.textContent = `The minimum for this model is $${minimum}.`; errEl.classList.remove('hidden'); return;
      }
      const email = emailEl.value.trim();
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errEl.textContent = 'That email address does not look right.'; errEl.classList.remove('hidden'); return;
      }
      payBtn.disabled = true; payBtn.textContent = 'Creating invoice...';
      try {
        // Remembered for the thank-you message when BTCPay sends us back.
        try { sessionStorage.setItem('dl-email', email); } catch {}
        const r = await fetch('/.netlify/functions/create-download-invoice', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ file, amount, email: email || undefined }),
        });
        const d = await r.json();
        if (!r.ok || !d.checkoutLink) throw new Error(d.error || 'Could not create invoice');
        window.location.href = d.checkoutLink;   // BTCPay checkout; it redirects back with ?dl&invoice
      } catch (e) {
        errEl.textContent = (e as Error).message; errEl.classList.remove('hidden');
        payBtn.disabled = false; payBtn.textContent = 'Pay with Bitcoin';
      }
    });

    // Returning from checkout: poll until settled, then hand over the file.
    const params = new URLSearchParams(location.search);
    const dl = params.get('dl'), inv = params.get('invoice');
    if (dl && inv && /^[a-z0-9][a-z0-9._-]{0,80}\.(3mf|stl|step|stp)$/i.test(dl)) {
      const bar = document.getElementById('dl-status');
      const txt = document.getElementById('dl-status-text');
      const links = document.getElementById('dl-status-links');
      const url = `/.netlify/functions/download?invoice=${encodeURIComponent(inv)}&file=${encodeURIComponent(dl)}`;
      bar.classList.remove('hidden');
      let tries = 0;
      const poll = async () => {
        tries++;
        let status = 'unknown';
        let formats: string[] = [];
        try {
          const r = await (await fetch(url + '&check=1')).json();
          status = r.status || 'unknown';
          formats = Array.isArray(r.formats) ? r.formats : [];
        } catch {}
        if (status === 'settled') {
          let email = ''; try { email = sessionStorage.getItem('dl-email') || ''; sessionStorage.removeItem('dl-email'); } catch {}
          txt.textContent = email
            ? `Thank you! Your download of ${dl} is ready, and a receipt with the link is on its way to ${email}.`
            : `Thank you! Your download of ${dl} is ready.`;
          // One payment covers every format: offer each one, and start the one they chose.
          const all = formats.length ? formats : [dl];
          links.replaceChildren(...all.map((f) => {
            const a = document.createElement('a');
            a.href = `/.netlify/functions/download?invoice=${encodeURIComponent(inv)}&file=${encodeURIComponent(f)}`;
            a.className = 'underline font-semibold whitespace-nowrap';
            const ext = (f.split('.').pop() || '').toUpperCase().replace(/^STP$/, 'STEP');
            a.textContent = all.length > 1 ? `Download ${ext}` : 'Download';
            return a;
          }));
          links.classList.remove('hidden');
          window.location.assign(url);           // starts the chosen format; the page stays
          return;
        }
        if (status === 'processing') txt.textContent = 'Payment seen - waiting for confirmation...';
        else if (status === 'unpaid') txt.textContent = 'Waiting for your payment...';
        else if (status === 'mismatch' || status === 'unknown') { txt.textContent = 'We could not match that payment to this model.'; return; }
        else { txt.textContent = `Invoice ${status}. Please try again.`; return; }
        if (tries < 200) setTimeout(poll, 4000);
      };
      poll();
      history.replaceState(null, '', location.pathname + (location.hash || ''));
    }
  }
</script>

<script>
  // Faceted filtering: three independent groups (generation, board, model) combine
  // with AND. Each option shows how many cases it would leave given the other
  // two groups' selections, and greys out at zero instead of dead-ending.
  const groups = document.querySelectorAll('#case-facets [data-group]');
  const cards = [...document.querySelectorAll('[data-board]')];
  const summary = document.getElementById('case-facet-summary');
  const clearBtn = document.getElementById('case-facet-clear');
  const state = { generation: 'all', board: 'all', model: 'all' };
  const INACTIVE = ['bg-gray-100', 'text-gray-600', 'hover:bg-gray-200'];
  const activeFor = (b) => (b.dataset.active || 'bg-gray-900 text-white').split(' ');

  const matches = (card, sel) =>
    Object.entries(sel).every(([k, v]) => v === 'all' || card.dataset[k] === v);

  function render() {
    let shown = 0;
    cards.forEach((card) => {
      const ok = matches(card, state);
      card.classList.toggle('hidden', !ok);
      if (ok) shown++;
    });

    groups.forEach((g) => {
      const key = g.dataset.group;
      g.querySelectorAll('.case-filter').forEach((b) => {
        const v = b.dataset.value;
        // count under the OTHER groups' selections, with this group set to v
        const n = cards.filter((c) => matches(c, { ...state, [key]: v })).length;
        b.querySelector('.count').textContent = `(${n})`;
        const on = state[key] === v;
        b.setAttribute('aria-pressed', String(on));
        b.classList.remove(...(on ? INACTIVE : activeFor(b)));
        b.classList.add(...(on ? activeFor(b) : INACTIVE));
        const dead = n === 0 && !on;
        b.disabled = dead;
        b.classList.toggle('opacity-40', dead);
        b.classList.toggle('cursor-not-allowed', dead);
      });
    });

    const filtered = Object.values(state).some((v) => v !== 'all');
    summary.textContent = filtered
      ? `Showing ${shown} of ${cards.length} cases`
      : `Showing all ${cards.length} cases`;
    clearBtn.classList.toggle('hidden', !filtered);
  }

  groups.forEach((g) => {
    g.addEventListener('click', (e) => {
      const b = e.target.closest('.case-filter');
      if (!b || b.disabled) return;
      state[g.dataset.group] = b.dataset.value;
      render();
    });
  });
  clearBtn?.addEventListener('click', () => {
    Object.keys(state).forEach((k) => (state[k] = 'all'));
    render();
  });
  render();
</script>


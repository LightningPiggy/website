---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pricing from '../../../netlify/functions/lib/download-pricing.json';
import fs from 'node:fs';
import path from 'node:path';
// Paid downloads are grouped by model: the file name without its format
// extension. One payment unlocks every format of a model, so each model gets
// one button. A model's formats come from the private folder the download
// function serves from (the same source the server uses), so dropping an
// .stl or .step next to a model's .3mf is enough to offer it. Card links give
// the button's label and which file it asks for.
const PRIVATE_DIR = path.join(process.cwd(), 'netlify', 'private', 'downloads', 'cases');
const FORMAT_ORDER = ['3mf', 'stl', 'step', 'stp'];
const bundled: string[] = fs.readdirSync(PRIVATE_DIR).filter((f) => /^[a-z0-9][a-z0-9._-]{0,80}\.(3mf|stl|step|stp)$/i.test(f));
const stemOf = (f: string) => f.replace(/\.(3mf|stl|step|stp)$/i, '');
const extOf = (f: string) => (f.split('.').pop() || '').toLowerCase();
const fmtOf = (f: string) => extOf(f).replace(/^stp$/, 'step');
const formatsOfModel = (file: string) =>
  bundled.filter((f) => stemOf(f) === stemOf(file)).sort((a, b) => FORMAT_ORDER.indexOf(extOf(a)) - FORMAT_ORDER.indexOf(extOf(b)));
// Mirrors minimumFor in netlify/functions/lib/downloads.js: an override keyed
// by the model name or any of its files sets the model's price; highest wins.
const minSupportFor = (files: string[]) => {
  const mins = pricing.minimums as Record<string, number>;
  const overrides = [stemOf(files[0]), ...files].map((k) => Number(mins[k])).filter((n) => n > 0);
  return overrides.length ? Math.max(...overrides) : Number(pricing.default);
};
type Dl = { label: string; url: string; source?: string };
const PAID = '/downloads/cases/';
// A card's downloads in display order: one entry per paid model, external
// links unchanged. Fails the build if a card links a file that isn't bundled,
// since that button could never be paid for.
const downloadGroups = (downloads: Dl[]) => {
  const out: Array<{ kind: 'paid'; label: string; file: string; formats: string[] } | { kind: 'link'; d: Dl }> = [];
  const seen = new Set<string>();
  for (const d of downloads) {
    if (!d.url.startsWith(PAID)) { out.push({ kind: 'link', d }); continue; }
    const file = d.url.split('/').pop() || '';
    if (!bundled.includes(file)) throw new Error(`cases.astro: download ${d.url} has no file in netlify/private/downloads/cases`);
    if (seen.has(stemOf(file))) continue;
    seen.add(stemOf(file));
    out.push({ kind: 'paid', label: d.label, file, formats: formatsOfModel(file) });
  }
  return out;
};


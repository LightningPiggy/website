---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';

// The zap page. Fully client-side (no backend): the wall of zappers is read
// straight from the public relays (kind-9735 zap receipts to the project
// pubkey) and the donation itself is a NIP-57 zap — a signed kind-9734 zap
// request passed to the project's LNURL-pay callback — so it shows up on the
// wall. Signed-out visitors (or a non-zap LNURL server) fall back to a plain
// LNURL invoice with the message as the LNURL comment.

// Lightning Piggy's Nostr pubkey (npub1y2qcaseaspuwvjtyk4suswdhgselydc42ttlt0t2kzhnykne7s5swvaffq)
// — the zap recipient and the `#p` the wall queries.
const PROJECT_PUBKEY = '22818ec33d8078e64964b561c839b74433f2371552d7f5bd6ab0af325a79f429';
// The project's Lightning address (same one the page has always used). Its
// LNURL-pay metadata advertises `allowsNostr`, so zap requests become real zaps.
const LUD16 = 'oink@lightningpiggy.com';

const PRESETS = [1000, 5000, 21000, 50000, 100000];
---

<BaseLayout title="Zap us a donation" description="Support Lightning Piggy — an open source Bitcoin piggy bank for kids. Zap sats over Nostr/Lightning and join the wall of zappers.">

  <!-- Hero -->
  <div class="relative overflow-hidden bg-gradient-to-b from-gray-900 to-gray-800 text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 text-center">
      <img
        src="/images/mascot.png"
        alt="LightningPiggy mascot"
        class="w-20 h-20 mx-auto mb-6 rounded-2xl"
      />
      <h1 class="text-4xl md:text-5xl font-bold mb-6">⚡ Zap Lightning Piggy</h1>
      <p class="text-xl text-gray-300 leading-relaxed max-w-2xl mx-auto">
        Lightning Piggy is free, open source, and community funded. Zap the
        <a href="/about" class="text-pink hover:underline">Lightning Piggy project</a>
        some sats to keep sound money tools coming for the next generation.
      </p>
    </div>
  </div>

  <div id="zap-root" data-pubkey={PROJECT_PUBKEY} data-lud16={LUD16}>

    <!-- Wall of zappers: live kind-9735 receipts from the relays -->
    <section class="py-12 bg-gray-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-xl font-bold text-gray-900 mb-2">Wall of Zappers</h2>
        <p class="text-gray-600 mb-8">
          Everyone whose zaps add up to <span id="wall-threshold" class="font-semibold">$50 worth of sats</span> earns a spot on the wall — straight from Nostr, no sign-up.
        </p>
        <!-- Loading skeleton (replaced by the client script) -->
        <div id="wall-skeleton" class="flex flex-wrap justify-center items-center gap-4" aria-hidden="true">
          {Array.from({ length: 8 }).map(() => (
            <div class="w-16 h-16 rounded-full bg-gray-200 animate-pulse"></div>
          ))}
        </div>
        <div id="wall-avatars" class="hidden flex-wrap justify-center items-center gap-4"></div>
        <p id="wall-empty" class="hidden text-gray-500">
          The wall is waiting for its first big zapper — will it be you? ⚡
        </p>
      </div>
    </section>

    <!-- Zap form -->
    <section class="py-10 md:py-16 bg-white">
      <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Send a zap</h2>
          <p class="text-lg text-gray-600 max-w-xl mx-auto">
            Pick an amount in sats, add a message if you like, and pay with any Lightning wallet.
          </p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 p-6 md:p-8">

          <!-- Sign-in state: signed-in zaps carry your Nostr identity onto the wall -->
          <div id="zap-auth" class="flex items-center justify-between gap-3 rounded-lg border px-3 py-2.5 mb-6">
            <span id="zap-auth-text" class="text-sm"></span>
            <button type="button" id="zap-auth-action" class="text-sm font-semibold text-pink hover:underline whitespace-nowrap"></button>
          </div>

          <form id="zap-form" class="space-y-6">
            <!-- Amount (sats) -->
            <div>
              <label class="block text-sm font-semibold text-gray-900 mb-3">Zap amount (sats)</label>
              <div class="grid grid-cols-3 sm:grid-cols-5 gap-2 mb-3" id="zap-presets">
                {PRESETS.map((sats) => (
                  <button type="button" data-sats={sats}
                    class={`preset-btn py-2.5 px-1 rounded-xl border-2 font-semibold text-sm transition-all ${
                      sats === 21000
                        ? 'border-pink bg-pink/5 text-pink'
                        : 'border-gray-200 text-gray-700 hover:border-pink hover:text-pink'
                    }`}>{sats.toLocaleString('en-US')}</button>
                ))}
              </div>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium">⚡</span>
                <input
                  type="number"
                  id="zap-amount"
                  name="amount"
                  min="1"
                  step="1"
                  value="21000"
                  required
                  placeholder="Custom amount in sats"
                  class="w-full pl-10 pr-14 py-3 rounded-xl border border-gray-200 focus:border-pink focus:ring-2 focus:ring-pink/20 outline-none transition-all text-gray-900 placeholder-gray-400"
                />
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm">sats</span>
              </div>
            </div>

            <!-- Optional message -->
            <div>
              <label for="zap-message" class="block text-sm font-semibold text-gray-900 mb-1.5">
                Message <span class="font-normal text-gray-400">(optional)</span>
              </label>
              <textarea
                id="zap-message"
                name="message"
                rows="2"
                maxlength="255"
                placeholder="Oink oink! 🐷⚡"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-pink focus:ring-2 focus:ring-pink/20 outline-none transition-all text-gray-900 placeholder-gray-400"
              ></textarea>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              id="zap-submit"
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-6 bg-pink text-white font-semibold rounded-xl hover:bg-pink/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              <span id="zap-submit-text">Zap 21,000 sats</span>
            </button>

            <p id="zap-error" class="text-sm text-red-500 text-center hidden"></p>

            <p class="text-xs text-gray-500 text-center">
              Donations are voluntary and non-refundable. By donating you agree to our
              <a href="/terms" class="underline underline-offset-2 hover:text-pink">Terms</a>
              and
              <a href="/privacy" class="underline underline-offset-2 hover:text-pink">Privacy Policy</a>.
            </p>
          </form>

          <!-- Invoice view (swapped in after submit) -->
          <div id="zap-invoice" class="hidden">
            <p id="invoice-heading" class="text-center text-sm font-semibold text-green-600 mb-3"></p>
            <div class="flex justify-center mb-3">
              <img id="invoice-qr" alt="Scan to pay with a Lightning wallet" width="220" height="220" class="hidden w-56 h-56 rounded-xl border border-gray-200 bg-white p-2" />
            </div>
            <p id="invoice-amount" class="text-center text-2xl font-bold text-gray-900 mb-4"></p>
            <label class="block text-sm text-gray-500 mb-1">Lightning invoice</label>
            <div class="flex gap-2 mb-4">
              <input id="invoice-bolt11" readonly class="flex-1 min-w-0 text-xs font-mono rounded-lg border border-gray-300 bg-gray-50 px-3 py-2" />
              <button id="invoice-copy" type="button" title="Copy invoice" aria-label="Copy invoice" class="shrink-0 px-3 rounded-lg border border-gray-300 text-gray-500 hover:border-pink hover:text-pink transition text-xs font-semibold">
                Copy
              </button>
            </div>
            <div class="space-y-2">
              <button id="invoice-webln" type="button" class="hidden w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-pink text-white font-semibold hover:bg-pink/90 transition disabled:opacity-60">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <span id="invoice-webln-text">Pay with WebLN</span>
              </button>
              <a id="invoice-open" href="#" class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-gray-300 font-semibold text-gray-700 hover:border-pink hover:text-pink transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                Open in wallet
              </a>
            </div>
            <p id="invoice-paid" class="hidden mt-3 text-center text-sm font-semibold text-green-600">✓ Paid — thank you, and welcome to the herd! 🐷⚡</p>
            <p class="text-xs text-gray-400 text-center mt-3">Scan the QR or copy the invoice to pay with any Lightning wallet.</p>
            <button id="invoice-back" type="button" class="mt-4 w-full text-sm font-semibold text-gray-500 hover:text-pink transition">
              ← Change amount
            </button>
          </div>

        </div>

        <p class="text-sm text-gray-400 mt-6 text-center">
          Zaps go straight to the project's Lightning address — no middleman, no backend, no sign-up.
        </p>
      </div>
    </section>

  </div>

  <script>
    import { getSession, openLogin, logout, signEvent, shortId, type NostrSession } from '../lib/nostrAuth';
    import { RELAYS, escapeHtml, sanitizeUrl, type NostrEvent } from '../lib/market';
    import { topZappers, thresholdSatsForUsd, FALLBACK_THRESHOLD_SATS } from '../lib/zaps';

    const root = document.getElementById('zap-root');
    if (root) {
      const PROJECT_PUBKEY = root.dataset.pubkey!;
      const LUD16 = root.dataset.lud16!;

      // ---- shared: relay fetch (same close-on-finish pattern as the market;
      // close() on a CONNECTING socket cancels the attempt so nothing dangles) ----
      function fetchFromRelay(url: string, filter: any): Promise<NostrEvent[]> {
        return new Promise((resolve) => {
          const evs: NostrEvent[] = [];
          let ws: WebSocket | undefined;
          let done = false;
          const finish = () => {
            if (done) return;
            done = true;
            clearTimeout(t);
            try {
              if (ws) {
                ws.onopen = () => {
                  try {
                    ws!.close();
                  } catch {}
                };
                ws.onmessage = null;
                ws.close();
              }
            } catch {}
            resolve(evs);
          };
          const t = window.setTimeout(finish, 6000);
          try {
            ws = new WebSocket(url);
          } catch {
            finish();
            return;
          }
          const sub = Math.random().toString(36).slice(2, 10);
          ws.onopen = () => ws!.send(JSON.stringify(['REQ', sub, filter]));
          ws.onmessage = (e) => {
            try {
              const m = JSON.parse(e.data);
              if (m[0] === 'EVENT' && m[1] === sub) evs.push(m[2]);
              if (m[0] === 'EOSE' && m[1] === sub) finish();
            } catch {}
          };
          ws.onerror = () => finish();
        });
      }
      async function fetchAll(filter: any): Promise<NostrEvent[]> {
        return (await Promise.all(RELAYS.map((r) => fetchFromRelay(r, filter)))).flat();
      }

      // ---- shared: cached Coinbase BTC rate (same source as the market's toSats) ----
      let btcRates: any = null;
      async function usdPerBtc(): Promise<number | null> {
        try {
          if (!btcRates) {
            const res = await fetch('https://api.coinbase.com/v2/exchange-rates?currency=BTC');
            btcRates = (await res.json())?.data?.rates || {};
          }
          const r = parseFloat(btcRates['USD']);
          return isFinite(r) && r > 0 ? r : null;
        } catch {
          return null;
        }
      }

      // ================= Wall of zappers =================
      // loadWall can run more than once (initial load + after a WebLN payment),
      // so it fully resets the empty/avatars states each pass, and a run token
      // makes sure an overlapping earlier run can't clobber a newer one's UI.
      let wallRun = 0;
      async function loadWall() {
        const skeleton = document.getElementById('wall-skeleton');
        const wallEl = document.getElementById('wall-avatars');
        const emptyEl = document.getElementById('wall-empty');
        const thresholdEl = document.getElementById('wall-threshold');
        if (!wallEl || !skeleton || !emptyEl) return;
        const run = ++wallRun;

        // Receipts + the $50-in-sats bar (nearest 1,000; 50k-sat fallback).
        const [receipts, rate] = await Promise.all([
          fetchAll({ kinds: [9735], '#p': [PROJECT_PUBKEY], limit: 500 }),
          usdPerBtc(),
        ]);
        if (run !== wallRun) return; // a newer run took over
        const threshold = rate ? thresholdSatsForUsd(rate) : FALLBACK_THRESHOLD_SATS;
        if (thresholdEl) thresholdEl.textContent = `${threshold.toLocaleString('en-US')} sats (~$50)`;

        const zappers = topZappers(receipts, threshold);
        skeleton.classList.add('hidden');
        if (!zappers.length) {
          wallEl.classList.add('hidden');
          wallEl.classList.remove('flex');
          emptyEl.classList.remove('hidden');
          return;
        }
        emptyEl.classList.add('hidden');

        // Profiles (kind 0) + npubs for the qualifying zappers only. Kind 0 is
        // replaceable so relays should hold one per author — the limit is a
        // belt-and-braces cap against relays that keep old versions.
        const authors = [...new Set(zappers.map((z) => z.pubkey))];
        const [profileEvents, { npubEncode }] = await Promise.all([
          fetchAll({ kinds: [0], authors, limit: authors.length * 2 }),
          import('nostr-tools/nip19'),
        ]);
        if (run !== wallRun) return; // a newer run took over
        const profiles = new Map<string, { name: string; picture: string }>();
        const newest = new Map<string, NostrEvent>();
        for (const ev of profileEvents) {
          if (ev.kind !== 0) continue;
          const ex = newest.get(ev.pubkey);
          if (!ex || ev.created_at > ex.created_at) newest.set(ev.pubkey, ev);
        }
        for (const [pk, ev] of newest) {
          try {
            const p = JSON.parse(ev.content);
            profiles.set(pk, {
              name: String(p.display_name || p.name || ''),
              picture: sanitizeUrl(String(p.picture || '')),
            });
          } catch {}
        }

        // Everything below came off the relays → escape before innerHTML.
        wallEl.innerHTML = zappers
          .map((z) => {
            const p = profiles.get(z.pubkey);
            const name = p?.name || shortId(z.pubkey);
            let npub = '';
            try {
              npub = npubEncode(z.pubkey);
            } catch {}
            const tooltip = `${name} — ${z.sats.toLocaleString('en-US')} sats`;
            const img = p?.picture
              ? `<img src="${escapeHtml(p.picture)}" alt="${escapeHtml(name)}" loading="lazy" referrerpolicy="no-referrer" class="w-full h-full object-cover" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
              : '';
            const initial = `<div class="w-full h-full bg-pink/10 items-center justify-center text-pink font-bold ${p?.picture ? 'hidden' : 'flex'}" style="${p?.picture ? 'display:none' : ''}">${escapeHtml((name || '?').charAt(0).toUpperCase())}</div>`;
            return `<a href="https://njump.me/${escapeHtml(npub)}" target="_blank" rel="noopener noreferrer" title="${escapeHtml(tooltip)}"
                       class="block w-16 h-16 rounded-full bg-gray-100 overflow-hidden hover:ring-2 hover:ring-pink/50 transition">${img}${initial}</a>`;
          })
          .join('');
        wallEl.classList.remove('hidden');
        wallEl.classList.add('flex');
      }
      loadWall();

      // ================= Zap form =================
      const form = document.getElementById('zap-form') as HTMLFormElement | null;
      const amountInput = document.getElementById('zap-amount') as HTMLInputElement | null;
      const messageInput = document.getElementById('zap-message') as HTMLTextAreaElement | null;
      const submitBtn = document.getElementById('zap-submit') as HTMLButtonElement | null;
      const submitText = document.getElementById('zap-submit-text');
      const errorEl = document.getElementById('zap-error');
      const invoiceView = document.getElementById('zap-invoice');
      const presetBtns = document.querySelectorAll<HTMLButtonElement>('#zap-presets .preset-btn');

      // Sign-in banner: a signed-in zap is a REAL zap (it can reach the wall).
      const authText = document.getElementById('zap-auth-text');
      const authAction = document.getElementById('zap-auth-action');
      const authBox = document.getElementById('zap-auth');
      function renderAuth(s: NostrSession | null) {
        if (!authText || !authAction || !authBox) return;
        if (s) {
          authText.textContent = '';
          const strong = document.createElement('strong');
          strong.textContent = s.name || shortId(s.pubkey); // relay-supplied → textContent
          authText.append('⚡ Zapping as ', strong, ' — your zap can appear on the wall.');
          authAction.textContent = 'Sign out';
          authBox.className = 'flex items-center justify-between gap-3 rounded-lg border border-green-200 bg-green-50 px-3 py-2.5 mb-6 text-green-800';
        } else {
          authText.textContent = 'Sign in with Nostr so your zap counts towards the wall.';
          authAction.textContent = 'Sign in';
          authBox.className = 'flex items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2.5 mb-6 text-amber-800';
        }
      }
      window.addEventListener('nostr:auth', (e) => renderAuth((e as CustomEvent).detail));
      renderAuth(getSession());
      authAction?.addEventListener('click', () => {
        if (getSession()) logout();
        else openLogin();
      });

      // Sats must stay a safe integer even after ×1000 to msats — otherwise a
      // huge input stringifies into scientific notation in the LNURL callback
      // URL (amount=1e+21) and dodges the min/max clamping. Invalid → 0.
      const MAX_SATS = Math.floor(Number.MAX_SAFE_INTEGER / 1000);
      const currentSats = () => {
        const n = Math.floor(parseFloat(amountInput?.value || '0'));
        return Number.isSafeInteger(n) && n > 0 && n <= MAX_SATS ? n : 0;
      };
      function refreshSubmitLabel() {
        if (submitText) {
          const sats = currentSats();
          submitText.textContent = sats > 0 ? `Zap ${sats.toLocaleString('en-US')} sats` : 'Zap sats';
        }
      }
      function setActivePreset(active: HTMLButtonElement | null) {
        presetBtns.forEach((btn) => {
          const on = btn === active;
          btn.classList.toggle('border-pink', on);
          btn.classList.toggle('bg-pink/5', on);
          btn.classList.toggle('text-pink', on);
          btn.classList.toggle('border-gray-200', !on);
          btn.classList.toggle('text-gray-700', !on);
        });
      }
      presetBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (amountInput) amountInput.value = btn.dataset.sats || '';
          setActivePreset(btn);
          refreshSubmitLabel();
          errorEl?.classList.add('hidden');
        });
      });
      amountInput?.addEventListener('input', () => {
        let matched: HTMLButtonElement | null = null;
        presetBtns.forEach((btn) => {
          if (btn.dataset.sats === amountInput.value) matched = btn;
        });
        setActivePreset(matched);
        refreshSubmitLabel();
      });

      function showError(msg: string) {
        if (errorEl) {
          errorEl.textContent = msg;
          errorEl.classList.remove('hidden');
        }
      }

      // LNURL-pay metadata, fetched once per page.
      let lnurlMeta: any = null;
      async function getLnurlMeta(): Promise<any> {
        if (lnurlMeta) return lnurlMeta;
        const at = LUD16.indexOf('@');
        if (at < 1) throw new Error('bad lud16');
        const res = await fetch(`https://${LUD16.slice(at + 1)}/.well-known/lnurlp/${LUD16.slice(0, at)}`);
        const meta = await res.json();
        if (!meta || !meta.callback) throw new Error('no callback');
        lnurlMeta = meta;
        return meta;
      }

      // Build + sign the NIP-57 kind-9734 zap request. Returned signed event is
      // URL-encoded into the LNURL callback's `nostr` param.
      async function buildZapRequest(msats: number, message: string): Promise<any> {
        const s = getSession();
        if (!s) throw new Error('not-signed-in');
        const unsigned = {
          kind: 9734,
          created_at: Math.floor(Date.now() / 1000),
          content: message,
          tags: [
            ['p', PROJECT_PUBKEY],
            ['amount', String(msats)],
            ['relays', ...RELAYS],
          ],
          pubkey: s.pubkey,
        };
        return signEvent(unsigned);
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl?.classList.add('hidden');
        const sats = currentSats();
        if (!sats || sats < 1) {
          showError('Please enter a valid amount in sats.');
          return;
        }
        const message = (messageInput?.value || '').trim();
        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Fetching invoice…';
        try {
          const meta = await getLnurlMeta();
          let msats = sats * 1000;
          if (meta.minSendable) msats = Math.max(msats, meta.minSendable);
          if (meta.maxSendable) msats = Math.min(msats, meta.maxSendable);

          const sep = meta.callback.includes('?') ? '&' : '?';
          let url = `${meta.callback}${sep}amount=${msats}`;
          let isZap = false;
          if (meta.allowsNostr && getSession()) {
            // Real zap: the LNURL server publishes a kind-9735 receipt → wall.
            try {
              const zapRequest = await buildZapRequest(msats, message);
              url += `&nostr=${encodeURIComponent(JSON.stringify(zapRequest))}`;
              isZap = true;
            } catch (err) {
              console.error('[zap] zap request signing failed, falling back to plain LNURL:', err);
            }
          }
          if (!isZap && message && meta.commentAllowed > 0) {
            url += `&comment=${encodeURIComponent(message.slice(0, meta.commentAllowed))}`;
          }

          const inv = await (await fetch(url)).json();
          if (!inv || !inv.pr) throw new Error(inv?.reason || 'no invoice');
          showInvoice(inv.pr as string, Math.floor(msats / 1000), isZap);
        } catch (err: any) {
          console.error('[zap] invoice failed:', err);
          showError('Could not fetch an invoice right now. Please try again, or use one of the other ways to donate below.');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          refreshSubmitLabel();
        }
      });

      let qrSeq = 0; // guards the async QR render against invoice changes
      function showInvoice(bolt11: string, sats: number, isZap: boolean) {
        form?.classList.add('hidden');
        invoiceView?.classList.remove('hidden');
        const heading = document.getElementById('invoice-heading');
        if (heading)
          heading.textContent = isZap
            ? '✓ Zap request signed — pay the invoice to land on the wall:'
            : '✓ Invoice ready — pay with any Lightning wallet:';
        (document.getElementById('invoice-amount') as HTMLElement).textContent =
          `${sats.toLocaleString('en-US')} sats`;
        (document.getElementById('invoice-bolt11') as HTMLInputElement).value = bolt11;
        (document.getElementById('invoice-open') as HTMLAnchorElement).href = `lightning:${bolt11}`;
        document.getElementById('invoice-paid')?.classList.add('hidden');

        // QR (qrcode is dynamically imported — only loads when an invoice
        // shows). The previous QR is cleared up-front so a stale code is never
        // visible next to a new invoice, and a sequence token stops an earlier,
        // slower render from overwriting a newer invoice's QR.
        const qrImg = document.getElementById('invoice-qr') as HTMLImageElement | null;
        if (qrImg) {
          const seq = ++qrSeq;
          qrImg.classList.add('hidden');
          qrImg.removeAttribute('src');
          import('qrcode')
            .then(({ default: QRCode }) =>
              QRCode.toDataURL(bolt11.toUpperCase(), { margin: 1, width: 240, errorCorrectionLevel: 'M' }),
            )
            .then((url) => {
              if (seq !== qrSeq) return; // a newer invoice took over
              qrImg.src = url;
              qrImg.classList.remove('hidden');
            })
            .catch(() => {});
        }

        // onclick ASSIGNMENT (not addEventListener): showInvoice can run more
        // than once (change amount → new invoice) and stacked listeners would
        // fire stale closures — copying/paying an outdated invoice.
        const copyBtn = document.getElementById('invoice-copy') as HTMLButtonElement | null;
        if (copyBtn) {
          copyBtn.textContent = 'Copy';
          copyBtn.onclick = () => {
            navigator.clipboard?.writeText(bolt11);
            copyBtn.textContent = 'Copied!';
          };
        }

        const webln = (window as any).webln;
        const weblnBtn = document.getElementById('invoice-webln') as HTMLButtonElement | null;
        // Update only the label span — setting the button's textContent would
        // wipe the zap icon SVG next to it.
        const weblnText = document.getElementById('invoice-webln-text');
        if (webln && weblnBtn && weblnText) {
          weblnBtn.classList.remove('hidden');
          weblnBtn.disabled = false;
          weblnText.textContent = 'Pay with WebLN';
          weblnBtn.onclick = async () => {
            weblnBtn.disabled = true;
            weblnText.textContent = 'Paying…';
            try {
              await webln.enable();
              await webln.sendPayment(bolt11);
              document.getElementById('invoice-paid')?.classList.remove('hidden');
              weblnText.textContent = 'Paid ✓';
              loadWall(); // the new zap may already tip someone over the bar
            } catch {
              weblnBtn.disabled = false;
              weblnText.textContent = 'Pay with WebLN';
            }
          };
        }

        const backBtn = document.getElementById('invoice-back') as HTMLButtonElement | null;
        if (backBtn) {
          backBtn.onclick = () => {
            invoiceView?.classList.add('hidden');
            form?.classList.remove('hidden');
          };
        }
      }
    }
  </script>


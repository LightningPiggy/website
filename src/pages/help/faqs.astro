---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection, render } from 'astro:content';

const posts = await getCollection('pages');
const faqsPost = posts.find(p => p.data.slug === 'faqs');

let Content = null;
if (faqsPost) {
  const rendered = await render(faqsPost);
  Content = rendered.Content;
}
---

<ContentLayout
  title={t('faq.title')}
  description={t('faq.desc')}
>
  {Content && <Content />}

  <hr class="my-12 border-gray-200" />

  <h2>{t('build.questions')}</h2>
  <p>
    Join our <a href="https://t.me/LightningPiggy" target="_blank" rel="noopener" class="text-pink">Telegram community</a> or
    email us at <a href="mailto:oink@lightningpiggy.com" class="text-pink">oink@lightningpiggy.com</a>.
  </p>
</ContentLayout>

---
import ContentLayout from '../layouts/ContentLayout.astro';
import Button from '../components/ui/Button.astro';
import VendorCard from '../components/ui/VendorCard.astro';
import VendorApplyForm from '../components/ui/VendorApplyForm.astro';
import vendorsData from '../data/vendors.json';

const { vendors = [] } = vendorsData;

const featuredVendors = vendors.filter((v) => v.featured);
const regularVendors = vendors.filter((v) => !v.featured);
---

<ContentLayout
  title="Market"
  description="This little piggy went to market… Buy a Lightning Piggy directly from the project team or from one of these awesome vendors below. Making sats the savings standard for every child is a team effort! If you run a store and would like to stock Lightning Piggy, we’d love to hear from you."
  heroImage="/images/pages/robotechy-pigs.jpeg"
>
  {featuredVendors.length > 0 && (
    <div class="not-prose">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Pride of the Market</h2>
      <p class="text-gray-600 mb-6">
        These featured vendors have kindly pledged at least <strong>10% of their sales</strong> back to
        Lightning Piggy. Their generosity keeps the project free and open source, and helps us move faster
        toward our mission - empowering every child to save for their future on a Bitcoin standard, in a way
        that's fun, friendly, and educational.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {featuredVendors.map((vendor) => <VendorCard vendor={vendor} />)}
      </div>
    </div>
  )}

  {regularVendors.length > 0 && (
    <div class="not-prose mt-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Responsible Farmers</h2>
      <p class="text-gray-600 mb-6">
        More awesome stores stocking Lightning Piggy. Making sats the savings standard for every child is a team effort!
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {regularVendors.map((vendor) => <VendorCard vendor={vendor} />)}
      </div>
    </div>
  )}

  <hr class="my-8 border-gray-200" />

  <!-- Become a vendor -->
  <div class="not-prose" id="become-a-vendor">
    <div class="rounded-2xl border border-gray-200 bg-gradient-to-br from-pink/5 to-white p-8 md:p-10">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Run a Store? Stock Lightning Piggy</h2>
      <p class="text-gray-600 mb-6">
        We'd love to add your shop to the market. The team will review your application.
        Making sats the savings standard for every child is a team effort!
      </p>

      <button
        type="button"
        id="vendor-apply-toggle"
        aria-expanded="false"
        aria-controls="vendor-apply-panel"
        class="inline-flex items-center gap-2 px-6 py-3 bg-pink text-white font-semibold rounded-xl hover:bg-pink/90 transition-colors focus:outline-none focus:ring-2 focus:ring-pink/50"
      >
        Apply to Sell
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>

      <div id="vendor-apply-panel" class="mt-6" hidden>
        <VendorApplyForm />
      </div>
    </div>
  </div>

  <script>
    const toggle = document.getElementById('vendor-apply-toggle');
    const panel = document.getElementById('vendor-apply-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        panel.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        toggle.hidden = true;
        // Focus the first field for keyboard users
        const firstField = panel.querySelector('input, select, textarea');
        if (firstField) (firstField as HTMLElement).focus();
      });
    }
  </script>

  <hr class="my-8 border-gray-200" />

  <h2>Prefer to Build Your Own?</h2>
  <p>
    Lightning Piggy is fully open source. Source the parts yourself and follow our
    step-by-step build guide.
  </p>

  <div class="not-prose mt-6">
    <Button href="/build" variant="outline">
      View Build Guide →
    </Button>
  </div>

  <hr class="my-8 border-gray-200" />

  <!-- NIP-05 Handles section -->
  <div class="not-prose">
    <div class="rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-8 md:p-10">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-3">
            <h2 class="text-2xl font-bold text-gray-900">Nostr NIP-05 Handles</h2>
          </div>
          <p class="text-gray-600 mb-2">
            Get <span class="font-semibold text-pink">yourname@lightningpiggy.com</span> as your Nostr identity.
            Verified, memorable, and powered by the Lightning Piggy community.
          </p>
          <p class="text-sm text-gray-500">
            Pay what you want (min $5) with Bitcoin over Lightning. Your handle will be live within minutes.
          </p>
          <div class="mt-6">
            <a
              href="/market/nip05"
              class="inline-flex items-center gap-2 px-6 py-3 bg-pink text-white font-semibold rounded-xl hover:bg-pink/90 transition-colors"
            >
              Get Your Handle
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
        <div class="hidden md:flex flex-shrink-0 w-40 h-40 items-center justify-center">
          <img src="/images/pages/lightningpiggy-thumbs-up.png" alt="Lightning Piggy thumbs up" class="w-full h-full object-contain" />
        </div>
      </div>
    </div>
  </div>
</ContentLayout>

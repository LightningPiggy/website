---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Piglets Map"
  description="Explore live Lightning Piggy Piglets and NIP-GC geocaches on an interactive world map, pulled straight from Nostr relays."
>
  <!-- MapLibre GL JS (loaded from CDN, no npm dependency) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@4/dist/maplibre-gl.min.css" />

  <div id="piglets-root" class="relative w-full" style="height: calc(100vh - 4rem);">
    <!-- Map fills the container -->
    <div id="piglets-map" class="absolute inset-0"></div>

    <!-- Loading overlay -->
    <div
      id="piglets-loading"
      class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-white/70 backdrop-blur-sm pointer-events-none"
    >
      <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-pink border-t-transparent"></div>
      <p class="text-gray-600 mt-3 font-medium">Loading Piglets from Nostr…</p>
    </div>

    <!-- Empty state -->
    <div
      id="piglets-empty"
      class="absolute top-4 left-1/2 -translate-x-1/2 z-10 hidden rounded-full bg-white shadow-lg border border-gray-200 px-4 py-2 text-sm text-gray-600"
    >
      No Piglets found yet — go hide one!
    </div>

    <!-- Legend + count -->
    <div
      id="piglets-legend"
      class="absolute bottom-4 left-4 z-10 hidden rounded-xl bg-white/95 shadow-lg border border-gray-200 px-3 py-2 text-xs text-gray-700 space-y-1.5"
    >
      <div class="flex items-center gap-2">
        <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-pink text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"/><path d="M2 9v1c0 1.1.9 2 2 2h1"/><path d="M16 11h.01"/></svg>
        </span>
        <span>Piglet</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-white border border-pink text-pink">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"/><path d="M2 9v1c0 1.1.9 2 2 2h1"/><path d="M16 11h.01"/></svg>
        </span>
        <span>NIP-GC cache</span>
      </div>
      <div id="piglets-count" class="pt-1 border-t border-gray-100 text-gray-500"></div>
    </div>
  </div>

  <!-- MapLibre GL JS script (loaded from CDN) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/maplibre-gl@4/dist/maplibre-gl.min.js"></script>

  <script>
    // -----------------------------------------------------------------------
    // Pure helpers (ported verbatim from the Lightning Piggy mobile app)
    // -----------------------------------------------------------------------
    // rot13 — faithful port of the mobile app's rot13 obfuscation/decode (the
    // two are the same operation). Hints are rot13-obfuscated on the wire.
    function rot13Decode(input: string): string {
      let out = '';
      for (let i = 0; i < input.length; i++) {
        const code = input.charCodeAt(i);
        if (code >= 65 && code <= 90) {
          out += String.fromCharCode(((code - 65 + 13) % 26) + 65);
        } else if (code >= 97 && code <= 122) {
          out += String.fromCharCode(((code - 97 + 13) % 26) + 97);
        } else {
          out += input[i];
        }
      }
      return out;
    }

    const GEOHASH_BASE32 = '0123456789bcdefghjkmnpqrstuvwxyz';
    function decodeGeohash(gh: string): { lat: number; lng: number } {
      let latLo = -90,
        latHi = 90,
        lonLo = -180,
        lonHi = 180,
        evenBit = true;
      for (let i = 0; i < gh.length; i++) {
        const idx = GEOHASH_BASE32.indexOf(gh[i].toLowerCase());
        if (idx < 0) continue;
        for (let bit = 4; bit >= 0; bit--) {
          const set = (idx >> bit) & 1;
          if (evenBit) {
            const mid = (lonLo + lonHi) / 2;
            if (set) lonLo = mid;
            else lonHi = mid;
          } else {
            const mid = (latLo + latHi) / 2;
            if (set) latLo = mid;
            else latHi = mid;
          }
          evenBit = !evenBit;
        }
      }
      return { lat: (latLo + latHi) / 2, lng: (lonLo + lonHi) / 2 };
    }

    // -----------------------------------------------------------------------
    // Sanitisation helpers (mirrors NostrProducts.astro)
    // -----------------------------------------------------------------------
    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function sanitizeUrl(url: string): string {
      try {
        const parsed = new URL(url);
        if (parsed.protocol === 'http:' || parsed.protocol === 'https:') return url;
      } catch {}
      return '';
    }

    // -----------------------------------------------------------------------
    // Nostr relays + types
    // -----------------------------------------------------------------------
    const GC_RELAYS = [
      'wss://nos.lol',
      'wss://relay.damus.io',
      'wss://relay.ditto.pub',
      'wss://relay.dreamith.to',
    ];

    interface NostrEvent {
      id: string;
      content: string;
      tags: string[][];
      pubkey: string;
      kind: number;
      created_at: number;
    }

    interface ParsedCache {
      d: string;
      name: string;
      description: string;
      difficulty: number | null;
      terrain: number | null;
      size: string | null;
      cacheType: string | null;
      geohash: string;
      hint: string | null;
      imageUrl: string | null;
      payoutSats: number | null;
      waitSeconds: number | null;
      uses: number | null;
      expiresAt: number | null;
      createdAt: number;
      hiderPubkey: string;
      coord: string;
      isLpPiggy: boolean;
      lat: number;
      lng: number;
    }

    // First tag value for a key.
    function firstTag(tags: string[][], key: string): string | undefined {
      const t = tags.find((tag) => tag[0] === key);
      return t ? t[1] : undefined;
    }

    function intOrNull(v: string | undefined): number | null {
      if (v == null) return null;
      const n = parseInt(v, 10);
      return Number.isNaN(n) ? null : n;
    }

    function parseCache(event: NostrEvent): ParsedCache | null {
      const tags = event.tags || [];
      const d = firstTag(tags, 'd');
      if (!d) return null;

      // Longest g tag → geohash. No g tag → no location → skip.
      const gTags = tags
        .filter((t) => t[0] === 'g' && typeof t[1] === 'string')
        .map((t) => t[1])
        .sort((a, b) => b.length - a.length);
      const geohash = gTags[0];
      if (!geohash) return null;

      const { lat, lng } = decodeGeohash(geohash);

      const hintRaw = firstTag(tags, 'hint');
      const imageUrlRaw = firstTag(tags, 'image');

      const isLpPiggy = tags.some(
        (t) => t[0] === 'l' && t[1] === 'payout-lnurl-w' && t[2] === 'com.lightningpiggy.app',
      );

      return {
        d,
        name: firstTag(tags, 'name') || 'Unnamed cache',
        description: event.content || '',
        difficulty: intOrNull(firstTag(tags, 'D')),
        terrain: intOrNull(firstTag(tags, 'T')),
        size: firstTag(tags, 'S') || null,
        cacheType: firstTag(tags, 't') || null,
        geohash,
        hint: hintRaw ? rot13Decode(hintRaw) : null,
        imageUrl: imageUrlRaw || null,
        payoutSats: intOrNull(firstTag(tags, 'amount')),
        waitSeconds: intOrNull(firstTag(tags, 'wait')),
        uses: intOrNull(firstTag(tags, 'uses')),
        expiresAt: intOrNull(firstTag(tags, 'expiration')),
        createdAt: event.created_at,
        hiderPubkey: event.pubkey,
        coord: `37516:${event.pubkey}:${d}`,
        isLpPiggy,
        lat,
        lng,
      };
    }

    // -----------------------------------------------------------------------
    // Relay fetching (mirrors NostrProducts.astro WebSocket pattern)
    // -----------------------------------------------------------------------
    function fetchFromRelay(relayUrl: string): Promise<NostrEvent[]> {
      return new Promise((resolve) => {
        const events: NostrEvent[] = [];
        let ws: WebSocket;
        let timeout: number;

        try {
          ws = new WebSocket(relayUrl);
        } catch {
          resolve([]);
          return;
        }

        const subId = Math.random().toString(36).slice(2, 10);

        ws.onopen = () => {
          ws.send(JSON.stringify(['REQ', subId, { kinds: [37516], limit: 500 }]));
          timeout = window.setTimeout(() => {
            try {
              ws.close();
            } catch {}
            resolve(events);
          }, 6000);
        };

        ws.onmessage = (e) => {
          try {
            const msg = JSON.parse(e.data);
            if (msg[0] === 'EVENT' && msg[1] === subId && msg[2]?.kind === 37516) {
              events.push(msg[2]);
            }
            if (msg[0] === 'EOSE' && msg[1] === subId) {
              clearTimeout(timeout);
              try {
                ws.close();
              } catch {}
              resolve(events);
            }
          } catch {
            // ignore parse errors
          }
        };

        ws.onerror = () => {
          clearTimeout(timeout);
          resolve([]);
        };

        ws.onclose = () => {
          clearTimeout(timeout);
        };
      });
    }

    async function fetchCaches(): Promise<ParsedCache[]> {
      const results = await Promise.all(GC_RELAYS.map((r) => fetchFromRelay(r)));
      const allEvents = results.flat();

      const now = Math.floor(Date.now() / 1000);

      // Dedupe parameterised-replaceable events: key by pubkey:d, keep newest.
      const newest = new Map<string, NostrEvent>();
      for (const ev of allEvents) {
        const d = firstTag(ev.tags || [], 'd');
        if (!d) continue;
        const key = ev.pubkey + ':' + d;
        const existing = newest.get(key);
        if (!existing || ev.created_at > existing.created_at) {
          newest.set(key, ev);
        }
      }

      const caches: ParsedCache[] = [];
      for (const ev of newest.values()) {
        const cache = parseCache(ev);
        if (!cache) continue;
        if (cache.expiresAt != null && cache.expiresAt < now) continue; // expired
        caches.push(cache);
      }
      return caches;
    }

    // -----------------------------------------------------------------------
    // Markers + popup (mirrors CacheDetailSheet)
    // -----------------------------------------------------------------------
    const BRAND_PINK = '#EC008C';

    const PIGGY_SVG = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"/><path d="M2 9v1c0 1.1.9 2 2 2h1"/><path d="M16 11h.01"/></svg>`;

    function makeMarkerElement(cache: ParsedCache): HTMLElement {
      const el = document.createElement('div');
      el.style.width = '32px';
      el.style.height = '32px';
      el.style.borderRadius = '9999px';
      el.style.display = 'flex';
      el.style.alignItems = 'center';
      el.style.justifyContent = 'center';
      el.style.cursor = 'pointer';
      el.style.boxShadow = '0 1px 4px rgba(0,0,0,0.35)';
      if (cache.isLpPiggy) {
        el.style.background = BRAND_PINK;
        el.style.border = '2px solid #fff';
        el.style.color = '#fff';
      } else {
        el.style.background = '#fff';
        el.style.border = `2px solid ${BRAND_PINK}`;
        el.style.color = BRAND_PINK;
      }
      el.innerHTML = PIGGY_SVG;
      el.setAttribute('aria-label', cache.isLpPiggy ? 'Piglet' : 'NIP-GC cache');
      return el;
    }

    function buildPopupHtml(cache: ParsedCache): string {
      const kindLabel = cache.isLpPiggy ? 'Piglet' : 'NIP-GC cache';
      const specBits = [
        cache.cacheType,
        cache.size,
        cache.difficulty != null ? 'D' + cache.difficulty : null,
        cache.terrain != null ? 'T' + cache.terrain : null,
      ].filter(Boolean) as string[];

      const iconBadge = cache.isLpPiggy
        ? `<span style="display:inline-flex;width:28px;height:28px;align-items:center;justify-content:center;border-radius:9999px;background:${BRAND_PINK};color:#fff;flex:none;">${PIGGY_SVG}</span>`
        : `<span style="display:inline-flex;width:28px;height:28px;align-items:center;justify-content:center;border-radius:9999px;background:#fff;border:2px solid ${BRAND_PINK};color:${BRAND_PINK};flex:none;">${PIGGY_SVG}</span>`;

      const kindChip = cache.isLpPiggy
        ? `<span style="display:inline-block;padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:600;background:${BRAND_PINK};color:#fff;">Piglet</span>`
        : `<span style="display:inline-block;padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:600;background:#f3f4f6;color:#374151;">NIP-GC cache</span>`;

      const specChip =
        specBits.length > 0
          ? `<span style="display:inline-block;padding:2px 8px;border-radius:9999px;font-size:11px;font-weight:500;background:#f3f4f6;color:#374151;">${escapeHtml(
              specBits.join(' · '),
            )}</span>`
          : '';

      const prizeLine =
        cache.isLpPiggy && cache.payoutSats != null
          ? `<div style="margin-top:8px;font-size:13px;font-weight:600;color:${BRAND_PINK};">⚡ ${cache.payoutSats.toLocaleString()} sats prize</div>`
          : '';

      const descBlock = cache.description
        ? `<p style="margin-top:8px;font-size:13px;color:#4b5563;line-height:1.45;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;">${escapeHtml(
            cache.description,
          )}</p>`
        : '';

      const hintBlock = cache.hint
        ? `<div style="margin-top:8px;">
             <button type="button" class="pg-hint-toggle" style="font-size:12px;font-weight:600;color:${BRAND_PINK};background:none;border:none;padding:0;cursor:pointer;">Hint — reveal</button>
             <p class="pg-hint-text" style="display:none;margin-top:4px;font-size:13px;color:#4b5563;background:#f9fafb;border-radius:8px;padding:6px 8px;">${escapeHtml(
               cache.hint,
             )}</p>
           </div>`
        : '';

      const safeImg = cache.imageUrl ? sanitizeUrl(cache.imageUrl) : '';
      const imgBlock = safeImg
        ? `<img src="${safeImg}" alt="${escapeHtml(
            cache.name,
          )}" loading="lazy" referrerpolicy="no-referrer" style="margin-top:8px;width:100%;border-radius:8px;object-fit:cover;max-height:180px;" onerror="this.style.display='none'">`
        : '';

      return `
        <div style="max-width:260px;font-family:Inter,system-ui,sans-serif;">
          <div style="display:flex;align-items:center;gap:8px;">
            ${iconBadge}
            <strong style="font-size:15px;color:#111827;line-height:1.2;">${escapeHtml(
              cache.name,
            )}</strong>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;">
            ${kindChip}
            ${specChip}
          </div>
          ${prizeLine}
          ${descBlock}
          ${hintBlock}
          ${imgBlock}
        </div>
      `;
    }

    // -----------------------------------------------------------------------
    // Init
    // -----------------------------------------------------------------------
    document.addEventListener('DOMContentLoaded', async () => {
      const maplibregl = (window as any).maplibregl;
      const mapEl = document.getElementById('piglets-map');
      if (!maplibregl || !mapEl) return;

      const loadingEl = document.getElementById('piglets-loading');
      const emptyEl = document.getElementById('piglets-empty');
      const legendEl = document.getElementById('piglets-legend');
      const countEl = document.getElementById('piglets-count');

      const style = {
        version: 8 as const,
        sources: {
          carto: {
            type: 'raster' as const,
            tiles: [
              'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
              'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
              'https://c.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
              'https://d.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
            ],
            tileSize: 256,
            attribution: '© OpenStreetMap contributors © CARTO',
          },
        },
        layers: [{ id: 'carto', type: 'raster' as const, source: 'carto' }],
      };

      const map = new maplibregl.Map({
        container: mapEl,
        style,
        center: [0, 20],
        zoom: 1.5,
        attributionControl: true,
      });
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

      let caches: ParsedCache[] = [];
      try {
        caches = await fetchCaches();
      } catch (e) {
        console.error('Failed to load Piglets:', e);
      }

      loadingEl?.classList.add('hidden');
      legendEl?.classList.remove('hidden');

      if (caches.length === 0) {
        emptyEl?.classList.remove('hidden');
        if (countEl) countEl.textContent = '';
        return;
      }

      if (countEl) {
        const piglets = caches.filter((c) => c.isLpPiggy).length;
        countEl.textContent = `${caches.length} cache${caches.length === 1 ? '' : 's'} · ${piglets} Piglet${
          piglets === 1 ? '' : 's'
        }`;
      }

      const bounds = new maplibregl.LngLatBounds();

      const addMarkers = () => {
        for (const cache of caches) {
          const el = makeMarkerElement(cache);

          const popup = new maplibregl.Popup({
            offset: 18,
            maxWidth: '280px',
            closeButton: true,
          }).setHTML(buildPopupHtml(cache));

          // Wire up the hint reveal toggle each time the popup opens.
          popup.on('open', () => {
            const root = popup.getElement();
            const toggle = root?.querySelector('.pg-hint-toggle') as HTMLButtonElement | null;
            const text = root?.querySelector('.pg-hint-text') as HTMLElement | null;
            if (toggle && text) {
              toggle.addEventListener('click', () => {
                const shown = text.style.display !== 'none';
                text.style.display = shown ? 'none' : 'block';
                toggle.textContent = shown ? 'Hint — reveal' : 'Hint — hide';
              });
            }
          });

          new maplibregl.Marker({ element: el })
            .setLngLat([cache.lng, cache.lat])
            .setPopup(popup)
            .addTo(map);

          bounds.extend([cache.lng, cache.lat]);
        }

        if (!bounds.isEmpty()) {
          map.fitBounds(bounds, { padding: 60, maxZoom: 12, duration: 0 });
        }
      };

      if (map.loaded()) addMarkers();
      else map.on('load', addMarkers);
    });
  </script>
</BaseLayout>

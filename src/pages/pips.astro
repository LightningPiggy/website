---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Piggy Pips';
const description =
  'Facilitator & user manual for Piggy Pips: a physical BIP-39 lottery for teaching Bitcoin key generation to kids. Draw a pip, learn the maths, run a workshop.';
---

<BaseLayout title={title} description={description}>
  <div class="pips">

    <div class="hero">
<div class="glow y"></div><div class="glow p"></div>
  <h1>Piggy <span class="accent">Pips</span></h1>
  <p class="sub">A physical BIP-39 lottery for teaching Bitcoin key generation</p>
  <span class="tag">Facilitator &amp; User Manual</span>
  <div class="wave"><svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 50L60 45.7C120 41 240 33 360 35.2C480 37 600 50 720 55.8C840 62 960 60 1080 53.3C1200 47 1320 37 1380 31.7L1440 27V100H1380C1320 100 1200 100 1080 100C960 100 840 100 720 100C600 100 480 100 360 100C240 100 120 100 60 100H0V50Z" fill="white"/></svg></div>
</div>

    <nav class="subnav" aria-label="On this page">
  <div class="wrap">
    <a href="#safety">Safety</a>
    <a href="#manual">Manual</a>
    <a href="#facts1">Maths</a>
    <a href="#facts2">Numbers</a>
    <a href="#facts3">Treasure</a>
    <a href="#facts4">Huge!</a>
    <a href="#checklist">Checklist</a>
  </div>

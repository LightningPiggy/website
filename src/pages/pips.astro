<script is:inline>
// ---------- universe stars ----------
const uni = document.getElementById('universe');
for(let i=0;i<140;i++){
  const s=document.createElement('div'); s.className='star';
  const sz=(Math.random()*2.4+0.8);
  s.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;width:${sz}px;height:${sz}px;opacity:${Math.random()*.7+.25}`;
  uni.appendChild(s);
}

// ---------- staircase animate on scroll ----------
const stairs=document.getElementById('stairs');
const io=new IntersectionObserver(es=>{
  es.forEach(e=>{ if(e.isIntersecting){
    stairs.querySelectorAll('.bar').forEach(b=>b.style.height=b.dataset.h+'px');
    io.disconnect();
  }});
},{threshold:.4});
io.observe(stairs);

// ---------- binary scissors ----------
const SATS=5000000000n;
const binrow=document.getElementById('binrow');
const snipstate=document.getElementById('snipstate');
let bits=SATS.toString(2).split('');
let snips=0;
function renderBits(){
  binrow.innerHTML='';
  bits.forEach(b=>{
    const d=document.createElement('div'); d.className='bit'; d.textContent=b; binrow.appendChild(d);
  });
  const val=bits.length?BigInt('0b'+bits.join('')):0n;
  const btc=Number(val)/1e8;
  snipstate.textContent = bits.length
    ? `era ${snips+1}: reward = ${val.toLocaleString('en')} sats (${btc.toLocaleString('en',{maximumFractionDigits:8})} BTC)`
    : `after 33 snips: 0 sats: the treasure hunt is over (~year 2140)`;
}
document.getElementById('snip').addEventListener('click',()=>{
  if(!bits.length) return;
  const last=binrow.lastElementChild;
  last.classList.add('gone');
  setTimeout(()=>{ bits.pop(); snips++; renderBits(); },380);
});
renderBits();
</script>

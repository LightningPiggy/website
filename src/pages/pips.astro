<script is:inline define:vars={{ WORDS: BIP39_WORDS }}>
// ---------- bowl draw ----------
const bowl = document.getElementById('bowl');
const pipFly = document.getElementById('pipFly');
const pipInner = document.getElementById('pipInner');
const frontStr = document.getElementById('frontStr');
const backStr = document.getElementById('backStr');
const frontTag = document.getElementById('frontTag');
const backTag = document.getElementById('backTag');
const flipHint = document.getElementById('flipHint');
const bitsLine = document.getElementById('bitsLine');
const wordLine = document.getElementById('wordLine');
const backLine = document.getElementById('backLine');
const tapLabel = document.getElementById('tapLabel');
let drawing = false, drawn = false, backWord = '', backIdx = 0;

function draw(){
  if(drawing) return; drawing = true;
  const buf = new Uint16Array(1);
  crypto.getRandomValues(buf);
  const idx = buf[0] % 2048;               // 11 bits
  const tablet = (idx >> 1) + 1;           // 10 bits
  const face = idx & 1;                    // 1 bit — the face gravity chose
  const other = idx ^ 1;                   // same tablet, other face
  const word = WORDS[idx];
  backWord = WORDS[other]; backIdx = other;

  frontStr.textContent = word.slice(0,4).toUpperCase();
  backStr.textContent  = backWord.slice(0,4).toUpperCase();
  frontTag.textContent = 'FACE ' + (face ? 'B' : 'A') + ' · UP';
  backTag.textContent  = 'FACE ' + (face ? 'A' : 'B') + ' · DOWN';

  pipFly.classList.remove('flipped');
  flipHint.classList.remove('show');
  backLine.innerHTML = '';
  pipFly.classList.remove('pop'); void pipFly.offsetWidth; pipFly.classList.add('pop');

  bitsLine.textContent = `tablet ${tablet} of 1,024 (10 bits) · face ${face ? 'B':'A'} up (1 bit) = 11 bits`;
  wordLine.textContent = `→ word ${idx+1} of 2,048: “${word}”`;
  tapLabel.textContent = 'tap again for another!';

  setTimeout(()=>{ drawing=false; drawn=true; flipHint.classList.add('show'); }, 950);
}
function flip(){
  if(!drawn) return;
  pipFly.classList.toggle('flipped');
  if(pipFly.classList.contains('flipped')){
    backLine.innerHTML = `underneath: word ${backIdx+1}, “${backWord}” — <strong>but gravity picked the top one.</strong> Peeking is fine; choosing is cheating!`;
  }
}
bowl.addEventListener('click', draw);
bowl.addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){e.preventDefault();draw();} });
pipFly.addEventListener('click', flip);

// ---------- universe stars ----------
const uni = document.getElementById('universe');
for(let i=0;i<140;i++){
  const s=document.createElement('div'); s.className='star';
  const sz=(Math.random()*2.4+0.8);
  s.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;width:${sz}px;height:${sz}px;opacity:${Math.random()*.7+.25}`;
  uni.appendChild(s);
}

// ---------- staircase animate on scroll ----------
const stairs=document.getElementById('stairs');
const io=new IntersectionObserver(es=>{
  es.forEach(e=>{ if(e.isIntersecting){
    stairs.querySelectorAll('.bar').forEach(b=>b.style.height=b.dataset.h+'px');
    io.disconnect();
  }});
},{threshold:.4});
io.observe(stairs);

// ---------- binary scissors ----------
const SATS=5000000000n;
const binrow=document.getElementById('binrow');
const snipstate=document.getElementById('snipstate');
let bits=SATS.toString(2).split('');
let snips=0;
function renderBits(){
  binrow.innerHTML='';
  bits.forEach(b=>{
    const d=document.createElement('div'); d.className='bit'; d.textContent=b; binrow.appendChild(d);
  });
  const val=bits.length?BigInt('0b'+bits.join('')):0n;
  const btc=Number(val)/1e8;
  snipstate.textContent = bits.length
    ? `era ${snips+1}: reward = ${val.toLocaleString('en')} sats (${btc.toLocaleString('en',{maximumFractionDigits:8})} BTC)`
    : `after 33 snips: 0 sats — the treasure hunt is over (~year 2140)`;
}
document.getElementById('snip').addEventListener('click',()=>{
  if(!bits.length) return;
  const last=binrow.lastElementChild;
  last.classList.add('gone');
  setTimeout(()=>{ bits.pop(); snips++; renderBits(); },380);
});
renderBits();
</script>

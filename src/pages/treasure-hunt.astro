    const BTC_DEFAULT_LUCIDE = 'store';
    const btcImgId = (icon?: string | null): string =>
      'btc-' + (CAT_TO_LUCIDE[icon || ''] || BTC_DEFAULT_LUCIDE);

    function escAttr(s: string): string {
      return String(s).replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string),
      );
    }

    // Rasterise a Lucide glyph (as a self-contained <svg> Image) so it can be
    // drawn onto a canvas and registered as a MapLibre icon.
    function loadLucideImage(inner: string): Promise<HTMLImageElement> {
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#fff" color="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
      const url = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
      return new Promise((resolve, reject) => {
        const im = new Image();
        im.onload = () => resolve(im);
        im.onerror = reject;
        im.src = url;
      });
    }

    // Register one map image per Lucide glyph: the white icon on an orange disc
    // with a white ring - the same pin chassis the app uses. Async (each glyph
    // rasterises via an Image), so `loadBtcMap` awaits it before adding layers.
    async function registerBtcGlyphs(map: any): Promise<void> {
      const dpr = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
      const size = 46;
      await Promise.all(
        Object.entries(LUCIDE_INNER).map(async ([name, inner]) => {
          const id = 'btc-' + name;
          if (map.hasImage(id)) return;
          let glyph: HTMLImageElement;
          try {
            glyph = await loadLucideImage(inner);
          } catch {
            return;
          }
          if (map.hasImage(id)) return;
          const canvas = document.createElement('canvas');
          canvas.width = canvas.height = size * dpr;
          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          ctx.scale(dpr, dpr);
          const r = size / 2;
          ctx.beginPath();
          ctx.arc(r, r, r - 4, 0, Math.PI * 2);
          ctx.fillStyle = BTC_ORANGE;
          ctx.shadowColor = 'rgba(0,0,0,0.3)';
          ctx.shadowBlur = 3;
          ctx.fill();
          ctx.shadowBlur = 0;
          ctx.lineWidth = 2;
          ctx.strokeStyle = '#ffffff';
          ctx.stroke();
          const g = size * 0.54;
          ctx.drawImage(glyph, r - g / 2, r - g / 2, g, g);
          const data = ctx.getImageData(0, 0, size * dpr, size * dpr);
          map.addImage(id, { width: size * dpr, height: size * dpr, data: data.data }, { pixelRatio: dpr });
        }),
      );
    }

    interface BtcState { map: any; fetched: boolean; loading: boolean; visible: boolean; count: number; }

    // Fetch the dataset, register glyphs, and add the clustered source + layers.
    // Runs once (guarded by state.fetched); subsequent toggles just flip layer
    // visibility.
    async function loadBtcMap(state: BtcState): Promise<void> {
      const map = state.map;
      const maplibregl = (window as any).maplibregl;
      // The style must be loaded before addSource/addImage; on a normal load
      // this is long done by the time anyone clicks, but guard just in case.
      if (!map.isStyleLoaded()) {
        await new Promise<void>((res) => map.once('load', () => res()));
      }

      const res = await fetch(BTCMAP_URL, { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(`BTC Map HTTP ${res.status}`);
      const places: Array<{ id: number; lat: number; lon: number; icon?: string; name?: string }> =
        await res.json();

      await registerBtcGlyphs(map);

      const features = [];
      for (const p of places) {
        if (typeof p.lat !== 'number' || typeof p.lon !== 'number') continue;
        features.push({
          type: 'Feature' as const,
          geometry: { type: 'Point' as const, coordinates: [p.lon, p.lat] },
          properties: {
            id: p.id,
            name: p.name || '',
            img: btcImgId(p.icon),
          },
        });
      }
      state.count = features.length;

      // Clustered source so the ~29k merchants group into counts at low zoom
      // and break apart into individual glyphs as you zoom in. Two things make
      // the clustered tiles populate reliably: the data is passed INLINE at
      // creation (adding empty + `setData` later leaves the tiles empty until a
      // pan), and we wait for the basemap to settle first.
      await new Promise<void>((res) => (map.areTilesLoaded() ? res() : map.once('idle', () => res())));
      map.addSource('btcmap', {
        type: 'geojson',
        data: { type: 'FeatureCollection', features },
        cluster: true,
        clusterRadius: 50,
        clusterMaxZoom: 12,
        attribution:
          'Merchants © <a href="https://btcmap.org" target="_blank" rel="noopener">BTC Map</a>, © OpenStreetMap contributors',
      });

      // Cluster bubble: an orange disc sized by how many merchants it groups,
      // with a white count. Matches the spend-spot pin colour.
      map.addLayer({
        id: 'btc-clusters',
        type: 'circle',
        source: 'btcmap',
        filter: ['has', 'point_count'],
        paint: {
          'circle-color': BTC_ORANGE,
          'circle-opacity': 0.95,
          'circle-radius': ['step', ['get', 'point_count'], 14, 25, 18, 100, 22, 1000, 28],
          'circle-stroke-width': 2,
          'circle-stroke-color': '#ffffff',
        },
      });
      map.addLayer({
        id: 'btc-cluster-count',
        type: 'symbol',
        source: 'btcmap',
        filter: ['has', 'point_count'],
        layout: {
          'text-field': ['get', 'point_count_abbreviated'],
          'text-font': ['Noto Sans Bold'],
          'text-size': ['step', ['get', 'point_count'], 11, 100, 12, 1000, 13],
          'text-allow-overlap': true,
        },
        paint: { 'text-color': '#ffffff' },
      });
      // Individual merchants (only present above clusterMaxZoom): the Lucide
      // category glyph on its orange disc.
      map.addLayer({
        id: 'btc-merchants',
        type: 'symbol',
        source: 'btcmap',
        filter: ['!', ['has', 'point_count']],
        layout: {
          'icon-image': ['get', 'img'],
          'icon-size': ['interpolate', ['linear'], ['zoom'], 10, 0.46, 14, 0.6, 17, 0.74],
          'icon-allow-overlap': false,
          'icon-padding': 2,
        },
      });

      // Click a cluster to zoom to where it breaks apart.
      map.on('click', 'btc-clusters', (e: any) => {
        const f = map.queryRenderedFeatures(e.point, { layers: ['btc-clusters'] })[0];
        if (!f) return;
        map
          .getSource('btcmap')
          .getClusterExpansionZoom(f.properties.cluster_id)
          .then((zoom: number) => map.easeTo({ center: f.geometry.coordinates, zoom: Math.min(zoom, 16) }))
          .catch(() => {});
      });
      map.on('mouseenter', 'btc-clusters', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'btc-clusters', () => { map.getCanvas().style.cursor = ''; });

      // Merchants open a small popup with a BTC Map deep link. Registered once,
      // here, since the layers are only added once.
      map.on('click', 'btc-merchants', (e: any) => {
        const f = e.features?.[0];
        if (!f) return;
        const name = f.properties.name || 'Bitcoin merchant';
        const id = f.properties.id;
        const html = `<div style="font-family:Inter,system-ui,sans-serif;min-width:170px;">
            <div style="font-weight:700;font-size:14px;color:#111827;margin-bottom:2px;">${escAttr(name)}</div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:8px;">Accepts Bitcoin ⚡</div>
            <a href="https://btcmap.org/merchant/${encodeURIComponent(id)}" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:${BTC_ORANGE};text-decoration:none;">View on BTC Map ↗</a>
          </div>`;
        new maplibregl.Popup({ offset: 14, maxWidth: '260px' })
          .setLngLat(f.geometry.coordinates)
          .setHTML(html)
          .addTo(map);
      });
      map.on('mouseenter', 'btc-merchants', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'btc-merchants', () => { map.getCanvas().style.cursor = ''; });
    }

    // Wire the top-left toggle: lazy-load on first enable, then flip visibility.
    function wireBtcMap(map: any): void {
      const btn = document.getElementById('btcmap-toggle');
      const sw = document.getElementById('btcmap-switch');
      const knob = document.getElementById('btcmap-knob');
      const label = document.getElementById('btcmap-toggle-label');
      const legendRow = document.getElementById('btcmap-legend-row');
      if (!btn) return;
      const state: BtcState = { map, fetched: false, loading: false, visible: false, count: 0 };

      const paint = () => {
        const on = state.visible;
        btn.setAttribute('aria-pressed', String(on));
        if (sw) sw.style.background = on ? BTC_ORANGE : '#d1d5db';
        if (knob) knob.style.transform = on ? 'translateX(16px)' : 'translateX(0)';
        if (label) {
          label.textContent = state.loading
            ? 'Loading spots…'
            : on
              ? `Spend spots · ${state.count.toLocaleString()}`
              : 'Spend your sats';
        }
        if (legendRow) {
          legendRow.classList.toggle('hidden', !on);
          legendRow.classList.toggle('flex', on);
        }
      };

      const setVisibility = (vis: 'visible' | 'none') => {
        for (const id of ['btc-clusters', 'btc-cluster-count', 'btc-merchants']) {
          if (map.getLayer(id)) map.setLayoutProperty(id, 'visibility', vis);
        }
      };

      btn.addEventListener('click', async () => {
        if (state.loading) return;
        if (state.visible) {
          state.visible = false;
          setVisibility('none');
          paint();
          return;
        }
        if (!state.fetched) {
          state.loading = true;
          paint();
          try {
            await loadBtcMap(state);
            state.fetched = true;
          } catch (e) {
            console.error('BTC Map layer failed to load:', e);
            state.loading = false;
            paint();
            return;
          }
          state.loading = false;
        }
        state.visible = true;
        setVisibility('visible');
        paint();
      });
    }

    // -----------------------------------------------------------------------
    // Init
    // -----------------------------------------------------------------------
    // Wait for the CDN-loaded MapLibre global to be ready. Astro bundles this
    // <script> as a deferred ES module, so it may run before OR after the
    // classic maplibre-gl script has executed - poll briefly rather than
    // assuming an order.
    function whenMaplibreReady(cb: (m: any) => void): void {
      const start = Date.now();
      const tick = () => {
        const m = (window as any).maplibregl;
        if (m) {
          cb(m);
        } else if (Date.now() - start < 10000) {
          setTimeout(tick, 50);
        } else {
          console.error('MapLibre GL failed to load from CDN.');
        }
      };
      tick();
    }

    async function initPigletsMap(): Promise<void> {
      const maplibregl = (window as any).maplibregl;
      const mapEl = document.getElementById('piglets-map');
      if (!maplibregl || !mapEl) return;

      const loadingEl = document.getElementById('piglets-loading');
      const emptyEl = document.getElementById('piglets-empty');
      const legendEl = document.getElementById('piglets-legend');
      const countEl = document.getElementById('piglets-count');
      const fallbackEl = document.getElementById('piglets-webgl-fallback');

      // Swap the infinite "Loading…" spinner for the friendly WebGL fallback.
      const showMapFallback = (): void => {
        loadingEl?.classList.add('hidden');
        fallbackEl?.classList.remove('hidden');
        fallbackEl?.classList.add('flex');
      };

      // MapLibre GL requires a WebGL context. Detect up front whether the
      // browser can give us one (hardware acceleration / WebGL can be disabled,
      // or the GPU may be sandboxed/blocklisted) so we never construct a Map
      // that's doomed to throw `webglcontextcreationerror` and strand the
      // spinner forever.
      const webglAvailable = (): boolean => {
        try {
          const canvas = document.createElement('canvas');
          return (
            !!window.WebGLRenderingContext &&
            !!(canvas.getContext('webgl') || canvas.getContext('experimental-webgl'))
          );
        } catch {
          return false;
        }
      };

      if (!webglAvailable()) {
        console.warn('Piglets map: WebGL is unavailable — showing fallback.');
        showMapFallback();
        return;
      }

      const style = {
        version: 8 as const,
        // Glyph endpoint for symbol-layer text - only the BTC Map cluster
        // counts use it, and only once that opt-in layer is enabled, so a
        // normal map load fetches nothing from here. MapLibre's own font
        // server (valid PBFs, open CORS, no key).
        glyphs: 'https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf',
        sources: {
          carto: {
            type: 'raster' as const,
            tiles: [
              'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
              'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
              'https://c.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
              'https://d.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
            ],
            tileSize: 256,
            attribution: '© OpenStreetMap contributors © CARTO',
          },
        },
        layers: [{ id: 'carto', type: 'raster' as const, source: 'carto' }],
      };

      // Belt-and-suspenders: even after the feature check above, the GL context
      // can still fail to create (driver quirks, blocklisted GPU). MapLibre
      // throws synchronously from its constructor in that case, so guard it and
      // fall back gracefully instead of bubbling up into an endless spinner.
      let map: any;
      try {
        map = new maplibregl.Map({
          container: mapEl,
          style,
          center: [0, 20],
          zoom: 1.5,
          attributionControl: true,
          // Don't hijack page scroll: require Ctrl+wheel (desktop) or two fingers
          // (mobile touch-pan) to interact with the map, so the page scrolls freely.
          cooperativeGestures: true,
        });
      } catch (e) {
        console.error('Piglets map: failed to create WebGL map context:', e);
        showMapFallback();
        return;
      }

      // Async GL failures surface as a map 'error' event rather than a throw.
      map.on('error', (ev: any) => {
        const err = ev?.error ?? ev;
        const isWebgl =
          err?.type === 'webglcontextcreationerror' ||
          /webgl/i.test(String(err?.message ?? ''));
        if (isWebgl) {
          console.error('Piglets map: WebGL context creation error:', err);
          showMapFallback();
        }
      });
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

      // Standard "locate me" control (top-right). The map defaults to the
      // world/all-Piglets view; centring on the visitor is opt-in via this
      // button only - we never auto-prompt for location on load, and we never
      // fall back to any third-party IP-geolocation service (browser
      // geolocation is the only source, so the user's location stays private).
      const geolocate = new maplibregl.GeolocateControl({
        positionOptions: { enableHighAccuracy: false, timeout: 10000 },
        fitBoundsOptions: { maxZoom: 9 }, // gentle regional zoom, not street level
        trackUserLocation: false,
        showUserLocation: true,
        showAccuracyCircle: true,
      });
      map.addControl(geolocate, 'top-right');

      // Wire the opt-in "spend your sats" BTC Map overlay (off by default).
      wireBtcMap(map);

      let caches: ParsedCache[] = [];
      try {
        caches = await fetchCaches();
      } catch (e) {
        console.error('Failed to load Piglets:', e);
      }

      loadingEl?.classList.add('hidden');
      legendEl?.classList.remove('hidden');

      if (caches.length === 0) {
        emptyEl?.classList.remove('hidden');
        if (countEl) countEl.textContent = '';
        return;
      }

      if (countEl) {
        const piglets = caches.filter((c) => c.isLpPiggy).length;
        countEl.textContent = `${caches.length} cache${caches.length === 1 ? '' : 's'} · ${piglets} Piglet${
          piglets === 1 ? '' : 's'
        }`;
      }

      const bounds = new maplibregl.LngLatBounds();

      // A single popup, built lazily on marker click rather than eagerly for
      // every cache up front. Each click renders a fresh popup element, so the
      // card's interactive listeners are attached exactly once (no stacking on
      // reopen), and only one popup is open at a time. The find log lives on the
      // full /treasure/<naddr> page the "View treasure" button links to.
      let openPopup: any = null;
      const showCachePopup = (cache: ParsedCache) => {
        if (openPopup) openPopup.remove();
        const popup = new maplibregl.Popup({ offset: 18, maxWidth: '360px', closeButton: true })
          .setLngLat([cache.lng, cache.lat])
          .setHTML(buildPopupHtml(cache))
          .addTo(map);
        const root = popup.getElement();
        if (root) wireCacheCard(root, cache);

        popup.on('close', () => {
          if (openPopup === popup) openPopup = null;
        });
        openPopup = popup;
      };

      const addMarkers = () => {
        // Add vanilla NIP-GC caches first, Piglets last, so our Piglets render
        // on top when they share (or nearly share) a location. The per-marker
        // z-index backs this up for exact overlaps.
        const ordered = [...caches].sort(
          (a, b) => Number(a.isLpPiggy) - Number(b.isLpPiggy),
        );
        for (const cache of ordered) {
          const el = makeMarkerElement(cache);
          el.addEventListener('click', (e) => {
            e.stopPropagation();
            showCachePopup(cache);
          });
          new maplibregl.Marker({ element: el })
            .setLngLat([cache.lng, cache.lat])
            .addTo(map);
          bounds.extend([cache.lng, cache.lat]);
        }

        if (!bounds.isEmpty()) {
          map.fitBounds(bounds, { padding: 60, maxZoom: 12, duration: 0 });
        }
      };

      // HTML markers are DOM overlays positioned from the map transform, which
      // exists as soon as the Map is constructed - they don't need the style /
      // tiles to have finished loading. Add them right away so a slow or failing
      // basemap can never strand the pins.
      addMarkers();

      // No auto-locate: the map opens on the world / all-Piglets view. Centring
      // on the visitor is opt-in via the top-right locate control - browser
      // geolocation only, with no IP-based third-party fallback, so a visitor's
      // location is never requested or leaked unless they ask for it.
    }

    // Helper overlay: dismiss to a compact "How it works" pill, and restore.
    function wireHelpOverlay(): void {
      const help = document.getElementById('piglets-help');
      const closeBtn = document.getElementById('piglets-help-close');
      const openBtn = document.getElementById('piglets-help-open');
      closeBtn?.addEventListener('click', () => {
        help?.classList.add('hidden');
        openBtn?.classList.remove('hidden');
        openBtn?.classList.add('inline-flex');
      });
      openBtn?.addEventListener('click', () => {
        openBtn.classList.add('hidden');
        openBtn.classList.remove('inline-flex');
        help?.classList.remove('hidden');
      });

      // "More" toggle: reveal/hide the secondary detail to keep the card compact.
      const moreText = document.getElementById('piglets-help-more');
      const moreToggle = document.getElementById('piglets-help-more-toggle');
      moreToggle?.addEventListener('click', () => {
        const hidden = moreText?.classList.toggle('hidden');
        moreToggle.textContent = hidden ? 'More' : 'Less';
      });
    }

    // Run as soon as both the DOM and the MapLibre global are ready. Don't
    // rely on DOMContentLoaded alone - this bundled module is deferred and
    // the event may have already fired by the time it executes.
    function start(): void {
      wireHelpOverlay();
      whenMaplibreReady(() => {
        initPigletsMap().catch((e) => console.error('Piglets map init failed:', e));
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  </script>
</BaseLayout>

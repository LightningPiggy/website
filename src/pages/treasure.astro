---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Treasure"
  description="View a Lightning Piggy Piglet or NIP-GC geocache and its find log, pulled straight from Nostr relays."
>
  <!--
    This page is served for any /treasure/<naddr> URL via a Netlify SPA rewrite
    (netlify.toml). The naddr in the path identifies one NIP-GC cache; the page
    resolves it from Nostr client-side, so there is no per-cache build output.
  -->
  <div class="mx-auto w-full max-w-[600px] px-4 py-6 sm:py-8">
    <a
      id="treasure-back"
      href="/treasure-hunt"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-pink transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 12H5M12 19l-7-7 7-7" /></svg>
      Back to map
    </a>

    <!-- Loading state -->
    <div id="treasure-loading" class="flex flex-col items-center justify-center py-24 text-center">
      <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-pink border-t-transparent"></div>
      <p class="text-gray-600 mt-3 font-medium">Loading treasure from Nostr…</p>
    </div>

    <!-- Error / not-found state -->
    <div id="treasure-error" class="hidden py-16 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-pink/10">
        <svg class="w-6 h-6 text-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg>
      </div>
      <p id="treasure-error-msg" class="mt-3 text-gray-600">We couldn't find that treasure.</p>
      <a href="/treasure-hunt" class="mt-4 inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-pink rounded-full hover:bg-gray-900 transition-colors">
        Back to the map
      </a>
    </div>

    <!-- Resolved treasure card -->
    <div
      id="treasure-content"
      class="hidden mt-4 rounded-2xl bg-white shadow-lg border border-gray-200 p-5 sm:p-6"
    ></div>
  </div>

  <script>
    import {
      naddrDecode,
      fetchCache,
      buildDetailHtml,
      wireCacheCard,
      loadFindLog,
    } from '../scripts/treasure-nostr';

    // The naddr can arrive two ways: in the path (/treasure/<naddr>, the
    // production SPA-rewrite form the map links to) or as a ?naddr= / ?id=
    // query param (handy in `astro dev`, which won't route arbitrary path
    // segments). Pull the first naddr1… token we can find from either.
    function readNaddr(): string | null {
      const params = new URLSearchParams(window.location.search);
      const fromQuery = params.get('naddr') || params.get('id');
      const haystack = fromQuery || decodeURIComponent(window.location.pathname);
      const match = haystack.match(/naddr1[0-9a-z]+/i);
      return match ? match[0] : null;
    }

    // A back link that returns to the map. When we arrived from the map
    // (?fromMap=true) history.back() preserves its zoom/position; otherwise the
    // static /treasure-hunt href in the markup is used.
    function wireBackLink(): void {
      const back = document.getElementById('treasure-back');
      const cameFromMap = new URLSearchParams(window.location.search).get('fromMap') === 'true';
      if (back && cameFromMap && window.history.length > 1) {
        back.addEventListener('click', (e) => {
          e.preventDefault();
          window.history.back();
        });
      }
    }

    function showError(msg: string): void {
      const loading = document.getElementById('treasure-loading');
      const error = document.getElementById('treasure-error');
      const errorMsg = document.getElementById('treasure-error-msg');
      loading?.classList.add('hidden');
      error?.classList.remove('hidden');
      if (errorMsg) errorMsg.textContent = msg;
    }

    async function init(): Promise<void> {
      wireBackLink();

      const naddr = readNaddr();
      if (!naddr) {
        showError('This link is missing a treasure address.');
        return;
      }

      const decoded = naddrDecode(naddr);
      if (!decoded) {
        showError("That treasure link doesn't look valid.");
        return;
      }

      let cache;
      try {
        cache = await fetchCache(decoded.kind, decoded.pubkey, decoded.identifier);
      } catch (e) {
        console.error('Failed to load treasure:', e);
        showError('Something went wrong loading this treasure. Please try again.');
        return;
      }

      if (!cache) {
        showError(
          "We couldn't find that treasure on the relays. It may have been removed or expired.",
        );
        return;
      }

      const loading = document.getElementById('treasure-loading');
      const content = document.getElementById('treasure-content');
      if (!content) return;

      // Size the hero to the rendered card's inner width so the static map
      // mosaic centres its pin correctly (the card is padded, hence the inset).
      const cardWidth = content.getBoundingClientRect().width || 600;
      const heroW = Math.max(240, Math.round(cardWidth));
      const heroH = Math.round(Math.min(320, Math.max(200, heroW * 0.5)));

      content.innerHTML = buildDetailHtml(cache, heroW, heroH);
      loading?.classList.add('hidden');
      content.classList.remove('hidden');

      // Update the page title now that we know the cache name.
      document.title = `${cache.name} | Treasure | LightningPiggy`;

      wireCacheCard(content, cache);

      const logBody = content.querySelector('.pg-findlog-body') as HTMLElement | null;
      if (logBody) {
        loadFindLog(cache.coord, logBody).catch(() => {
          if (logBody.isConnected) logBody.textContent = 'Could not load finds.';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Treasure"
  description="View a Lightning Piggy Piglet or NIP-GC geocache and its find log, pulled straight from Nostr relays."
>
  <!--
    This page is served for any /treasure/<naddr> URL via a Netlify SPA rewrite
    (netlify.toml) in production, and a matching dev-server rewrite in
    astro.config.mjs. The naddr in the path identifies one NIP-GC cache; the
    page resolves it from Nostr client-side, so there is no per-cache build
    output.
  -->
  <style is:global>
    /* Two-column on desktop (map + card + find log on the left, details/share
       sidebar on the right), single column on mobile. */
    .pg-detail-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
    }
    @media (min-width: 820px) {
      .pg-detail-grid {
        grid-template-columns: minmax(0, 1fr) 300px;
        align-items: start;
        column-gap: 24px;
      }
    }
    /* Left column stacks the main card and the find-log card. */
    .pg-detail-left {
      display: flex;
      flex-direction: column;
      gap: 18px;
      min-width: 0;
    }
    .pg-detail-main,
    .pg-detail-findlog,
    .pg-side-card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
    }
    .pg-detail-main,
    .pg-detail-findlog {
      padding: 18px;
    }
    @media (min-width: 640px) {
      .pg-detail-main,
      .pg-detail-findlog {
        padding: 22px;
      }
    }
    .pg-side-card {
      padding: 16px;
    }

    /* Share-to-Nostr modal dialog */
    .pg-share-dialog {
      width: 92vw;
      max-width: 480px;
      border: none;
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    }
    .pg-share-dialog::backdrop {
      background: rgba(17, 24, 39, 0.55);
    }
  </style>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <a
      id="treasure-back"
      href="/treasure-hunt"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-pink transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 12H5M12 19l-7-7 7-7" /></svg>
      Back to map
    </a>

    <!-- Loading state -->
    <div id="treasure-loading" class="flex flex-col items-center justify-center py-24 text-center">
      <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-pink border-t-transparent"></div>
      <p class="text-gray-600 mt-3 font-medium">Loading treasure from Nostr…</p>
    </div>

    <!-- Error / not-found state -->
    <div id="treasure-error" class="hidden py-16 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-pink/10">
        <svg class="w-6 h-6 text-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg>
      </div>
      <p id="treasure-error-msg" class="mt-3 text-gray-600">We couldn't find that treasure.</p>
      <a href="/treasure-hunt" class="mt-4 inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-pink rounded-full hover:bg-gray-900 transition-colors">
        Back to the map
      </a>
    </div>

    <!-- Resolved treasure -->
    <div id="treasure-content" class="hidden mt-4"></div>
  </div>

  <!-- Modals, populated + opened from the detail page's buttons. -->
  <dialog id="pg-share-dialog" class="pg-share-dialog"></dialog>
  <dialog id="pg-log-dialog" class="pg-share-dialog"></dialog>
  <dialog id="pg-zap-dialog" class="pg-share-dialog"></dialog>

  <script>
    import {
      naddrDecode,
      fetchCache,
      buildDetailHtml,
      wireCacheCard,
      loadFindLog,
      buildShareNote,
      shareToNostr,
      shareDialogHtml,
      findLogDialogHtml,
      postFindLog,
      zapDialogHtml,
      zapHider,
      hiderLnAddress,
      cacheNaddr,
      sanitizeUrl,
      BRAND_PINK,
      type ParsedCache,
    } from '../scripts/treasure-nostr';

    const SITE = 'https://lightningpiggy.com';

    // Collapse whitespace and hard-cap to `max` chars (guarding max <= 0), for
    // social-preview descriptions.
    function truncate(text: string, max: number): string {
      if (max <= 0) return '';
      const t = (text || '').replace(/\s+/g, ' ').trim();
      return t.length <= max ? t : `${t.slice(0, max - 1).trimEnd()}…`;
    }

    // Set or create a <meta> tag by its property/name selector.
    function setMeta(selector: string, content: string): void {
      let el = document.head.querySelector(selector) as HTMLMetaElement | null;
      if (!el) {
        const m = selector.match(/\[(property|name)="([^"]+)"\]/);
        if (!m) return;
        el = document.createElement('meta');
        el.setAttribute(m[1], m[2]);
        document.head.appendChild(el);
      }
      el.setAttribute('content', content);
    }

    // Give the resolved treasure its own title + Open Graph / Twitter preview so
    // a shared lightningpiggy.com/treasure/<naddr> link renders the cache name,
    // description and photo. (This runs client-side; crawlers that don't execute
    // JS will still see the page's default tags - a Netlify prerender/edge
    // function would be needed to cover those.)
    function setSocialMeta(cache: ParsedCache): void {
      const url = `${SITE}/treasure/${cacheNaddr(cache)}`;
      const title = `${cache.name} — Lightning Piggy Treasure Hunt`;
      const prize =
        cache.isLpPiggy && cache.payoutSats != null
          ? ` · ⚡ ${cache.payoutSats.toLocaleString()} sats prize`
          : '';
      const desc = truncate(
        (cache.description || 'A hidden Lightning Piggy treasure on the Nostr geocaching map.') +
          prize,
        200,
      );
      const image = cache.imageUrl ? sanitizeUrl(cache.imageUrl) : '';

      document.title = `${cache.name} | Treasure | LightningPiggy`;
      setMeta('meta[property="og:title"]', title);
      setMeta('meta[name="twitter:title"]', title);
      setMeta('meta[property="og:description"]', desc);
      setMeta('meta[name="twitter:description"]', desc);
      setMeta('meta[name="description"]', desc);
      setMeta('meta[property="og:url"]', url);
      if (image) {
        setMeta('meta[property="og:image"]', image);
        setMeta('meta[name="twitter:image"]', image);
      }
      const canonical = document.head.querySelector('link[rel="canonical"]');
      if (canonical) canonical.setAttribute('href', url);
    }

    const CHECK_SVG =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

    // The naddr can arrive two ways: in the path (/treasure/<naddr>, the
    // production/dev rewrite form the map links to) or as a ?naddr= / ?id=
    // query param. Pull the first naddr1… token we can find from either.
    function readNaddr(): string | null {
      const params = new URLSearchParams(window.location.search);
      const fromQuery = params.get('naddr') || params.get('id');
      const haystack = fromQuery || decodeURIComponent(window.location.pathname);
      const match = haystack.match(/naddr1[0-9a-z]+/i);
      return match ? match[0] : null;
    }

    // Back link returns to the map. When we arrived from the map (?fromMap=true)
    // history.back() preserves its zoom/position; otherwise the static href is used.
    function wireBackLink(): void {
      const back = document.getElementById('treasure-back');
      const cameFromMap = new URLSearchParams(window.location.search).get('fromMap') === 'true';
      if (back && cameFromMap && window.history.length > 1) {
        back.addEventListener('click', (e) => {
          e.preventDefault();
          window.history.back();
        });
      }
    }

    function showError(msg: string): void {
      document.getElementById('treasure-loading')?.classList.add('hidden');
      const error = document.getElementById('treasure-error');
      error?.classList.remove('hidden');
      const errorMsg = document.getElementById('treasure-error-msg');
      if (errorMsg) errorMsg.textContent = msg;
    }

    async function copyText(text: string): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    }

    // Wire a "copy to clipboard" button that briefly confirms. `onDone` renders
    // the confirmation (icon swap or label change), returning a revert fn.
    function wireCopy(btn: HTMLButtonElement, value: () => string, confirm: () => () => void): void {
      btn.addEventListener('click', async () => {
        if (!(await copyText(value()))) return;
        const revert = confirm();
        window.setTimeout(() => {
          if (btn.isConnected) revert();
        }, 1300);
      });
    }

    // Wire the copy buttons (coordinates / geohash / copy-link) and the Share
    // controls: native share where available, and the "Share to Nostr" modal.
    function wireShare(root: HTMLElement, cache: ParsedCache): void {
      const note = buildShareNote(cache);

      // Generic icon copy buttons (coordinates, geohash).
      root.querySelectorAll<HTMLButtonElement>('.pg-copy').forEach((btn) => {
        wireCopy(
          btn,
          () => btn.dataset.copy || '',
          () => {
            const original = btn.innerHTML;
            btn.innerHTML = CHECK_SVG;
            return () => {
              btn.innerHTML = original;
            };
          },
        );
      });

      // Sidebar "Copy link" button (swaps its label to confirm).
      const copyBtn = root.querySelector('.pg-share-copy') as HTMLButtonElement | null;
      const copyLabel = root.querySelector('.pg-share-copy-label') as HTMLElement | null;
      if (copyBtn) {
        wireCopy(
          copyBtn,
          () => copyBtn.dataset.copy || note.lpUrl,
          () => {
            if (copyLabel) copyLabel.textContent = 'Copied!';
            return () => {
              if (copyLabel) copyLabel.textContent = 'Copy link';
            };
          },
        );
      }

      // Native share sheet - only shown where the browser supports it (mobile).
      const nativeBtn = root.querySelector('.pg-share-native') as HTMLButtonElement | null;
      if (nativeBtn && typeof navigator.share === 'function') {
        nativeBtn.hidden = false;
        nativeBtn.style.display = 'flex';
        nativeBtn.addEventListener('click', () => {
          navigator
            .share({ title: cache.name, text: note.content, url: note.lpUrl })
            .catch(() => {});
        });
      }

      // Share to Nostr: a modal dialog, populated once and opened from the
      // sidebar button. Publishes a kind-1 note via a NIP-07 signer.
      const dialog = document.getElementById('pg-share-dialog') as HTMLDialogElement | null;
      const nostrBtn = root.querySelector('.pg-share-nostr') as HTMLButtonElement | null;
      if (!dialog || !nostrBtn) return;

      dialog.innerHTML = shareDialogHtml();
      const textArea = dialog.querySelector('.pg-share-text') as HTMLTextAreaElement | null;
      const status = dialog.querySelector('.pg-share-status') as HTMLElement | null;
      const postBtn = dialog.querySelector('.pg-share-post') as HTMLButtonElement | null;
      const closeBtn = dialog.querySelector('.pg-share-close') as HTMLButtonElement | null;
      const modalCopy = dialog.querySelector('.pg-share-modal-copy') as HTMLButtonElement | null;
      const modalCopyLabel = dialog.querySelector('.pg-share-modal-copy-label') as HTMLElement | null;

      nostrBtn.addEventListener('click', () => {
        if (textArea) textArea.value = note.content;
        if (status) status.textContent = '';
        dialog.showModal();
        textArea?.focus();
      });
      closeBtn?.addEventListener('click', () => dialog.close());
      // Click outside the card (on the backdrop) closes it.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      if (modalCopy) {
        wireCopy(
          modalCopy,
          () => note.lpUrl,
          () => {
            if (modalCopyLabel) modalCopyLabel.textContent = 'Copied!';
            return () => {
              if (modalCopyLabel) modalCopyLabel.textContent = 'Copy link';
            };
          },
        );
      }

      postBtn?.addEventListener('click', async () => {
        if (!postBtn || !status) return;
        postBtn.disabled = true;
        status.style.color = '#6b7280';
        status.textContent = 'Signing with your Nostr extension…';
        try {
          const relays = await shareToNostr(cache, textArea?.value);
          status.style.color = '#16a34a';
          status.textContent = `Shared! Posted to ${relays} relay${
            relays === 1 ? '' : 's'
          } - it'll appear on Primal, Damus, etc.`;
        } catch (e) {
          const code = e instanceof Error ? e.message : '';
          status.style.color = '#b91c1c';
          if (code === 'NO_SIGNER') {
            status.textContent =
              'No Nostr signer found. Install a NIP-07 extension (Alby or nos2x) to post, or use “Copy link”.';
          } else if (code === 'PUBLISH_FAILED') {
            status.textContent = 'Signed, but no relay accepted the note. Please try again.';
          } else {
            status.textContent = 'Could not share to Nostr. Please try again.';
          }
        } finally {
          postBtn.disabled = false;
        }
      });
    }

    // Close a <dialog> on its close button and on a backdrop click.
    function wireDismiss(dialog: HTMLDialogElement, closeSelector: string): void {
      dialog.querySelector<HTMLButtonElement>(closeSelector)?.addEventListener('click', () =>
        dialog.close(),
      );
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }

    function statusError(code: string, map: Record<string, string>, fallback: string): string {
      return map[code] || fallback;
    }

    // "Log a find": a modal composer that posts a NIP-22 comment to the find
    // log (prompting to connect a signer if needed), then refreshes the log.
    function wireFindLogPost(root: HTMLElement, cache: ParsedCache): void {
      const addBtn = root.querySelector('.pg-findlog-add') as HTMLButtonElement | null;
      const dialog = document.getElementById('pg-log-dialog') as HTMLDialogElement | null;
      if (!addBtn || !dialog) return;

      dialog.innerHTML = findLogDialogHtml();
      const textArea = dialog.querySelector('.pg-log-text') as HTMLTextAreaElement | null;
      const status = dialog.querySelector('.pg-log-status') as HTMLElement | null;
      const postBtn = dialog.querySelector('.pg-log-post') as HTMLButtonElement | null;
      wireDismiss(dialog, '.pg-log-close');

      addBtn.addEventListener('click', () => {
        if (textArea) textArea.value = '';
        if (status) status.textContent = '';
        dialog.showModal();
        textArea?.focus();
      });

      postBtn?.addEventListener('click', async () => {
        if (!postBtn || !status) return;
        postBtn.disabled = true;
        status.style.color = '#6b7280';
        status.textContent = 'Signing with your Nostr extension…';
        try {
          await postFindLog(cache, textArea?.value || '');
          status.style.color = '#16a34a';
          status.textContent = 'Posted! Refreshing the find log…';
          window.setTimeout(() => {
            const body = root.querySelector('.pg-findlog-body') as HTMLElement | null;
            if (body) loadFindLog(cache.coord, body).catch(() => {});
            dialog.close();
          }, 1600);
        } catch (e) {
          const code = e instanceof Error ? e.message : '';
          status.style.color = '#b91c1c';
          status.textContent = statusError(
            code,
            {
              NO_SIGNER:
                'Connect a Nostr extension (Alby or nos2x) to post a find, then try again.',
              EMPTY: 'Please write a note first.',
              PUBLISH_FAILED: 'Signed, but no relay accepted it. Please try again.',
            },
            'Could not post your find. Please try again.',
          );
        } finally {
          postBtn.disabled = false;
        }
      });
    }

    // "Zap the hider": revealed only for Piglets whose hider has a Lightning
    // address. Opens a modal with amount presets and pays via WebLN, falling
    // back to a bolt11 invoice for any wallet.
    async function wireZap(root: HTMLElement, cache: ParsedCache): Promise<void> {
      if (!cache.isLpPiggy) return;
      const section = root.querySelector('.pg-support-section') as HTMLElement | null;
      const zapBtn = root.querySelector('.pg-zap-btn') as HTMLButtonElement | null;
      const dialog = document.getElementById('pg-zap-dialog') as HTMLDialogElement | null;
      if (!section || !zapBtn || !dialog) return;

      // Only surface the zap section once we confirm the hider can receive sats.
      const addr = await hiderLnAddress(cache.hiderPubkey).catch(() => null);
      if (!addr) return;
      section.hidden = false;

      dialog.innerHTML = zapDialogHtml(cache);
      const amounts = [...dialog.querySelectorAll<HTMLButtonElement>('.pg-zap-amount')];
      const custom = dialog.querySelector('.pg-zap-custom') as HTMLInputElement | null;
      const sendBtn = dialog.querySelector('.pg-zap-send') as HTMLButtonElement | null;
      const sendLabel = dialog.querySelector('.pg-zap-send-label') as HTMLElement | null;
      const status = dialog.querySelector('.pg-zap-status') as HTMLElement | null;
      const invoiceBox = dialog.querySelector('.pg-zap-invoice') as HTMLElement | null;
      const invoiceText = dialog.querySelector('.pg-zap-invoice-text') as HTMLTextAreaElement | null;
      const invoiceOpen = dialog.querySelector('.pg-zap-invoice-open') as HTMLAnchorElement | null;
      const invoiceCopy = dialog.querySelector('.pg-zap-invoice-copy') as HTMLButtonElement | null;
      const invoiceCopyLabel = dialog.querySelector('.pg-zap-invoice-copy-label') as HTMLElement | null;
      wireDismiss(dialog, '.pg-zap-close');

      let amount = 21;
      const highlight = (activeSats: number | null) => {
        amounts.forEach((b) => {
          const on = activeSats != null && Number(b.dataset.sats) === activeSats;
          b.style.borderColor = on ? BRAND_PINK : '#e5e7eb';
          b.style.background = on ? '#fce7f3' : '#fff';
        });
      };
      const setAmount = (sats: number, fromPreset: boolean) => {
        amount = sats;
        if (sendLabel) sendLabel.textContent = `Zap ${sats.toLocaleString()} sats`;
        highlight(fromPreset ? sats : null);
      };
      amounts.forEach((b) =>
        b.addEventListener('click', () => {
          if (custom) custom.value = '';
          setAmount(Number(b.dataset.sats), true);
        }),
      );
      custom?.addEventListener('input', () => {
        const v = parseInt(custom.value, 10);
        if (v > 0) setAmount(v, false);
      });
      setAmount(21, true);

      zapBtn.addEventListener('click', () => {
        if (status) status.textContent = '';
        if (invoiceBox) invoiceBox.hidden = true;
        dialog.showModal();
      });

      sendBtn?.addEventListener('click', async () => {
        if (!sendBtn || !status) return;
        sendBtn.disabled = true;
        status.style.color = '#6b7280';
        status.textContent = 'Requesting a Lightning invoice…';
        if (invoiceBox) invoiceBox.hidden = true;
        try {
          const res = await zapHider(cache, amount);
          if (res.paid) {
            status.style.color = '#16a34a';
            status.textContent = `Zapped ${amount.toLocaleString()} sats — thanks for supporting the hunt!`;
          } else {
            status.style.color = '#6b7280';
            status.textContent = 'Invoice ready — pay it with any Lightning wallet:';
            if (invoiceText) invoiceText.value = res.invoice;
            if (invoiceOpen) invoiceOpen.href = `lightning:${res.invoice}`;
            if (invoiceBox) invoiceBox.hidden = false;
          }
        } catch (e) {
          const code = e instanceof Error ? e.message : '';
          status.style.color = '#b91c1c';
          status.textContent = statusError(
            code,
            {
              NO_ADDRESS: 'This hider has no Lightning address set on their profile.',
              AMOUNT_RANGE: "That amount is outside the hider's allowed range. Try another.",
              LNURL_FAILED: "Couldn't reach the hider's Lightning address. Please try again.",
              NO_INVOICE: "The Lightning service didn't return an invoice. Please try again.",
            },
            'Could not create the zap. Please try again.',
          );
        } finally {
          sendBtn.disabled = false;
        }
      });

      invoiceCopy?.addEventListener('click', async () => {
        if (!invoiceText || !(await copyText(invoiceText.value))) return;
        if (invoiceCopyLabel) {
          invoiceCopyLabel.textContent = 'Copied!';
          window.setTimeout(() => {
            if (invoiceCopyLabel.isConnected) invoiceCopyLabel.textContent = 'Copy invoice';
          }, 1300);
        }
      });
    }

    async function init(): Promise<void> {
      wireBackLink();

      const naddr = readNaddr();
      if (!naddr) {
        showError('This link is missing a treasure address.');
        return;
      }

      const decoded = naddrDecode(naddr);
      if (!decoded) {
        showError("That treasure link doesn't look valid.");
        return;
      }

      let cache;
      try {
        cache = await fetchCache(decoded.kind, decoded.pubkey, decoded.identifier);
      } catch (e) {
        console.error('Failed to load treasure:', e);
        showError('Something went wrong loading this treasure. Please try again.');
        return;
      }

      if (!cache) {
        showError(
          "We couldn't find that treasure on the relays. It may have been removed or expired.",
        );
        return;
      }

      const content = document.getElementById('treasure-content');
      if (!content) return;

      content.innerHTML = buildDetailHtml(cache);
      document.getElementById('treasure-loading')?.classList.add('hidden');
      content.classList.remove('hidden');
      setSocialMeta(cache);

      // wireCacheCard fills the hero map (now that it has a size), and wires the
      // hint + photo/map toggle + hider. Then the find log and share controls.
      wireCacheCard(content, cache);
      wireShare(content, cache);
      wireFindLogPost(content, cache);
      wireZap(content, cache).catch(() => {});

      const logBody = content.querySelector('.pg-findlog-body') as HTMLElement | null;
      if (logBody) {
        loadFindLog(cache.coord, logBody).catch(() => {
          if (logBody.isConnected) logBody.textContent = 'Could not load finds.';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BaseLayout>
